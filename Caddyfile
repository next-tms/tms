{
	servers {
		protocols h1 h2c
		trusted_proxies static private_ranges
		trusted_proxies_strict
	}
	auto_https off
	admin off
	order coraza_waf first
	order rate_limit before basic_auth
}

:{$PORT} {
	encode {
		zstd better
		br
		gzip 6
		minimum_length 1025
	}
	header -Server
	header -Via

	rate_limit {
		zone api {
			events 600
			key {client_ip}
			match {
				path /api/dsdc/* /graphiql /graphql
			}
			window 1m
		}
	}

	@scanner_probes path *.action *.ashx *.asmx *.asp *.aspx *.axd *.cfc *.cfm *.cgi *.dll *.do *.jsp *.jspx *.phar *.php *.php3 *.php4 *.php5 *.php7 *.phtml *.pl *.shtml /adminer* /phpmyadmin* /wp-* /xmlrpc*
	handle @scanner_probes {
		abort
	}

	@assets path /assets/* /favicon.ico /robots.txt
	handle @assets {
		root * /app/public

		file_server {
			precompressed br zstd gzip
		}
		header Cache-Control "public, max-age=31536000, immutable"
	}

	log {
		output stdout
		format json
	}

	handle_errors {
		header -Server
		respond "" {err.status_code}
	}

	handle {
		coraza_waf {
			load_owasp_crs
			directives `
				Include @coraza.conf-recommended
				Include @crs-setup.conf.example
				SecAction "id:900200,phase:1,nolog,pass,t:none,setvar:'tx.allowed_methods=GET HEAD POST OPTIONS PUT PATCH DELETE'"
				Include @owasp_crs/*.conf
				SecAuditLog /dev/stdout
				SecAuditLogFormat JSON
				SecRuleEngine On
			`
		}

		reverse_proxy unix//{env.PUMA_SOCKET} {
			transport http {
				versions 1.1
			}
		}
	}
}
