<% unless @rates.blank? %>
  <%= turbo_stream.append "rates_#{!@rates.first.with_calculated_freight_classes?}" do %>
    <% @rates.each do |rate| %>
      <% if !rate.interstellar_error_class.blank? %>
        <% next if current_user.customer? %>
        <tr data-rate-id="<%= rate.id %>" class="table-warning">
          <td></td>
          <td>
            <div class="text-nowrap">
              <% if not rate.tracking_carrier.blank? %>
                <%= rate.tracking_carrier.name %>
                <br>
                <span class="text-muted"> via <%= rate.broker_carrier.carrier.name %></span>
              <% else %>
                <%= rate.broker_carrier.carrier.name %>
              <% end %>
              <% unless rate.broker_carrier.broker_customer.blank? %>
                <br>
                <span class="text-muted"> via <%= rate.broker_carrier.broker_customer.customer.name %> account</span>
              <% end %>
            </div>
          </td>
          <td data-sort="ZZZZ" colspan="<%= current_user.customer? ? 5 : 4 %>">
            <%= rate.pretty_interstellar_error %>
          </td>
        </tr>
        <% next %>
      <% end %>

      <% next if rate.cost_cents == 0 %>

      <% if current_user.customer? %>
        <% upcharged_rate = current_user.broker_customer.carrier_charge_calculator(carrier_cost: rate.cost, shipment: rate.shipment) %>
        <% next if upcharged_rate.nil? || upcharged_rate == Money.new(0) %>
      <% end %>
      <tr data-rate-id="<%= rate.id %>" class="<%= (!@shipment.applied_rate.blank? && rate.id == @shipment.applied_rate.id) ? 'table-info' : nil %>">
        <td class="text-nowrap">
          <div class="btn-toolbar">
            <div class="btn-group">
              <% unless @shipment.broker_customer.blank? %>
                <%= link_to 'Book', '#', data: { action: 'book#handle', controller: 'book', url: (current_user.customer? ? customer_shipment_path(@shipment) : broker_shipment_path(@shipment)), applied_rate_uid: rate.uid }, class: 'btn btn-sm btn-primary' %>
              <% else %>
                <%= link_to 'Book', book_modal_broker_shipment_path(@shipment, shipment: { applied_rate_uid: rate.uid }), data: { 'turbo-frame': 'modal' }, class: 'btn btn-sm btn-primary' %>
              <% end %>

              <% if current_user.broker? && rate.broker_carrier.api_configured? &&  rate.broker_carrier.as_interstellar_carrier.create_pickup_implemented? %>
                <% unless rate.shipment.incomplete? %>
                  <%= button_to 'Pickup', broker_pickups_path(pickup: { rate_uid: rate.uid }), class: 'btn btn-sm btn-outline-primary' %>
                <% else %>
                  <%= link_to 'Pickup', 'javascript:alert("Please enter all shipment details and try again.");', class: 'btn btn-sm btn-outline-primary' %>
                <% end %>
              <% end %>
            </div>
          </div>
        </td>
        <td>
          <div class="text-nowrap">
            <% if not rate.tracking_carrier.blank? %>
              <%= rate.tracking_carrier.name %>
              <br>
              <span class="text-muted"> via <%= rate.broker_carrier.carrier.name %></span>
            <% else %>
              <%= rate.broker_carrier.carrier.name %>
            <% end %>
            <% unless rate.broker_carrier.broker_customer.blank? %>
              <br>
              <span class="text-muted"> via <%= rate.broker_carrier.broker_customer.customer.name %> account</span>
            <% end %>
          </div>
        </td>
        <% if !current_user.customer? %>
          <td>
            <% unless rate.reference.blank? %>
              <%= rate.reference %>
              <span class="text-nowrap"><%= link_to icon('fas', 'eye', 'Show'), quote_uri(@shipment), target: '_blank' unless quote_uri(@shipment).blank? %></span>
            <% else %>
              <em>Not provided</em>
            <% end %>
          </td>
        <% end %>
        <td data-sort="<%= rate.cost %>">
          <% if current_user.customer? %>
            <%= humanized_money_with_symbol upcharged_rate, no_cents_if_whole: false %>
          <% else %>
            <%= humanized_money_with_symbol rate.cost, no_cents_if_whole: false %>
          <% end %>
        </td>
        <td><%= rate.pretty_service_type %></td>
        <td>
          <% unless rate.transit_days.blank? %>
            <%= rate.transit_days %> <%= 'day'.pluralize(rate.transit_days ? rate.transit_days.to_i : 0) %>
            <br/>
            <%= short_date rate.transit_days.to_i.business_days.after(@shipment.shipper_available_at || Date.current).in_time_zone(@shipment.receiver_address.time_zone.to_s), @shipment.receiver_address.time_zone %>
          <% else %>
            <em>Not provided</em>
          <% end %>
        </td>
        <% if !current_user.customer? && @shipment.total_charges != 0 %>
          <td><%= humanized_money_with_symbol (@shipment.total_charges - rate.cost), no_cents_if_whole: false %></td>
        <% end %>
      </tr>
    <% end %>
  <% end %>
<% end %>
