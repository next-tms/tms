<% if operator_notice&.visible_to?(current_user) %>
  <div class="flash-alert alert alert-warning mb-0 border-0 rounded-0">
    <div class="container-fluid">
      <div class="row">
        <div class="col-auto"><%= operator_notice.message %></div>

        <% if operator_notice.link_url %>
          <div class="col text-md-end">
            <%= link_to 'Learn More', operator_notice.link_url, class: 'btn btn-sm btn-dark', rel: 'noopener', target: '_blank' %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
