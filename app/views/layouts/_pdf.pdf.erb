<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <style>
body {
  font-family: 'Helvetica Neue', Helvetica, sans-serif;
  font-size: 8pt;
  line-height: 1;
}

address { font-style: normal; }

.text-center { text-align: center; }
.text-end { text-align: right; }
.float-end { float: right; }

h1, h2, h3, table { margin: 8pt 0 0 0; }
h2, h3 { margin-bottom: 4pt; }
h1, h2, h3, th { text-transform: uppercase; }
h1 { font-size: 13pt; }

ul.list-unstyled {
  list-style-type: none;
  margin: 0;
  padding: 0;
}

ul.list-inline li {
  display: inline;
  margin-right: 1mm;
}

table {
  width: 100%;
  border-collapse: collapse;
}

table td {
  vertical-align: top;
}

table.align-bottom td {
  vertical-align: bottom;
}

table.w-33 {
  width: 33.33%;
}

.bordered { border: 1pt solid black; border-radius: 3pt; }
.float-start { float: left; }
tr.total { font-weight: bold; }
th { font-weight: bold; text-align: left; }
.lowercase { text-transform: lowercase !important; }
tiny { font-size: 6pt; }
.p-r { padding-right: 12pt; }
img { padding-bottom: 6pt; padding-right: 6pt; padding-top: 8pt; }
    </style>
  </head>
  
  <body>
    <%= yield %>
  </body>
</html>
