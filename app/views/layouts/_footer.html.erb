<footer class="mt-6">
  <div class="container-fluid">
    <% if user_signed_in? && current_user.customer? %>
      <% customer_service_email = Setting.value(:customer_service_email) %>
      <% phone = Setting.value(:phone)&.phony_formatted %>

      <% if [customer_service_email, phone].any?(&:present?) %>
        <ul class="list-unstyled">
          <% if phone.present? %>
            <li class="list-inline-item"><%= link_to phone, "tel:#{phone}" %></li>
          <% end %>

          <% if customer_service_email.present? %>
            <li class="list-inline-item"><%= link_to customer_service_email, "mailto:#{customer_service_email}" %></li>
          <% end %>
        </ul>
      <% end %>
    <% end %>

    <% tz = Setting.value(:time_zone, 'America/Los_Angeles') %>
    <div class="mt-2">
      <small class="text-muted">
        Copyright ©
        <%= Time.current.in_time_zone(tz).year %>
        <%= Setting.first_value(:copyright_holder, :name) %>
      </small>
    </div>
  </div>
</footer>
