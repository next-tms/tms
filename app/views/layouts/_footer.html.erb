<footer class="mt-6">
  <div class="container-fluid">
    <% if user_signed_in? && current_user.customer? %>
      <% customer_service_email = Setting.customer_service_email %>
      <% phone = Setting.phone&.phony_formatted %>

      <% if [customer_service_email, phone].any?(&:present?) %>
        <ul class="list-unstyled">
          <% if phone.present? %>
            <li class="list-inline-item"><%= link_to phone, "tel:#{phone}" %></li>
          <% end %>

          <% if customer_service_email.present? %>
            <li class="list-inline-item"><%= link_to customer_service_email, "mailto:#{customer_service_email}" %></li>
          <% end %>
        </ul>
      <% end %>
    <% end %>

    <% if copyright.present? %>
      <div class="mt-2">
        <small class="text-muted"><%= copyright %></small>
      </div>
    <% end %>

    <ul class="list-inline list-inline-separated small">
      <% I18n.available_locales.sort_by { t(:locale_name, locale: it) }.each do |locale| %>
        <li class="list-inline-item">
          <%=
            link_to_unless(
              locale == I18n.locale,
              t(:locale_name, locale:),
              url_for(request.query_parameters.merge(lang: locale)),
              hreflang: locale,
              lang: locale
            )
          %>
        </li>
      <% end %>
    </ul>
  </div>
</footer>
