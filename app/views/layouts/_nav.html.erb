<nav class="navbar navbar-expand sticky-top">
  <div class="container-fluid">
    <% url = user_signed_in? ? root_path : @website.homepage %>

    <%= link_to url, class: 'navbar-brand bg-black rounded p-2' do %>
      <% unless @website&.manifest&.dig('nav', 'logo', 'url').blank? %>
        <%= image_tag @website.manifest.dig('nav', 'logo', 'url'), alt: @website.broker.name, class: 'navbar-brand-logo' %>
      <% else %>
        <%= @website.broker.name %>
      <% end %>
    <% end %>

    <ul class="navbar-nav"></ul>

    <ul class="navbar-nav ml-auto">
      <% unless current_user %>
        <li class="nav-item">
          <%= link_to 'Track Shipment', tracking_path, target: '_top', class: 'nav-link' %>
        </li>

        <li class="nav-item">
          <%= link_to 'Login', new_user_session_path, target: '_top', class: 'nav-link' %>
        </li>
      <% end %>
    </ul>

    <% if current_user && current_user.broker? %>
      <div class='d-flex'>
        <%= bootstrap_form_tag(url: broker_search_path, layout: :inline, method: 'get') do |f| %>
          <%= f.text_field :q, label: 'Search', hide_label: true, placeholder: 'Search' %>
        <% end %>

        <div style="line-height: 2.5" class="ms-4 me-2">
          <%= link_to notifications_path do %>
            <%= icon('solid', 'bell', current_user.notifications.unread.count.zero? ? '' : current_user.notifications.unread.count) %>
          <% end %>
        </div>
      </div>
    <% elsif current_user && current_user.customer? %>
      <%= bootstrap_form_tag(url: customer_search_path, layout: :inline, method: 'get') do |f| %>
        <%= f.text_field :q, label: 'Search', hide_label: true, placeholder: 'Search' %>
      <% end %>
    <% end %>
  </div>
</nav>
