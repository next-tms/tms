<nav class="navbar navbar-expand sticky-top">
  <div class="container-fluid">
    <% url = user_signed_in? ? root_path : homepage %>

    <% name = Setting.value!(:name) %>
    <% data = Setting.website_logo_image_data %>
    <%= link_to url, class: 'navbar-brand bg-black rounded p-2' do %>
      <% if data.present? %>
        <%= image_tag(data, alt: name, class: 'navbar-brand-logo') %>
      <% else %>
        <%= name %>
      <% end %>
    <% end %>

    <ul class="navbar-nav"></ul>

    <ul class="navbar-nav ms-auto">
      <% unless user_signed_in? %>
        <li class="nav-item">
          <%= link_to 'Track Shipment', tracking_path, target: '_top', class: 'nav-link' %>
        </li>

        <li class="nav-item">
          <%= link_to 'Login', new_user_session_path, target: '_top', class: 'nav-link' %>
        </li>
      <% end %>
    </ul>

    <% if user_signed_in? %>
      <% if current_user.broker? %>
        <div class='d-flex'>
          <%= bootstrap_form_tag(url: broker_search_path, layout: :inline, method: :get) do |f| %>
            <%= f.text_field :q, label: 'Search', hide_label: true, placeholder: 'Search' %>
          <% end %>
  
          <%= turbo_stream_from current_user, :notifications %>
  
          <%= link_to notifications_path, class: "btn btn-primary position-relative ms-4" do %>
            <%= icon('solid', 'bell') %>
            <span id="<%= dom_id(current_user) %>_unread_notifications_count"
                  class="position-absolute start-100 translate-middle badge rounded-pill bg-danger"
                  style="top: 15%">
              <%= current_user.notifications.unread.count %>
            </span>
          <% end %>
        </div>
      <% elsif current_user.customer? %>
        <%= bootstrap_form_tag(url: customer_search_path, layout: :inline, method: :get) do |f| %>
          <%= f.text_field :q, label: 'Search', hide_label: true, placeholder: 'Search' %>
        <% end %>
      <% end %>
    <% end %>
  </div>
</nav>
