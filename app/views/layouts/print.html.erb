<!DOCTYPE html>

<head>
  <title><%= yield :title %> — <%= @website ? @website.broker.name : t(:app_name) %></title>
  <meta charset="utf-8">
  <meta name="turbolinks-cache-control" content="no-cache" />
  <link href="https://<%= @website.blank? ? 'liftoff.rocks' : @website.domain %><%= request.fullpath %>" rel="canonical" />

  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/paper-css/0.3.0/paper.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-v4-grid-only@1.0.0/dist/bootstrap-grid.min.css">
  <style media="all">
    @page { size: letter }
    body {
      font-family: 'Helvetica Neue', Helvetica, sans-serif;
      font-size: 8pt;
      line-height: 1.2;
    }
    address { font-style: normal; }
    .text-center { text-align: center; }
    .text-right { text-align: right; }
    .row { width: 100%; }
    h1, h2, h3 { margin: 8pt 0 0 0; }
    h3 { margin-bottom: 4pt; }
    h1, h2, h3, th { text-transform: uppercase; }
    h1 { font-size: 13pt; }
    ul.list-unstyled {
      list-style-type: none;
      margin: 0;
      padding: 0;
    }
    ul.list-inline li {
      display: inline;
      margin-right: 1mm;
    }
    .margin-top { margin-top: 4pt !important; }
    table {
      width: 100%;
      border-collapse: collapse;
    }
    .bordered { border: 1pt solid black; }
    .float-left { float: left; }
    tr.total { font-weight: bold; }
    th { font-weight: bold; text-align: left; }
    .lowercase { text-transform: lowercase !important; }
    tiny { font-size: xx-small; }
    .p-r { padding-right: 12pt; }
  </style>

</head>

<body class="letter">
  <section class="sheet padding-10mm">
    <%= yield %>
  </section>
</body>

</html>