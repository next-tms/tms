<aside class="col col-md-2 p-4">
  <ul class="list-unstyled mt-4">
    <% if current_user.has_role?('sales_rep') || current_user.has_role?('dispatch') %>
      <li class="mb-2 p-2">
        <%= link_to icon('solid', 'pallet', 'Shipments'), broker_shipments_path, class: 'shipments' %>
      </li>
    <% end %>

    <% if current_user.has_role? 'carrier_relations' %>
      <li class="mb-2 p-2">
        <%= link_to icon('solid', 'truck-moving', 'Carriers'), broker_broker_carriers_path, class: 'broker-carriers' %>
      </li>
    <% end %>
  
    <% if current_user.has_role?('root') || current_user.has_role?('sales_rep') %>
      <li class="mb-2 p-2">
        <%= link_to icon('solid', 'handshake', 'Customers'), broker_broker_customers_path, class: 'broker-customers' %>
      </li>
    <% end %>
  </ul>

  <ul class="list-unstyled mt-4">
    <% if current_user.has_role?('root') || current_user.problems.any? %>
      <li class="mb-2 p-2">
        <%= link_to icon('solid', 'circle-exclamation', 'Exceptions'), unresolved_broker_problems_path, class: 'problems' %>
      </li>
    <% end %>
  </ul>

  <ul class="list-unstyled mt-4">
    <% if current_user.has_role?('admin') %>
      <li class="mb-2 p-2">
        <%= link_to icon('solid', 'dollar-sign', 'Commissions'), broker_broker_customer_sales_reps_path, class: 'broker-customer-sales-reps' %>
      </li>
    <% elsif current_user.has_role? 'sales_rep' %>
      <li class="mb-2 p-2">
        <%= link_to icon('solid', 'dollar-sign', 'Commissions'), commissions_broker_broker_customer_sales_rep_path(current_user), class: 'broker-customer-sales-reps' %>
      </li>
    <% end %>

    <% if current_user.has_role? 'accounts_payable' or current_user.has_role? 'accounts_receivable' or current_user.has_role? 'controller' %>
      <% if current_user.has_role? 'accounts_payable' %>
        <li class="mb-2 p-2">
          <%= link_to icon('solid', 'file-invoice', 'Payables'), broker_payments_path, class: 'payments' %>
        </li>
      <% end %>
    
      <% if current_user.has_role? 'accounts_receivable' %>
        <li class="mb-2 p-2">
          <%= link_to icon('solid', 'hand-holding-usd', 'Receivables'), broker_receivables_path, class: 'receivables' %>
        </li>
      <% end %>
    <% end %>
  </ul>

  <ul class="list-unstyled mt-4">
    <% if current_user.has_role? 'root' %>
      <li class="mb-2 p-2">
        <%= link_to icon('solid', 'university', 'Banks'), broker_banks_path, class: 'banks' %>
      </li>
    <% end %>

    <% if current_user.has_role? 'root' %>
      <li class="mb-2 p-2"><%= link_to icon('solid', 'users', 'Users'), broker_users_path, class: 'users' %></li>
    <% end %>
  </ul>

  <ul class="list-unstyled mt-4">
    <li class="mb-2 p-2"><%= link_to icon('solid', 'user-circle', 'Account'), edit_user_registration_path, class: 'registrations' %></li>
    <li class="mb-2 p-2"><%= link_to icon('solid', 'cog', 'Settings'), broker_settings_path, class: 'broker' %></li>
    <li class="mb-2 p-2"><%= link_to icon('solid', 'sign-out-alt', 'Logout'), destroy_user_session_path, data: { action: 'authentication#signout' } %></li>
  </ul>
</aside>
