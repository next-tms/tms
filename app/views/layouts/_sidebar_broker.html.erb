<aside class="col col-md-2 p-4">
  <% if current_user.role?(:root) || Problem.by_any_role(*current_user.roles).any? %>
    <ul class="list-unstyled mt-4">
      <li class="mb-2 p-2">
        <%= link_to icon('solid', 'table-list', 'Tasks'), yours_broker_problems_path, class: 'problems' %>
      </li>
    </ul>
  <% end %>

  <ul class="list-unstyled mt-4">
    <% if current_user.any_role?(:accounts_receivable, :dispatch, :sales_rep) %>

      <% path = current_user.dispatcher? ? broker_shipments_as_dispatcher_path : broker_shipments_path %>
      <li class="mb-2 p-2">
        <%= link_to icon('solid', 'pallet', 'Shipments'), path, class: 'shipments' %>
      </li>
    <% end %>

    <% if current_user.any_role?(:accounts_payable, :carrier_relations, :dispatch) %>
      <li class="mb-2 p-2">
        <%= link_to icon('solid', 'truck-moving', 'Carriers'), broker_broker_carriers_path, class: 'broker-carriers' %>
      </li>
    <% end %>

    <% if current_user.any_role?(:accounts_receivable, :dispatch, :sales_rep) %>
      <li class="mb-2 p-2">
        <%= link_to icon('solid', 'handshake', 'Customers'), broker_broker_customers_path, class: 'broker-customers' %>
      </li>
    <% end %>
  </ul>

  <ul class="list-unstyled mt-4">
    <% if current_user.any_role?(:accounts_payable, :accounts_receivable, :claims) %>
      <li class="mb-2 p-2">
        <%= link_to icon('solid', 'circle-exclamation', 'Claims'), unpaid_broker_claims_path, class: 'claims-unpaid' %>
      </li>
    <% end %>
  </ul>

  <ul class="list-unstyled mt-4">
    <% if current_user.role?(:admin) %>
      <li class="mb-2 p-2">
        <%= link_to icon('solid', 'sack-dollar', 'Commissions'), broker_broker_customer_sales_reps_path, class: 'broker-customer-sales-reps' %>
      </li>
    <% elsif current_user.role?(:sales_rep) %>
      <li class="mb-2 p-2">
        <%= link_to icon('solid', 'sack-dollar', 'Commissions'), broker_broker_customer_sales_rep_path(current_user), class: 'broker-customer-sales-reps' %>
      </li>
    <% end %>

    <% if current_user.any_role?(:accounts_payable, :accounts_receivable, :controller) %>
      <% if current_user.role?(:accounts_payable) %>
        <li class="mb-2 p-2">
          <%= link_to icon('solid', 'money-bills', 'Bills'), due_broker_payment_transactions_path, class: 'payment-transactions' %>
        </li>

        <li class="mb-2 p-2">
          <%= link_to icon('solid', 'file-invoice', 'Payments'), due_broker_payments_path, class: 'payments' %>
        </li>
      <% end %>

      <% if current_user.role?(:accounts_receivable) %>
        <li class="mb-2 p-2">
          <%= link_to icon('solid', 'hand-holding-usd', 'Receivables'), broker_receivables_path, class: 'receivables' %>
        </li>
      <% end %>
    <% end %>
  </ul>

  <ul class="list-unstyled mt-4">
    <% if current_user.role?(:root) %>
      <li class="mb-2 p-2">
        <%= link_to icon('solid', 'university', 'Banks'), broker_banks_path, class: 'banks' %>
      </li>

      <li class="mb-2 p-2"><%= link_to icon('solid', 'users', 'Users'), broker_users_path, class: 'users' %></li>
    <% end %>
  </ul>

  <ul class="list-unstyled mt-4">
    <li class="mb-2 p-2"><%= link_to icon('solid', 'user-circle', 'Account'), edit_user_registration_path, class: 'registrations' %></li>

    <% if current_user.role?(:root) %>
      <li class="mb-2 p-2">
        <%= link_to icon('solid', 'building', 'Company'), broker_settings_company_path, class: 'broker' %>
      </li>

      <li class="mb-2 p-2">
        <%= link_to icon('solid', 'cog', 'Settings'), broker_settings_path, class: 'settings' %>
      </li>
    <% end %>

    <li class="mb-2 p-2"><%= link_to icon('solid', 'sign-out-alt', 'Logout'), destroy_user_session_path, data: { action: 'authentication#signout' } %></li>
  </ul>
</aside>
