<div class="modal fade" id="nav-modal" tabindex="-1" role="dialog" aria-labelledby="nav-modal-btn" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-body">
        <div class="row pb-4">
          <% if current_user.has_role? 'carrier_relations' %>
            <div class="col-3 text-center"><%= link_to "#{icon 'fas', 'truck-moving'}<br>Carriers".html_safe, broker_broker_carriers_path, 'data-turbo': 'false' %></div>
          <% end %>
          <% if current_user.has_role? 'sales_rep' %>
            <div class="col-3 text-center"><%= link_to "#{icon 'fas', 'pallet'}<br>Shipments".html_safe, broker_shipments_path, 'data-turbo': 'false' %></div>
          <% end %>
          <% if current_user.has_role?('root') || current_user.has_role?('sales_rep') %>
            <div class="col-3 text-center"><%= link_to "#{icon 'fas', 'handshake'}<br>Customers".html_safe, broker_broker_customers_path, 'data-turbo': 'false' %></div>
          <% end %>

          <% if current_user.has_role? 'admin' %>
            <div class="col-3 text-center"><%= link_to "#{icon 'fas', 'dollar-sign'}<br>Commissions".html_safe, broker_broker_customer_sales_reps_path, 'data-turbo': 'false' %></div>
          <% elsif current_user.has_role? 'sales_rep' %>
            <div class="col-3 text-center"><%= link_to "#{icon 'fas', 'dollar-sign'}<br>Commissions".html_safe, commissions_broker_broker_customer_sales_rep_path(current_user), 'data-turbo': 'false' %></div>
          <% end %>

          <% if current_user.has_role? 'root' %>
            <div class="col-3 text-center"><%= link_to "#{icon 'fas', 'users'}<br>Users".html_safe, broker_users_path, 'data-turbo': 'false' %></div>
          <% end %>
        </div>
        <% if current_user.has_role? 'accounts_payable' or current_user.has_role? 'accounts_receivable' or current_user.has_role? 'controller' %>
          <div class="row border-top pt-4">
            <% if current_user.has_role? 'accounts_payable' %>
              <div class="col-3 text-center"><%= link_to "#{icon 'fas', 'file-invoice-dollar'}<br>Payables".html_safe, broker_payments_path %></div>
              <div class="col-3 text-center"><%= link_to "#{icon 'fas', 'university'}<br>Accounts".html_safe, broker_banks_path %></div>
            <% end %>
          </div>
        <% end %>
        <%= render 'layouts/nav_manifest_modal_rows' %>
        <div class="row border-top pt-4">
          <div class="col-3 text-center"><%= link_to "#{icon 'fas', 'user-circle'}<br>Account".html_safe, edit_user_registration_path %></div>
          <% if current_user.has_role?('admin') %>
            <div class="col-3 text-center"><%= link_to "#{icon 'fas', 'cog'}<br>Settings".html_safe, broker_settings_path %></div>
          <% end %>
          <div class="col-3 text-center">
            <%= link_to "#{icon 'fas', 'sign-out-alt'}<br>Logout".html_safe, destroy_user_session_path, data: { action: 'authentication#signout' } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
