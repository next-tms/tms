<aside class="col col-md-2 p-4">
  <ul class="list-unstyled mt-4">
    <li class="mb-2 p-2">
      <%= link_to icon('solid', 'building', 'Accounts'), carrier_root_path, class: 'broker-carriers' %>
    </li>

    <% current_user.companyable.broker_carriers.includes(broker_customer: :customer).each do |broker_carrier| %>
      <li class="mb-2 p-2 ps-4">
        <%= link_to broker_carrier.broker_customer&.customer&.name || Setting.value!(:name), carrier_broker_carrier_shipments_path(broker_carrier) %>
      </li>
    <% end %>
  </ul>

  <ul class="list-unstyled mt-4">
    <li class="mb-2 p-2"><%= link_to icon('solid', 'user-circle', 'Account'), edit_user_registration_path, class: 'registrations' %></li>
    <li class="mb-2 p-2"><%= link_to icon('solid', 'key', APIKey.model_name.human(count: 2)), api_keys_path, class: 'api-keys rolls' %></li>
    <li class="mb-2 p-2"><%= link_to icon('solid', 'sign-out-alt', 'Logout'), destroy_user_session_path, data: { action: 'authentication#signout' } %></li>
  </ul>
</aside>
