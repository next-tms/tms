<!DOCTYPE html>
  <head>
    <title><%= yield :title %> — <%= @website ? @website.broker.name : t(:app_name) %></title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <% unless @website.blank? %>
      <% unless @website&.manifest&.dig('head', 'links').blank? %>
        <% @website.manifest.dig('head', 'links').each do |link_options| %>
          <%= tag 'link', link_options %>
        <% end %>
      <% end %>
      <meta name="description" content="<%= @website.desc %>"/>
    <% else %>
      <meta name="description" content="<%= t :app_name %> breathes life into your shipments by automating your biggest headaches."/>
    <% end %>
    <% if !yield(:no_cache).blank? || !flash.blank? %>
      <meta name="turbo-cache-control" content="no-cache"/>
    <% end %>

    <%= yield :alt_links %>

    <meta name="theme-color" content="<%= @website&.manifest&.dig('head', 'meta', 'theme-color') || 'black' %>">

    <link href="https://<%= @website.blank? ? 'tms.next-tms.com' : @website.domain %><%= request.fullpath %>" rel="canonical" />

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="stylesheet" href="https://ga.jspm.io/npm:flatpickr@4.6.13/dist/flatpickr.min.css">

    <% if yield(:prefetch_urls_csv) %>
      <% yield(:prefetech_urls_csv).split(', ').each do |url| %>
        <link rel="prefetch" href="<%= url %>"/>
      <% end %>
    <% end %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

 
  <% if current_user %>
    <style>
      <% broker = current_user.broker %>

      /* Primary Colors */
      :root {
        --bs-primary: <%= broker.theme_primary_color %>;
        --bs-link-color: <%= broker.theme_primary_color %>;
        --bs-link-hover-color: <%= broker.theme_primary_color %>;
      }

      .form-control:focus {
        border-color: <%= broker.theme_primary_color %>;
      }

      .form-check-input:checked {
        border-color: <%= broker.theme_primary_color %>;
        background-color: <%= broker.theme_primary_color %>;
      }

      .pagination {
        --bs-pagination-active-bg: <%= broker.theme_primary_color %>;
        --bs-pagination-active-border-color: <%= broker.theme_primary_color %>;
      }

      .btn-primary {
        --bs-btn-bg: <%= broker.theme_primary_color %>;
        --bs-btn-border-color: <%= broker.theme_primary_color %>;
        --bs-btn-hover-bg: <%= broker.theme_primary_color %>;
        --bs-btn-hover-border-color: <%= broker.theme_primary_color %>;
      }

      /* Sidebar Colors  */

      aside {
        background: <%= broker.theme_sidebar_background_color %>;
      }

      aside, aside a, aside a:active, aside a:hover, aside a:visited {
        color: <%= broker.theme_sidebar_text_color %>;
      }
    </style> 
  <% end %>

  <body data-controller="active" data-active-controller-value="<%= controller.controller_name.gsub('_', '-') %>" data-active-action-value="<%= action_name.gsub('_', '-') %>">
    <!--
      Circumvent Facebook/Instagram in-app <script> injection, see
      https://krausefx.com/blog/ios-privacy-instagram-and-facebook-can-track-anything-you-do-on-any-website-in-their-in-app-browser
    -->
    <span id="iab-pcm-sdk"></span>
    <span id="iab-autofill-sdk"></span>

    <turbo-frame id="modal"></turbo-frame>

    <%= render 'layouts/nav' %>

    <% flash.each do |type, message| %>
      <% next if type.to_s == 'timedout' %>

      <div class="flash-alert alert alert-<%= flash_class type %> mb-0 border-0 rounded-0">
        <div class="container-fluid">
          <span><%= message %></span>
        </div>
      </div>
    <% end %>

    <% if current_user != true_user %>
      <div class="flash-alert alert alert-danger mb-0 border-0 rounded-0">
        <div class="container-fluid">
          <div class="row">
            <div class="col-auto">
              You are impersonating <%= current_user.full_name %> from <%= current_user.companyable.name %>.
            </div>

            <div class="col text-md-end">
              <%= link_to 'Stop Impersonating',
                          stop_impersonating_broker_users_path,
                          class: 'btn btn-sm btn-danger text-light',
                          data: { turbo_method: :delete, turbo_target: :_top }
              %>
            </div>
         </div>
        </div>
      </div>
    <% end %>

    <div class="container-fluid">
      <div class="row">
        <% if @website && current_user %>
          <%= render 'layouts/sidebar' %>
        <% end %>

        <% if @website && current_user %>
          <div class="col col-md-10 p-3" data-controller="emails">
            <%= yield %>
            <!--
              <%= render 'layouts/footer' %>
            -->
          </div>
        <% else %>
          <div class="col m-4" data-controller="emails">
            <%= yield %>
          </div>
        <% end %>
      </div>
    </div>
  </body>
</html>
