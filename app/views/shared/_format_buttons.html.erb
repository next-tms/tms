<%# locals: (label:, target: {}, formats: %i[csv yaml]) %>
<% format_path = ->(format) { url_for(target.is_a?(Hash) ? target.merge(format:) : [ *target, { format: } ]) } %>
<% primary_format, *other_formats = formats %>

<div class="btn-group">
  <%= button_tag icon('solid', 'download', "#{label} #{primary_format.to_s.upcase}"),
                 class: 'btn btn-primary',
                 formaction: format_path.call(primary_format),
                 name: nil
  %>
  <button type="button" class="btn btn-primary dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-expanded="false">
    <span class="visually-hidden">More options</span>
  </button>
  <ul class="dropdown-menu dropdown-menu-end">
    <% other_formats.each do |format| %>
      <li><%= button_tag "#{label} #{format.to_s.upcase}", class: 'dropdown-item', formaction: format_path.call(format), name: nil %></li>
    <% end %>
  </ul>
</div>
