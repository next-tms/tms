<% unless broker_customer_contacts.blank? %>
  <div class="table-responsive">
    <table class="table table-borderless table-striped table-hover sortable">
      <thead>
        <tr>
          <th><%= sort_link @q, :contact_first_name, 'Name' %></th>
          <th>Phone</th>
          <th><%= sort_link @q, :contact_email, 'Email' %></th>
        </tr>
      </thead>
      <tbody>
        <% broker_customer_contacts.each do |broker_customer_contact| %>
          <tr data-link="<%= broker_broker_customer_broker_customer_contact_path(@broker_customer, broker_customer_contact) %>" class="data-link">
            <td>
              <%= broker_customer_contact.contact.first_name %>
              <%= broker_customer_contact.contact.last_name %>
            </td>
            <td>
              <ul class="list-unstyled">
                <% unless broker_customer_contact.contact.mobile_phone.blank? %>
                  <li><%= link_to broker_customer_contact.contact.mobile_phone.phony_formatted, "tel:#{broker_customer_contact.contact.mobile_phone.phony_formatted}" %> <span class="badge badge-info">Mobile</span></li>
                <% end %>
                <% unless broker_customer_contact.contact.work_phone.blank? %>
                  <li><%= link_to broker_customer_contact.contact.work_phone.phony_formatted, "tel:#{broker_customer_contact.contact.work_phone.phony_formatted}" %> <span class="badge badge-info">Office</span></li>
                <% end %>
              </ul>
            </td>
            <td>
              <% unless broker_customer_contact.contact.email.blank? %>
                <%= link_to broker_customer_contact.contact.email, "mailto:#{broker_customer_contact.contact.email}" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <%= render 'layouts/no_content' %>
<% end %>
