<%= bootstrap_form_with(model: [:broker, @broker_customer, @broker_customer_contact], path: [:broker, @broker_customer, @broker_customer_contact], layout: :horizontal) do |f| %>
  <%= f.alert_message "Unable to create contact:" %>

  <%= f.fields_for :contact do |contact_form| %>
    <div class="form-row">
      <div class="col">
        <p class="col-title">About</p>
        <%= contact_form.text_field :first_name, label: 'First', autofocus: true %>
        <%= contact_form.text_field :last_name, label: 'Last' %>
        <%= contact_form.text_field :job_title, label: 'Title' %>
      </div>

      <div class="col">
        <p class="col-title">Phones</p>
        <%= contact_form.text_field :mobile_phone, label: 'Mobile' %>
        <%= contact_form.text_field :work_phone, label: 'Office' %>
      </div>

      <div class="col">
        <p class="col-title">Email</p>
        <%= contact_form.email_field :email %>
      </div>
    </div>
  <% end %>

  <%= f.form_group do %>
    <%= f.submit class: 'btn btn-primary', value: 'Save' %>
  <% end %>
<% end %>
