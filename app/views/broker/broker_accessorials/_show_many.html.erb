<% unless broker_accessorials.blank? %>
  <div class="table-responsive">
    <table class="table table-borderless table-striped table-hover sortable">
      <thead>
        <tr>
          <th>Name</th>
          <% unless defined? broker_customer %>
            <th>Customer</th>
          <% end %>
          <th>Flat Charge</th>
          <th>Upcharge</th>
          <th>Upcharge %</th>
        </tr>
      </thead>
      <tbody>
        <% broker_accessorials.each do |broker_accessorial| %>
          <tr>
            <td><%= broker_accessorial.name %></td>
            <% unless defined? broker_customer %>
              <td><%= broker_accessorial.broker_customer.blank? ? 'All' : broker_accessorial.broker_customer.name %></td>
            <% end %>
            <td><%= humanized_money_with_symbol(broker_accessorial.flat_charge) %></td>
            <td><%= humanized_money_with_symbol(broker_accessorial.upcharge) %></td>
            <td><%= broker_accessorial.upcharge_percent.blank? ? '0' : "#{broker_accessorial.upcharge_percent * 100}%" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>