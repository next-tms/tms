<% provide :title, 'Contacts & Users' %>

<%= render 'member_header' %>
<h2><%= yield :title %></h2>

<div class="btn-toolbar mb-3">
  <div class="btn-group">
    <%= link_to icon('fas', 'plus', 'New'), new_broker_contact_path(broker_customer_id: @broker_customer.id), class: 'btn mr-2' %>
  </div>
</div>

<%= turbo_frame_tag :contacts do %>
  <%= render 'broker/contacts/show_many', contacts: @contacts, q: @q %>
<% end %>
