<div class="nested-fields form-inline form-row mb-2">
  <%= f.hidden_field :_destroy %>
  <%= f.text_field :min, hide_label: true, placeholder: 'Min', class: 'mr-1 col-1', wrapper: false %>
  <%= f.text_field :max, hide_label: true, placeholder: 'Max', class: 'mr-1 col-1', wrapper: false %>
  <%= f.select :packaging_id, Packaging.order(:name).all.collect {|c| [ c.name.pluralize, c.id ] }, { label: 'Packaging', hide_label: true }, class: 'custom-select mr-2 col', wrapper: false %>
  <%= f.text_field :upcharge, prepend: '$', hide_label: true, default: 0, placeholder: 'Cost', data: money_controller_data, autocomplete: 'off' %>
  <%= f.hidden_field :upcharge_percentage, value: 0 %>
  <div class="col">
    <%= link_to icon('fas', 'trash'), '#', class: 'remove-fields btn btn-light' %>
  </div>
</div>