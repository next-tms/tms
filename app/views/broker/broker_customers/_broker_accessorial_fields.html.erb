<div class="nested-fields form-inline form-row mb-2">
  <%= f.hidden_field :_destroy %>
  <%= f.select :accessorial_id, @broker_customer.eligible_broker_accessorials.where.not(accessorial: nil).map(&:accessorial).collect { |accessorial| [ accessorial.name, accessorial.id ] }, { include_blank: 'None', label: '&nbsp;'.html_safe, help: 'Accessorial to use in API quote' }, class: 'custom-select mr-2', wrapper: false %>
  <%= f.text_field :code, label: '&nbsp;'.html_safe, help: 'Only required if non-standard accessorial', class: 'mr-2', wrapper: false %>
  <%= f.text_field :name, label: '&nbsp;'.html_safe, class: 'mr-2', wrapper: false %>
  <%= f.text_field :upcharge_percent, label: '&nbsp;'.html_safe, help: 'Charge percent of carrier fee to customer (if more than 0%)', default: 0, prepend: '%', data: money_controller_data, autocomplete: 'off' %>
  <%= f.text_field :upcharge, label: '&nbsp;'.html_safe, help: 'Charge set amount more after percent of carrier fee is applied', default: 0, prepend: '$', data: money_controller_data, autocomplete: 'off' %>
  <%= f.text_field :flat_charge, label: '&nbsp;'.html_safe, help: 'Always apply this amount regardless of carrier fee', default: 0, prepend: '$', data: money_controller_data, autocomplete: 'off' %>
  <div class="col">
    <%= link_to icon('fas', 'trash'), '#', class: 'remove-fields btn btn-light' %>
  </div>
</div>