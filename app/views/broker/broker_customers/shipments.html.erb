<% provide :title, @broker_customer.customer.name %>

<div class="page-header">
  <h1><%= @broker_customer.customer.name %></h1>
  <p class="lead">Customer Shipments</h2>
</div>

<h2>Shipments</h2>

<%= bootstrap_form_tag(url: broker_broker_customer_shipments_path(@broker_customer), method: 'get', layout: :inline) do |f| %>
  <%= f.text_field :from_date, label: 'From', autocomplete: 'off', class: 'flatpickr-date-max-today mr-2', value: (@from_date ? @from_date : '') %>
  <%= f.text_field :to_date, label: 'Until', autocomplete: 'off', class: 'flatpickr-date-max-today', value: (@to_date ? @to_date : '') %>
  <div class="form-group">
    <%= link_to 'Clear', broker_broker_customer_shipments_path(@broker_customer), class: 'btn btn-light ml-2', value: 'Clear' %>
    <%= f.submit class: 'btn btn-primary ml-2', value: 'Filter' %>
  </div>
<% end %>
<div class="mb-4">&nbsp;</div>

<%= render 'broker/shipments/show_many_pricing', shipments: @shipments %>