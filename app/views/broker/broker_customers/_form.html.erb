<%= bootstrap_form_with(model: [:broker, @broker_customer], layout: :horizontal) do |f| %>
  <%= f.alert_message "Unable to save customer:" %>

  <%= f.fields_for :customer do |customer_form| %>
    <%= customer_form.text_field :name, placeholder: 'Name', autofocus: true %>
  <% end %>

  <div class="form-group row">
    <label class="col-form-label col-sm-2">Primary Pickup Address</label>

    <div class="col-sm-10" data-controller="address">
      <%= f.fields_for :primary_pickup_address do |primary_pickup_address_form| %>
        <%= primary_pickup_address_form.text_field :street, hide_label: true, placeholder: 'Street' %>
        <%= primary_pickup_address_form.text_field :street2, hide_label: true %>
        <%= primary_pickup_address_form.text_field :city, hide_label: true, placeholder: 'City' %>
        <%= primary_pickup_address_form.select :region_id, (primary_pickup_address_form.object.region_id.blank? ? [[current_user.broker.address.region.name, current_user.broker.address.region.id]] : [[primary_pickup_address_form.object.region.name, primary_pickup_address_form.object.region_id]]), { include_blank: 'State', hide_label: true }, data: { 'address-target': 'regions' }, class: 'form-select' %>
        <%= primary_pickup_address_form.text_field :zip_code, hide_label: true, placeholder: 'ZIP' %>
        <%= primary_pickup_address_form.select :country_id, current_user.broker.countries.order(:name).collect { |c| [c.name, c.id] }, { hide_label: true, selected: (primary_pickup_address_form.object.country_id.blank? ? current_user.broker.address.country_id : primary_pickup_address_form.object.country_id) }, data: { action: 'address#handle', 'address-target': 'country' }, class: 'form-select' %>
      <% end %>
    </div>
  </div>

  <div class="form-group row">
    <label class="col-form-label col-sm-2">Office Address</label>

    <div class="col-sm-10" data-controller="address">
      <%= f.fields_for :office_address do |office_address_form| %>
        <%= office_address_form.text_field :street, hide_label: true, placeholder: 'Street' %>
        <%= office_address_form.text_field :street2, hide_label: true %>
        <%= office_address_form.text_field :city, hide_label: true, placeholder: 'City' %>
        <%= office_address_form.select :region_id, (office_address_form.object.region_id.blank? ? [[current_user.broker.address.region.name, current_user.broker.address.region.id]] : [[office_address_form.object.region.name, office_address_form.object.region_id]]), { include_blank: 'State', hide_label: true }, data: { 'address-target': 'regions' }, class: 'form-select' %>
        <%= office_address_form.text_field :zip_code, hide_label: true, placeholder: 'ZIP' %>
        <%= office_address_form.select :country_id, current_user.broker.countries.order(:name).collect { |c| [c.name, c.id] }, { hide_label: true, selected: (office_address_form.object.country_id.blank? ? current_user.broker.address.country_id : office_address_form.object.country_id) }, data: { action: 'address#handle', 'address-target': 'country' }, class: 'form-select' %>
      <% end %>
    </div>
  </div>

  <div class="form-group row">
    <label class="col-form-label col-sm-2">Documentation Preferences</label>
    <div class="col-sm-10">
      <div data-controller="nested-form" data-nested-form-wrapper-selector-value=".broker-customer-document-preference-form-wrapper">
        <template data-nested-form-target="template">
          <%= f.fields_for :document_preferences, DocumentPreference.new, child_index: 'NEW_RECORD' do |document_preferences_form| %>
            <%= render 'document_preference_form', f: document_preferences_form %>
          <% end %>
        </template>

        <%= f.fields_for :document_preferences do |document_preferences_form| %>
          <%= render 'document_preference_form', f: document_preferences_form %>
        <% end %>

        <div data-nested-form-target="target"></div>

        <%= link_to icon('solid', 'plus', 'Add'), '#', data: { action: 'nested-form#add' }, class: 'btn btn-light' %>
      </div>
    </div>
  </div>

  <div class="form-group row">
    <label class="col-form-label col-sm-2">Receivables Contact</label>

    <div class="col-sm-10">
      <%= f.fields_for :primary_receivables_contact do |receivables_contact_form| %>
        <%= render 'receivables_contact_form', f: receivables_contact_form %>
      <% end %>

      <div data-controller="nested-form" data-nested-form-wrapper-selector-value=".receivables-contact-form-wrapper">
        <template data-nested-form-target="template">
          <%= f.fields_for :receivables_contacts, Contact.new, child_index: 'NEW_RECORD' do |receivables_contact_form| %>
            <%= render 'receivables_contact_form', f: receivables_contact_form %>
          <% end %>
        </template>

        <%= f.fields_for :receivables_contacts do |receivables_contact_form| %>
          <%= render 'receivables_contact_form', f: receivables_contact_form %>
        <% end %>

        <div data-nested-form-target="target"></div>

        <%= link_to icon('solid', 'plus', 'Add'), '#', data: { action: 'nested-form#add' }, class: 'btn btn-light' %>
      </div>
    </div>
  </div>

  <div class="form-group row">
    <label class="col-form-label col-sm-2">Sales Reps &amp; Commissions</label>
    <div class="col-sm-10">
      <div data-controller="nested-form" data-nested-form-wrapper-selector-value=".broker-customer-sales-rep-form-wrapper">
        <template data-nested-form-target="template">
          <%= f.fields_for :broker_customer_sales_reps, BrokerCustomerSalesRep.new, child_index: 'NEW_RECORD' do |broker_customer_sales_reps_form| %>
            <%= render 'broker_customer_sales_rep_form', f: broker_customer_sales_reps_form %>
          <% end %>
        </template>

        <%= f.fields_for :broker_customer_sales_reps do |broker_customer_sales_reps_form| %>
          <%= render 'broker_customer_sales_rep_form', f: broker_customer_sales_reps_form %>
        <% end %>

        <div data-nested-form-target="target"></div>

        <%= link_to icon('solid', 'plus', 'Add'), '#', data: { action: 'nested-form#add' }, class: 'btn btn-light' %>
      </div>
    </div>
  </div>

  <div class="form-group row">
    <label class="col-form-label col-sm-2">Dispatchers</label>
    <div class="col-sm-10">
      <div data-controller="nested-form" data-nested-form-wrapper-selector-value=".broker-customer-dispatchers-form-wrapper">
        <template data-nested-form-target="template">
          <%= f.fields_for :broker_customer_dispatchers, BrokerCustomerDispatcher.new, child_index: 'NEW_RECORD' do |broker_customer_dispatchers_form| %>
            <%= render 'broker_customer_dispatcher_form', f: broker_customer_dispatchers_form %>
          <% end %>
        </template>

        <%= f.fields_for :broker_customer_dispatchers do |broker_customer_dispatchers_form| %>
          <%= render 'broker_customer_dispatcher_form', f: broker_customer_dispatchers_form %>
        <% end %>

        <div data-nested-form-target="target"></div>

        <%= link_to icon('solid', 'plus', 'Add'), '#', data: { action: 'nested-form#add' }, class: 'btn btn-light' %>
      </div>
    </div>
  </div>

  <%= f.text_area :internal_notes, label: 'Customer guide', help: 'Show internally on each shipment', rows: 7 %>
  <%= f.text_area :default_bol_notes, label: 'Default instructions on BOL', rows: 7 %>

  <div class="form-group row">
    <label class="col-form-label col-sm-2">Preferred Carriers</label>
    <div class="col-sm-10">
      <%= f.select :preferred_broker_carriers_kind,
                   [
                     ['Allow only selected carriers', :whitelist],
                     ['Block selected carriers', :blacklist]
                   ],
                   {
                     hide_label: true,
                     include_blank: 'Allow all carriers',
                     wrapper: false
                   },
                   class: 'form-select mb-4'
      %>

      <div data-controller="nested-form" data-nested-form-wrapper-selector-value=".preferred-broker-carrier-form-wrapper">
        <template data-nested-form-target="template">
          <%= f.fields_for :preferred_broker_carriers, PreferredBrokerCarrier.new, child_index: 'NEW_RECORD' do |preferred_broker_carriers_form| %>
            <%= render 'preferred_broker_carrier_form', f: preferred_broker_carriers_form %>
          <% end %>
        </template>

        <% if @broker_customer.preferred_broker_carriers.any? %>
          <%= f.fields_for :preferred_broker_carriers do |preferred_broker_carriers_form| %>
            <%= render 'preferred_broker_carrier_form', f: preferred_broker_carriers_form %>
          <% end %>
        <% end %>

        <div data-nested-form-target="target"></div>

        <%= link_to icon('solid', 'plus', 'Add'), '#', data: { action: 'nested-form#add' }, class: 'btn btn-light' %>
      </div>
    </div>
  </div>

  <div class="form-group row my-4">
    <label class="col-form-label col-sm-2">Receivables</label>
    <div class="col-sm-10">
      <%= f.check_box :requires_charges_confirmed_on_receivables,
                      label: 'Require shipment pricing to be confirmed before creating receivables?' %>
      <%= f.check_box :requires_shipment_shipper_reference_on_receivables,
                      label: 'Require SO on receivables?' %>
      <%= f.check_box :requires_customer_reference_number_on_receivables,
                      label: 'Require PO on receivables?' %>
    </div>
  </div>

  <%= f.form_group do %>
    <%= f.submit 'Save', data: { turbo: false }, class: 'btn btn-primary' %>
  <% end %>
<% end %>
