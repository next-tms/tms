<%= bootstrap_form_with(model: [:broker, @broker_customer], layout: :horizontal) do |f| %>
  <%= f.alert_message "Unable to save customer:" %>

  <%= f.fields_for :customer do |customer_form| %>
    <%= customer_form.text_field :name, placeholder: 'Name', autofocus: true %>
  <% end %>

  <div class="form-group row">
    <label class="col-form-label col-sm-2">Primary Pickup Address</label>

    <div class="col-sm-10" data-controller="address">
      <%= f.fields_for :primary_pickup_address do |primary_pickup_address_form| %>
        <%= primary_pickup_address_form.text_field :street, hide_label: true, placeholder: 'Street' %>
        <%= primary_pickup_address_form.text_field :street2, hide_label: true %>
        <%= primary_pickup_address_form.text_field :city, hide_label: true, placeholder: 'City' %>
        <%= primary_pickup_address_form.select :region_id, [], { include_blank: 'State', hide_label: true }, data: { 'address-target': 'regions' }, class: 'form-select' %>
        <%= primary_pickup_address_form.text_field :zip_code, hide_label: true, placeholder: 'ZIP' %>
        <%= primary_pickup_address_form.select :country_id, current_user.broker.countries.order(:name).collect { |c| [c.name, c.id] }, { hide_label: true, selected: (primary_pickup_address_form.object.country_id.blank? ? current_user.broker.address.country_id : primary_pickup_address_form.object.country_id) }, data: { action: 'address#handle', 'address-target': 'country' }, class: 'form-select' %>
      <% end %>
    </div>
  </div>

  <div class="form-group row">
    <label class="col-form-label col-sm-2">Sales Reps &amp; Commissions</label>
    <div class="col-sm-10">
      <div data-controller="nested-form" data-nested-form-wrapper-selector-value=".broker-customer-sales-rep-form-wrapper">
        <template data-nested-form-target="template">
          <%= f.fields_for :broker_customer_sales_reps, BrokerCustomerSalesRep.new, child_index: 'NEW_RECORD' do |broker_customer_sales_reps_form| %>
            <%= render 'broker_customer_sales_rep_form', f: broker_customer_sales_reps_form %>
          <% end %>
        </template>
    
        <%= f.fields_for :broker_customer_sales_reps do |broker_customer_sales_reps_form| %>
          <%= render 'broker_customer_sales_rep_form', f: broker_customer_sales_reps_form %>
        <% end %>
    
        <div data-nested-form-target="target"></div>
    
        <%= link_to icon('fas', 'plus', 'Add'), '#', data: { action: 'nested-form#add' }, class: 'btn btn-light' %>
      </div>
    </div>
  </div>

  <%= f.text_area :internal_notes, label: 'Customer guide', help: 'Show internally on each shipment', rows: 7 %>
  <%= f.text_area :default_bol_notes, label: 'Default instructions on BOL', rows: 7 %>

  <%= f.form_group do %>
    <%= f.submit 'Save', data: { turbo: false }, class: 'btn btn-primary' %>
  <% end %>
<% end %>
