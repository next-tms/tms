<div class="upcharge-rule-form-wrapper row gy-2 gx-3 align-items-center mb-4" data-new-record="<%= f.object.new_record? %>">
  <div class="col col-md-1">
    <%= f.text_field :min, hide_label: true, placeholder: 'Min', wrapper: false %>
  </div>

  <div class="col col-md-1">
    <%= f.text_field :max, hide_label: true, placeholder: 'Max', wrapper: false %>
  </div>

  <div class="col-auto">
    <%= f.select :packaging_id, Packaging.order(:name).all.collect {|c| [ c.name.pluralize, c.id ] }, { label: 'Packaging', hide_label: true, wrapper: false }, class: 'form-select' %>
  </div>

  <div class="col col-md-2">
    <%= f.text_field :upcharge, prepend: '$', hide_label: true, placeholder: 'Charge', data: money_controller_data, wrapper: false, autocomplete: 'off' %>
  </div>

  <div class="col col-md-2">
    <%= f.text_field :upcharge_percentage, append: '%', hide_label: true, placeholder: '%', wrapper: false, autocomplete: 'off' %>
  </div>

  <div class="col-auto">
    <%= f.hidden_field :_destroy %>
    <%= link_to icon('solid', 'trash', 'Remove'), '#', data: { action: 'nested-form#remove' }, class: 'btn btn-light' %>
  </div>
</div>
