<div class="receivables-contact-form-wrapper row gy-2 gx-3 align-items-center mb-4" data-new-record="<%= f.object.new_record? %>">
  <div class="col col-md-2">
    <%= f.text_field :first_name, placeholder: "First Name", wrapper: false %>
  </div>

  <div class="col col-md-2">
    <%= f.text_field :last_name, placeholder: "Last Name", wrapper: false %>
  </div>

  <div class="col col-md-2">
    <%= f.email_field :email, placeholder: "Email", wrapper: false %>
  </div>

  <div class="col-auto">
    <label>&nbsp;</label>
    <div class="form-check form-switch mb-4" style="padding-left: 14px">
      <%= f.check_box :primary, label: 'Primary?', data: { action: 'contacts#uncheckOtherPrimary' }, class: "form-check-input" %>
    </div>
  </div>

  <div class="col-auto">
    <%= f.hidden_field :_destroy %>
    <%= link_to icon('solid', 'trash', 'Remove'), '#', data: { action: 'nested-form#remove' }, class: 'btn btn-light' %>
  </div>
</div>
