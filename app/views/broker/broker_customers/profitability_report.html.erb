<% provide :title, 'Profitability' %>

<%= render 'header' %>
<h2><%= yield :title %></h2>

<div class="row">
  <div class="col col-md-4">
    <%= bootstrap_form_tag(url: broker_customers_profitability_report_path, method: :get, layout: :horizontal) do |f| %>
      <%= f.text_field :from_date,
                       autocomplete: 'off',
                       class: 'me-2',
                       label: 'From',
                       data: flatpickr_data({ max_date: @tz.now.to_date }),
                       value: @from_date
      %>

      <%= f.text_field :to_date,
                       autocomplete: 'off',
                       class: 'me-2',
                       label: 'To',
                       data: flatpickr_data({ max_date: @tz.now.to_date }),
                       value: @to_date
      %>

      <%= f.submit class: 'btn btn-primary', value: 'Generate' %>
    <% end %>
  </div>
</div>

<% if BrokerCustomer.any? %>
  <div class="table-responsive">
    <table class="table table-borderless table-striped table-hover sortable">
      <thead>
        <tr>
          <th>Customer</th>

          <th>
            <small class="text-muted">Shipped / Total</small>
            <br/>
            Shipments
          </th>

          <th>Costs</th>
          <th>Charges</th>
          <th>Profit</th>
          <th>Margin</th>
        </tr>
      </thead>
      <tbody>
        <% dispatched_shipments_count = 0 %>
        <% total_charges = Money.new(0) %>
        <% total_cost = Money.new(0) %>
        <% total_profit = Money.new(0) %>
        <% total_shipments_count = 0 %>

        <% @broker_customers.each do |broker_customer| %>
          <% profitability_report = broker_customer.profitability_report(@from_date, @to_date) %>
          <% next if profitability_report.blank? %>
          <% next if profitability_report[:total_cost].zero? && profitability_report[:total_charges].zero? %>

          <% dispatched_shipments_count += profitability_report[:dispatched_shipments_count] %>
          <% total_charges = total_charges + profitability_report[:total_charges] %>
          <% total_cost = total_cost + profitability_report[:total_cost] %>
          <% total_profit = total_profit + profitability_report[:total_profit] %>
          <% total_shipments_count += profitability_report[:total_shipments_count] %>

          <tr>
            <td>
              <%= broker_customer.customer.name %>
            </td>

            <td data-sort=<%= profitability_report[:total_shipments_count] %>>
              <%= profitability_report[:dispatched_shipments_count] %> /
              <%= profitability_report[:total_shipments_count] %>

              <div class="float-end">
                <% percentage = (profitability_report[:dispatched_shipments_count].to_f / profitability_report[:total_shipments_count].to_f) * 100 %>
                <%= percentage.round %>%
              </div>
            </td>

            <td data-sort=<%= profitability_report[:total_cost] %>>
              <%= humanized_money_with_symbol profitability_report[:total_cost], no_cents_if_whole: false %>
            </td>

            <td data-sort=<%= profitability_report[:total_charges]%>>
              <%= humanized_money_with_symbol profitability_report[:total_charges], no_cents_if_whole: false %>
            </td>

            <td data-sort=<%= profitability_report[:total_profit]%>>
              <%= humanized_money_with_symbol profitability_report[:total_profit], no_cents_if_whole: false %>
            </td>

            <td>
              <% if profitability_report[:total_margin] %>
                <%= profitability_report[:total_margin]  %>%
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
      <tfoot>
        <tr class="bg-light font-weight-bold">
          <td>&nbsp;</td>

          <td>
            <%= dispatched_shipments_count %> /
            <%= total_shipments_count %>

            <% if total_shipments_count.positive? %>
              <div class="float-end">
                <% percentage = (dispatched_shipments_count.to_f / total_shipments_count.to_f) * 100 %>
                <%= percentage.round %>%
              </div>
            <% end %>
          </td>

          <td><%= humanized_money_with_symbol total_cost, no_cents_if_whole: false %></td>
          <td><%= humanized_money_with_symbol total_charges, no_cents_if_whole: false %></td>
          <td><%= humanized_money_with_symbol total_profit, no_cents_if_whole: false %></td>
          <td>
            <% if total_charges.zero? %>
              -
            <% else %>
              <%= ( (1 - (total_cost / total_charges)) * 100 ).round(1) %>%
            <% end %>
          </td>
        </tr>
      </tfoot>
    </table>
  </div>
<% else %>
  <p class="lead">You don’t have any customers yet.</p>
<% end %>
