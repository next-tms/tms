<% provide :title, 'Profitability Report' %>
<% provide :menu, render('menu') %>

<div class="page-header">
  <h1>Customers</h1>
  <p class="lead">Profitability Report</p>
</div>

<%= bootstrap_form_tag(url: broker_customers_profitability_report_path, method: 'get', layout: :inline) do |f| %>
  <%= f.text_field :from_date, label: 'From', autocomplete: 'off', data: flatpickr_data({ max_date: Date.current }), class: 'mr-2', value: (@from_date ? @from_date : '') %>
  <%= f.text_field :to_date, label: 'Until', autocomplete: 'off', data: flatpickr_data({ max_date: Date.current }), value: (@to_date ? @to_date : '') %>
  <div class="form-group">
    <%= f.submit class: 'btn btn-primary ml-2', value: 'Generate' %>
  </div>
<% end %>
<div class="mb-4">&nbsp;</div>

<% unless current_user.broker.broker_customers.blank? %>
  <div class="table-responsive">
    <table class="table table-borderless table-striped table-hover sortable">
      <thead>
        <tr>
          <th>Customer</th>
          <th>Shipments</th>
          <th>Costs</th>
          <th>Charges</th>
          <th>Profit</th>
          <th>Margin</th>
        </tr>
      </thead>
      <tbody>
        <% total_cost = Money.new(0) %>
        <% total_charges = Money.new(0) %>
        <% total_profit = Money.new(0) %>
        <% total_shipments = 0 %>
        <% @broker_customers.each do |broker_customer| %>
          <% profitability_report = broker_customer.profitability_report(@from_date, @to_date) %>
          <% next unless profitability_report %>
          <% next if profitability_report[:total_cost] == Money.new(0) and profitability_report[:total_charges] == Money.new(0) %>
          <% total_cost = total_cost + profitability_report[:total_cost] %>
          <% total_charges = total_charges + profitability_report[:total_charges] %>
          <% total_profit = total_profit + profitability_report[:total_profit] %>
          <% total_shipments = total_shipments + profitability_report[:total_shipments] %>
          <tr>
            <td>
              <%= link_to broker_broker_customer_shipments_path(broker_customer.id, params: { from_date: @from_date, to_date: @to_date }) do %>
                <%= broker_customer.customer.name %>
              <% end %>
            </td>
            <td><%= profitability_report[:total_shipments] %></td>
            <td><%= humanized_money_with_symbol profitability_report[:total_cost], no_cents_if_whole: false %></td>
            <td><%= humanized_money_with_symbol profitability_report[:total_charges], no_cents_if_whole: false %></td>
            <td><%= humanized_money_with_symbol profitability_report[:total_profit], no_cents_if_whole: false %></td>
            <td>
              <% unless profitability_report[:total_margin].infinite? %>
                <%= profitability_report[:total_margin]  %>%
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
      <tfoot>
        <tr class="bg-light font-weight-bold">
          <td>&nbsp;</td>
          <td><%= total_shipments %></td>
          <td><%= humanized_money_with_symbol total_cost, no_cents_if_whole: false %></td>
          <td><%= humanized_money_with_symbol total_charges, no_cents_if_whole: false %></td>
          <td><%= humanized_money_with_symbol total_profit, no_cents_if_whole: false %></td>
          <td><%= ( (1 - (total_cost / total_charges)) * 100 ).round(1) %>%</td>
        </tr>
      </tfoot>
    </table>
  </div>
<% else %>
  <p class="lead">You don’t have any customers yet.</p>
<% end %>