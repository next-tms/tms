<div class="nested-fields form-inline form-row mb-2">
  <%= f.hidden_field :_destroy %>
  <%= f.select :user_id, ( current_user.broker.users.brokers.order(:first_name).all ).collect { |user| [ "#{user.first_name} #{user.last_name}", user.id ] }, { label: 'User', hide_label: true }, class: 'custom-select mr-2', wrapper: false %>
  <div class="col">
    <%= link_to icon('fas', 'trash'), '#', class: 'remove-fields btn btn-light' %>
  </div>
</div>