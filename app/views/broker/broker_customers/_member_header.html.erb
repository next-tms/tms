<div class="page-header p-4 mb-4">
  <h1 class="mb-6"><%= @broker_customer&.customer&.name || 'Customer' %></h1>

  <% unless @broker_customer.new_record? %>
    <table class="table table-borderless w-auto">
      <thead>
        <tr>
          <th>Shipments</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td class="lead">
            <%= link_to @broker_customer.shipments.size, broker_broker_customer_shipments_path(@broker_customer), class: 'broker-customers-shipments' %>
          </td>

          <td class="lead">
            <%= link_to icon('solid', 'plus', 'Add Shipment'), new_broker_shipment_path(broker_customer_id: @broker_customer.id), class: 'btn' %>
          </td>
        </tr>
      </tbody>
    </table>
  <% end %>

  <% unless @broker_customer.new_record? %>
    <%= render 'member_menu' %>
  <% end %>
</div>
