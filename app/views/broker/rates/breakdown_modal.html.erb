<%= provide :title, 'Rate' %>

<% if @rate.blank? %>
  <div class="alert alert-info">
    <p>The <%= Rate.model_name.human.downcase %> was deleted so a breakdown of it can’t be provided.</p>
  </div>
<% elsif @rate.breakdown.blank? %>
  <div class="alert alert-info">
    <p>No breakdown was provided for this <%= Rate.model_name.human.downcase %>.</p>
  </div>
<% else %>
  <div class="table-responsive">
    <table class="table table-borderless table-striped">
      <thead>
        <th>Description</th>
        <th>Charge</th>
      </thead>
      <tbody>
        <% @rate.breakdown.each do |line| %>
          <% total_cents = line.dig('cents', 'value').presence || line['cents'].presence || line.dig('cost', 'fractional') %>
          <tr>
            <td><%= line['description'] %></td>
            <td><%= humanized_money_with_symbol (total_cents.to_f / 100), no_cents_if_whole: false %></td>
          </tr>
        <% end %>
      </tbody>
      <tfoot>
        <tr>
          <td>&nbsp;</td>
          <td><strong><%= humanized_money_with_symbol @rate.cost, no_cents_if_whole: false %></strong></td>
      </tfoot>
    </table>

    <p class="col-title">Request</p>
    <textarea class="form-control mb-3" data-action="click->clipboard#copy" data-controller="clipboard" rows="5" readonly><%= @rate.api_request %></textarea>

    <p class="col-title">Response</p>
    <textarea class="form-control" data-action="click->clipboard#copy" data-controller="clipboard" rows="5" readonly><%= @rate.api_response %></textarea>
  </div>
<% end %>
