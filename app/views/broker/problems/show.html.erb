<% provide :title, "Task #{@problem.id}" %>

<%= render 'member_header' %>

<h2>Overview</h2>

<% if @problem.resolved? %>
  <div class="alert alert-success">
    <p class="lead"><%= icon 'solid', 'clipboard-check', 'Closed' %></p>
    <p>
      <%= @problem.resolved_by&.full_name || 'robot' %>
      closed this at
      <%= pretty_date(@problem.resolved_at, current_user.time_zone) %>
    </p>
  </div>
<% else %>
  <div class="table-responsive">
    <table class="table table-borderless">
      <tbody>
        <tr>
          <th>Issue</th>
          <td><%= @problem.problematic_rule.humanized %></td>
        </tr>
        <tr class="<%= @problem.suppressive? ? 'table-danger' : nil %>">
          <th>Suppressions</th>
          <td>
            <% if @problem.suppressive? %>
              <ul class="list-unstyled">
                <% @problem.suppressions.each do |suppression| %>
                  <li><%= suppression.describe %></li>
                <% end %>
              </ul>
            <% else %>
              None
            <% end %>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
<% end %>
