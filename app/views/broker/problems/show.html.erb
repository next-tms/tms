<% provide :title, @problem.title %>

<%= render 'member_header' %>
<h2>Overview</h2>

<% if @problem.resolved? %>
  <div class="alert alert-success">
    <p class="lead">Resolved</p>
    <p>
      <%= @problem.resolved_by&.full_name || 'robot' %>
      reported this issue resolved at
      <%= pretty_date(@problem.resolved_at, current_user.time_zone) %>
    </p>
  </div>
<% end %>

<p class="lead pt-4"><%= @problem.body %></p>
