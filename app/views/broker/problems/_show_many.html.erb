<%= turbo_frame_tag :problems do %>
  <% if controller.controller_name == 'problems' %>
    <%= render 'broker/problems/search_form', q: q %>
  <% end %>

  <% unless problems.blank? %>
    <div class="table-responsive">
      <table class="table table-borderless table-striped">
        <thead>
          <tr>
            <th><%= sort_link q, :id, '#' %></th>
            <th>Suppresses</th>
            <th><%= sort_link q, :created_at, 'Opened' %></th>

            <% if action_name == 'resolved' %>
              <th><%= sort_link q, :resolved_at, 'Closed' %></th>
            <% end %>

            <th><%= sort_link q, :problematic_rule_code, 'Issue' %></th>

            <% if controller.controller_name == 'problems' %>
              <th>Reference</th>
            <% end %>

            <th>
              <span class="text-nowrap"><%= sort_link q, :assigned_to_first_name, 'Assigned To' %></span>
            </th>

            <% if controller.controller_name != 'problems' || action_name == 'resolved' %>
              <th>
                <span class="text-nowrap"><%= sort_link q, :resovled_by_first_name, 'Closed By' %></span>
              </th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% problems.each do |problem| %>
            <tr class="<%= if controller.controller_name != 'problems' && problem.resolved?
                             'text-decoration-line-through'
                           end
                       %>
                       <%= if problem.suppressive? && problem.unresolved?
                             'table-danger'
                           end
                       %>
            ">
              <td>
                <%= link_to problem.id,
                            broker_problem_path(problem),
                            target: (controller_name == 'problems' ? '_top' : '_blank')
                %>
              </td>

              <td>
                <%= problem
                    .suppressions
                    .distinct
                    .pluck(:suppressible_type)
                    .map { |suppressible_type| suppressible_type.constantize.model_name.human }
                    .sort
                    .join(', ')
                    .downcase
                %>
              </td>

              <td class="text-nowrap"><%= time(problem.created_at) %></td>

              <% if action_name == 'resolved' %>
                <td class="text-nowrap"><%= time(problem.resolved_at) %></td>
              <% end %>

              <td><%= problem.problematic_rule.with(problem.resolvable).humanized.downcase %></td>

              <% if controller.controller_name == 'problems' %>
                <td class="text-nowrap">
                  <%= link_to "#{problem.resolvable.class.model_name.human} #{problem.resolvable.to_param}",
                              [:broker, problem.resolvable],
                              target: '_blank'
                  %>
                </td>
              <% end %>

              <td class="text-nowrap"><%= icon 'solid', 'user-circle', problem.assigned_to.full_name %></td>

              <% if controller.controller_name != 'problems' || action_name == 'resolved' %>
                <td class="text-nowrap text-decoration-none">
                  <% if problem.resolved? %>
                    <% if problem.resolved_by.blank? %>
                      <%= icon 'solid', 'robot', 'Robot' %>
                    <% else %>
                      <%= icon 'solid', 'user-circle', problem.resolved_by&.full_name || 'Robot' %>
                    <% end %>
                  <% end %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%= render 'layouts/pagy', pagy: @pagy %>
  <% else %>
    <%= render 'layouts/no_content' %>
  <% end %>
<% end %>
