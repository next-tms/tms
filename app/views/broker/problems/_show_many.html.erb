<%= turbo_frame_tag :problems do %>
  <%= render 'broker/problems/search_form', q: q %>

  <% unless problems.blank? %>
    <div class="table-responsive">
      <table class="table table-borderless table-striped table-hover">
        <thead>
          <tr>
            <th><%= sort_link q, :id, '#' %></th>
            <th><%= sort_link q, :shipment_load_id, 'Shipment' %></th>
            <th><%= sort_link q, :problem_type_id, 'Issue' %></th>
            <th>
              <span class="text-nowrap"><%= sort_link q, :assigned_to_first_name, 'Assigned To' %></span>
            </th>
          </tr>
        </thead>
        <tbody>
          <% problems.each do |problem| %>
            <tr>
              <td><%= link_to problem.id, broker_problem_path(problem), target: '_top' %></td>
              <td><%= link_to problem.shipment.load_id, broker_shipment_path(problem.shipment), target: '_blank' %></td>
              <td><%= problem.problem_type.name %></td>
              <td><%= icon 'solid', 'user-circle', problem.assigned_to.full_name %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%= render 'layouts/pagy', pagy: @pagy %>
  <% else %>
    <%= render 'layouts/no_content' %>
  <% end %>
<% end %>
