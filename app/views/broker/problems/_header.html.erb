<div class="page-header p-4 mb-4">
  <h1 class="mb-6">Tasks</h1>

  <table class="table table-borderless">
    <thead>
      <tr>
        <th>Yours</th>
        <th>Team</th>
        <th>Suppressive</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td class="display-6">
          <%= link_to @scoped_problems.unresolved.where(assigned_to: current_user).size, yours_broker_problems_path, class: 'problems-yours' %>
        </td>

        <td class="display-6">
          <%= link_to Problem.unresolved.size, team_broker_problems_path, class: 'problems-team' %>
        </td>

        <td class="display-6">
          <%= link_to @scoped_problems.unresolved.suppressive.size, suppressive_broker_problems_path, class: 'problems-suppressive' %>
        </td>
      </tr>
    </tbody>
  </table>

  <%= render 'menu' %>
</div>
