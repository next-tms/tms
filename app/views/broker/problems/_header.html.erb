<div class="page-header bg-light p-4 mb-4">
  <h1 class="mb-6">Tasks</h1>

  <table class="table table-borderless">
    <thead>
      <tr>
        <th>Open</th>
        <th>Suppressive</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td class="display-6">
          <%= link_to @scoped_problems.unresolved.size, unresolved_broker_problems_path, class: 'problems-unresolved' %>
        </td>

        <td class="display-6">
          <%= link_to @scoped_problems.suppressive.size, suppressive_broker_problems_path, class: 'problems-suppressive' %>
        </td>
      </tr>
    </tbody>
  </table>

  <%= render 'menu' %>
</div>
