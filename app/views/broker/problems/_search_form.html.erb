<div class="row">
  <% if @pagy %>
    <div class="col">
      <%= render 'layouts/pagy', pagy: @pagy %>
    </div>
  <% end %>

  <% if q %>
    <div class="col-auto float-right">
      <%= search_form_for(q, url: request.path, method: :get, local: true, class: 'form-inline mb-3') do |f| %>
        <%= f.hidden_field :s, value: params[:q].try(:[], :s) %>

        <% problematic_rule_codes = if current_user.has_role?('root')
                                      Problem.distinct.pluck(:problematic_rule_code)
                                    else
                                      current_user.problems.distinct.pluck(:problematic_rule_code)
                                    end
        %>
        <%= f.select :problematic_rule_code_eq,
                     problematic_rule_codes.sort.collect { |c| [c.humanize.downcase, c] },
                     { include_blank: 'Issue' },
                     class: 'form-control form-select mr-2'
        %>

        <%= f.submit 'Filter', class: 'btn btn-primary' %>
      <% end %>
    </div>
  <% end %>
</div>
