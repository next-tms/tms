<div class="row">
  <% if @pagy %>
    <div class="col">
      <%= render 'layouts/pagy', pagy: @pagy %>
    </div>
  <% end %>

  <% if q %>
    <div class="col-auto float-right">
      <%= search_form_for(q, url: request.path, method: :get, local: true, class: 'form-inline mb-3') do |f| %>
        <%= f.hidden_field :sorts, value: q.sorts %>

        <% if current_user.roles.size > 1 %>
          <% role_ids = if current_user.has_role?('root')
                          (Role.all.ids & ProblemType.where(id: Problem.where(assigned_to: current_user.broker.users.broker).pluck(:problem_type_id)).pluck(:role_id))
                        else
                          (current_user.roles.ids & ProblemType.where(id: Problem.where(assigned_to: current_user.broker.users.broker).pluck(:problem_type_id)).pluck(:role_id))
                        end
          %>

          <%= f.select :problem_type_role_id_eq,
                       Role.where(id: role_ids).order(:name).collect { |t| [t.name, t.id] },
                       { include_blank: 'Kind' },
                       class: 'form-control form-select mr-2'
          %>
        <% end %>

        <%= f.select :problem_type_id_eq,
                     ProblemType.where(role_id: role_ids).order(:name).collect { |t| [t.name, t.id] },
                     { include_blank: 'Issue' },
                     class: 'form-control form-select mr-2'
        %>

        <%= f.submit 'Filter', class: 'btn btn-primary' %>
      <% end %>
    </div>
  <% end %>
</div>
