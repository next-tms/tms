<div class="row">
  <% if @pagy %>
    <div class="col">
      <%= render 'layouts/pagy', pagy: @pagy %>
    </div>
  <% end %>

  <% if q %>
    <div class="col-auto float-right">
      <%= search_form_for(q, url: request.path, method: :get, local: true, class: 'form-inline mb-3') do |f| %>
        <%= f.hidden_field :sorts, value: q.sorts %>
        <%= f.text_field :shipment_load_id_cont, placeholder: 'Filter', class: 'form-control mr-2' %>
        <%= f.select :problem_type_id_eq, ProblemType.order(:name).collect { |t| [t.name, t.id] }, { include_blank: 'Issue' }, class: 'form-control form-select mr-2' %>
        <%= f.submit 'Filter', class: 'btn btn-primary' %>
      <% end %>
    </div>
  <% end %>
</div>
