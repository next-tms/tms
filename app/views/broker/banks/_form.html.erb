<div class="row">
  <div class="col col-md-8">
    <%= bootstrap_form_with(model: [:broker, @bank], local: true, layout: :horizontal) do |f| %>
      <%= f.alert_message 'Unable to save account:' %>

      <%= f.text_field :name, autofocus: 'autofocus' %>
      <%= f.select :kind,
                   Bank.kinds.collect { |kind| [kind.first.titleize, kind.second] },
                   { include_blank: false },
                   class: 'form-select'
      %>
      <%= f.text_field :account_number %>

      <div class="form-group">
        <%= f.submit class: 'btn btn-primary mt-4', data: { turbo: false }, value: 'Save' %>
      </div>
    <% end %>
  </div>
</div>
