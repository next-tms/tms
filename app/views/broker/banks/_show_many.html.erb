<% unless banks.blank? %>
  <div class="table-responsive">
    <table class="table table-condensed table-borderless table-striped table-hover h-100">
      <thead>
        <tr>
          <th>Bank</th>
          <th>Type</th>
          <th>Account</th>
        </tr>
      </thead>
      <tbody>
        <% banks.each do |bank| %>
          <tr data-link="<%= broker_bank_path(bank) %>" class="data-link">
            <td><%= bank.name %></td>
            <td><%= bank.account_number %></td>
            <td><%= bank.type.name %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <%= render 'shared/no_content' %>
<% end %>