<div class="page-header p-4 mb-4">
  <h1 class="mb-6"><%= @bank.name || 'Bank' %></h1>

  <% unless @bank.new_record? %>
    <table class="table table-borderless w-auto">
      <thead>
        <tr>
          <th>Type</th>
          <th>Account</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td class="lead"><%= @bank.kind.titleize %></td>
          <td class="lead"><%= @bank.account_number %></td>
        </tr>
      </tbody>
    </table>
  <% end %>

  <% unless @bank.new_record? %>
    <%= render 'member_menu' %>
  <% end %>
</div>
