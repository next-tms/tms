<% provide :title, 'Accounts Overview' %>
<% provide :menu, render('menu') %>

<div class="page-header">
  <h1>Accounts</h1>
  <p class="lead">Overview</p>
</div>

<% unless @banks.blank? %>
  <%= render 'show_many', banks: @banks %>
  <%= render 'layouts/pagy', pagy: @pagy %>
<% else %>
  <%= render 'layouts/no_content' %>
<% end %>