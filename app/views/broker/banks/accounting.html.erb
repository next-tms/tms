<% provide :title, 'Accounting' %>

<%= render 'header' %>
<h2><%= yield :title %></h2>

<p class="col-title">Account Mapping</p>

<div class="row">
  <div class="col-auto">
    <%= bootstrap_form_with scope: :accounting, url: accounting_broker_banks_path, method: :patch do |f| %>
      <div class="table-responsive">
        <table class="table table-striped">
          <thead>
            <th>Bank</th>
            <th>Kind</th>
            <th>Account</th>
            <th>Accounting Account</th>
          </thead>

          <tbody>
            <% @banks.each do |bank| %>
              <%= f.fields_for 'banks[]', bank do |bank_form| %>
              <tr>
                <td><%= bank_form.object.name %></td>
                <td><%= bank_form.object.kind.titleize %></td>
                <td><%= bank_form.object.account_number %></td>

                <td>
                  <%= bank_form.select :accounting_account_id,
                                       @accounts.collect { |account| [ account.name, account.id ] },
                                       {
                                         hide_label: true,
                                         include_blank: 'None — Automatically Create When Needed',
                                         class: 'form-select'
                                       } %>
                </td>
              </tr>
              <% end %>
            <% end %>
          </tbody>
        </table>
      </div>

      <%= f.form_group do %>
        <%= f.submit class: 'btn btn-primary', data: { turbo: false }, value: 'Save' %>
      <% end %>
    <% end %>
  </div>
</div>
