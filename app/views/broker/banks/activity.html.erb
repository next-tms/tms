<% provide :title, "#{@bank.pretty_name} Activity" %>
<% provide :menu, render('menu') %>

<div class="page-header">
  <h1><%= @bank.pretty_name %></h1>
  <p class="lead">Activity</p>
</div>

<div class="btn-toolbar">
  <div class="btn-group">
    <%= link_to icon('fas', 'file-export', 'Export'), activity_broker_bank_path(@bank, format: 'csv'), class: 'btn btn-light' %>
  </div>
</div>

<%= render 'broker/payments/show_many', payments: @payments %>