<% provide :title, 'QuickBooks' %>

<%= render 'header' %>
<h2><%= yield :title %></h2>

<p class="col-title">Account Mapping</p>

<div class="row">
  <div class="col-auto">
    <%= bootstrap_form_with model: current_user.broker,
                            url: quickbooks_broker_banks_path,
                            method: :patch do |f| %>
      <%= f.alert_message "Unable to update mappings:" %>

      <div class="table-responsive">
        <table class="table table-striped">
          <thead>
            <th>Bank</th>
            <th>Kind</th>
            <th>Account</th>
            <th>QuickBooks Account</th>
          </thead>

          <tbody>
            <%= f.fields_for :banks, @banks do |bank_form| %>
              <tr>
                <td><%= bank_form.object.name %></td>
                <td><%= bank_form.object.kind.titleize %></td>
                <td><%= bank_form.object.account_number %></td>

                <td>
                  <%= bank_form.hidden_field :id %>
                  <%= bank_form.select :quickbooks_account_id,
                                       @accounts.collect { |account| [ account.name, account.id ] },
                                       {
                                         hide_label: true,
                                         include_blank: 'None — Automatically Create When Needed',
                                         class: 'form-select'
                                       } %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <%= f.form_group do %>
        <%= f.submit class: 'btn btn-primary', data: { turbo: false }, value: 'Save' %>
      <% end %>
    <% end %>
  </div>
</div>
