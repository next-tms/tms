<% provide :title, 'Accounting' %>

<div class="page-header">
  <h1>Settings</h1>
  <p class="lead"><%= yield :title %></p>
</div>

<% if Accounting.connected? %>
  <div class="alert alert-info">
    <p>Connected to <%= Accounting.integration.kind.titleize %></p>
  </div>
<% else %>
  <div class="alert alert-warning">
    <p>No accounting integration is connected</p>
  </div>

  <% AccountingConnectionsController::PROVIDERS.each_key do |kind| %>
    <%= link_to "Connect #{kind.titleize}", send("connect_#{kind}_accounting_path"), class: 'btn btn-primary', data: { turbo: false } %>
  <% end %>
<% end %>
