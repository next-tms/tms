<% provide :title, 'Paid Payments' %>
<% provide :menu, render('menu') %>

<div class="page-header">
  <h1>Payments</h1>
  <p class="lead"><%= yield :title %></p>
</div>

<% unless @payments.blank? %>
  <%= render 'show_many', payments: @payments, q: @q %>
  <%= render 'layouts/pagy', pagy: @pagy %>
<% else %>
  <%= render 'layouts/no_content' %>
<% end %>
