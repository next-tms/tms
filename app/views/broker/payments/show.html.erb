<% provide :title, "Payable #{@payment.id}" %>

<%= render 'member_header' %>
<h2>Overview</h2>

<% unless @payment.payment_transactions.blank? %>
  <div class="table-responsive">
    <table class="table table-condensed table-borderless table-striped table-hover h-100">
      <thead>
        <tr>
          <th>Due</th>
          <th>Load</th>
          <th>Pro</th>
          <th>Invoice</th>
          <th>Balance</th>
          <th>Shipment Cost</th>
          <th>Variance</th>
          <th>Pay</th>
          <th>Remarks</th>
        </tr>
      </thead>
      <tbody>
        <% @payment.payment_transactions.each do |payment_transaction| %>
          <% problem = payment_transaction.variance.zero? &&
                       payment_transaction.duplicates.blank? &&
                       !payment_transaction.shipment&.canceled_at.present?
          %>

          <tr class="<%= 'table-warning' unless problem %>">
            <td><%= short_date payment_transaction.due_on, current_user.time_zone %></td>

            <td>
              <% if payment_transaction.shipment.present? %>
                <%= link_to payment_transaction.shipment.load_id, broker_shipment_path(payment_transaction.shipment), target: '_blank' %>
              <% end %>
            </td>

            <td class="text-nowrap">
              <%= payment_transaction.pro %>

              <% if payment_transaction.duplicates.any? %>
                <br>
                <% text = "#{payment_transaction.duplicates.size} #{'duplicate'.pluralize(payment_transaction.duplicates.size)}" %>
                <%= link_to icon('solid', 'exclamation-circle', text),
                            broker_search_path(q: payment_transaction.shipment.load_id),
                            target: '_top'
                %>
              <% end%>
            </td>

            <td class="text-nowrap">
              <%= payment_transaction.invoice %>
            </td>

            <td>
              <%= humanized_money_with_symbol payment_transaction.balance, no_cents_if_whole: false %>
            </td>

            <td>
              <% unless payment_transaction.shipment.blank? %>
                <%= humanized_money_with_symbol payment_transaction.shipment.carrier_cost, no_cents_if_whole: false %>
              <% end %>
            </td>

            <td>
              <% unless payment_transaction.shipment.blank? %>
                <%= humanized_money_with_symbol payment_transaction.variance, no_cents_if_whole: false %>
              <% end %>
            </td>

            <td><%= humanized_money_with_symbol payment_transaction.paid, no_cents_if_whole: false %></td>

            <td>
              <% if payment_transaction.shipment.present? && payment_transaction.shipment.canceled_at.present? %>
                <strong>Shipment marked canceled and currently not included in profitability report</strong>

                <% unless payment_transaction.notes.blank? %>
                  <br>
                <% end %>
              <% end %>

              <%= payment_transaction.notes %>
            </td>
          </tr>
        <% end %>
      </tbody>
      <tfoot>
        <tr>
          <th></th>
          <th></th>
          <th></th>
          <th></th>
          <th><%= humanized_money_with_symbol @payment.balance, no_cents_if_whole: false %></th>
          <th><%= humanized_money_with_symbol @payment.shipment_carrier_costs, no_cents_if_whole: false %></th>
          <th><%= humanized_money_with_symbol @payment.variance, no_cents_if_whole: false %></th>
          <th><%= humanized_money_with_symbol @payment.paid, no_cents_if_whole: false %></th>
          <th></th>
        </tr>
      </tfoot>
    </table>
  </div>
<% else %>
  <%= render 'layouts/no_content' %>
<% end %>