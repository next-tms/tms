<% unless q.blank? %>
  <div class="row">
    <div class="col">
      <%= render 'layouts/pagy', pagy: @pagy %>
    </div>

    <div class="col-auto float-right">
      <%= search_form_for(q, url: request.path, method: :get, local: true, class: 'form-inline mb-3') do |f| %>
        <%= f.hidden_field :sorts, value: q.sorts %>
        <%= f.text_field :approved_by_first_name_or_approved_by_last_name_or_bank_name_or_broker_carrier_carrier_name_or_broker_carrier_carrier_scac_cont, placeholder: 'Filter', class: 'form-control mr-2' %>
        <%= f.submit 'Filter', class: 'btn btn-primary' %>
      <% end %>
    </div>
  </div>
<% end %>
