<% provide :title, "Payment #{@payment.id}" %>

<%= render 'member_header' %>
<h2>Pay</h2>

<div class="row" data-controller="payments">
  <span id="bankData" data-bank-payment-method-ids="<%= @bank_payment_method_ids %>">
  <div class="col">
    <%= bootstrap_form_with(model: [:broker, @payment], local: true, layout: :horizontal, label_col: 'col-sm-2', control_col: 'col-sm-10') do |f| %>
      <%= f.alert_message 'Unable to update payment:' %>
      <%= f.select :bank_id,
                   @banks.collect { |bank| [bank.pretty_name, bank.id] },
                   { include_blank: false, label: 'Account', data: { action: "change->payments#updatePaymentMethod" } },
                   data: { action: "change->payments#updatePaymentMethod" },
                   class: 'form-select' %>
      <%= f.select :payment_method_id,
                   PaymentMethod.all.order(:name).collect { |payment_method| [payment_method.name, payment_method.id] },
                   { include_blank: false, label: 'Method', selected: @selected_payment_method.id },
                   class: 'form-select' %>
      <%= f.text_field :method_reference, label: 'Reference' %>
      <%= f.text_field :paid_on,
                       label: 'Paid On',
                       autocomplete: 'off',
                       data: flatpickr_data,
                       value: DateTime.current.in_time_zone(current_user.broker.time_zone).to_date
      %>
      <div class="form-group">
        <%= f.submit class: 'btn btn-primary mt-4', value: 'Pay' %>
      </div>
    <% end %>
  </div>
  <div class="col">
    <% unless @payment.broker_carrier.accounting_notes.blank? %>
      <p class="col-title">Accounting Notes</p>
      <%= simple_format @payment.broker_carrier.accounting_notes %>
    <% end %>
    <p class="col-title">Check Mailing Details</p>
    <div class="row">
      <% unless @payment.broker_carrier.check_mailing_address.blank? %>
        <% unless @payment.broker_carrier.account.blank? %>
          <div class="col-3">Account #:</div>
          <div class="col-9"><%= @payment.broker_carrier.account %></div>
        <% end %>
        <% unless @payment.broker_carrier.check_mailing_address.blank? %>
          <div class="col-3">Address</div>
          <div class="col-9">
            <address><%= @payment.broker_carrier.check_mailing_address.pretty('<br>').html_safe %></address>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</div>