<nav class="nav border-top pt-4 mb-0">
  <%= link_to 'Overview', broker_payment_path(@payment), class: 'nav-link payments-show' %>

  <% unless @payment.paid? %>
    <%= link_to 'Edit', edit_broker_payment_path(@payment), class: 'nav-link payments-edit' %>
  <% end %>

  <% if current_user.role?(:accounts_payable) %>
    <% unless @payment.approved_at.blank? %>
      <%= link_to icon('solid', 'thumbs-up', 'Approve'),
                  broker_payment_path(@payment, payment: { approved_by_id: current_user.id }),
                  data: { turbo_method: :patch },
                  class: 'nav-link'
      %>
    <% end %>

    <% if @payment.paid? %>
      <%= link_to icon('solid', 'undo-alt', 'Undo Payment'),
                  broker_payment_path(@payment, payment: { paid_on: nil }),
                  data: { turbo: { confirm: 'Are you sure you want to undo this payment?' }, turbo_method: :patch },
                  class: 'nav-link'
      %>
    <% else %>
      <%= link_to 'Pay', pay_broker_payment_path(@payment), class: 'nav-link payments-pay' %>
    <% end %>
  <% end %>
</nav>
