<% provide :title, 'Import Legacy Remittance' %>
<% provide :menu, render('broker/payments/menu') %>

<div class="page-header">
  <h1>Invoices</h1>
  <p class="lead"><%= yield :title %></p>
</div>

<%= bootstrap_form_with(model: [:broker, @payment], local: true, layout: :horizontal, label_col: 'col-sm-3', control_col: 'col-sm-8') do |f| %>
  <%= f.alert_message 'Unable to import remittance:' %>
  <%= f.select :broker_carrier_id, BrokerCarrier.all.sort_by { |broker_carrier| broker_carrier.carrier.name }.collect { |broker_carrier| [ broker_carrier.broker_customer_specific_name, broker_carrier.id ] }, { label: 'Carrier', selected: (@payment.broker_carrier ? @payment.broker_carrier.id : (params[:broker_carrier_id] ? params[:broker_carrier_id] : nil)) }, class: 'form-select col-sm-6 col-md-4 mt-2 mb-4' %>
  <%= f.text_field :paid_on, label: 'Paid On', autocomplete: 'off', data: flatpickr_data, value: maybe_in_time_zone(datetime: @payment.paid_on, time_zone: current_user.time_zone) %>
  <%= f.text_field :method_reference, label: 'Method Reference' %>
  <%= f.text_area :legacy_csv, label: 'CSV', placeholder: 'legacy load, pro, paid, notes', value: (params[:legacy_csv].blank? ? '' : params[:legacy_csv]), rows: 5, class: 'col-sm-6' %>
  <div class="form-group">
    <%= f.submit class: 'btn btn-primary mt-4', value: 'Import' %>
  </div>
<% end %>