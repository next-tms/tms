<%= turbo_frame_tag :payments do %>
  <%= render 'broker/payments/search_form' %>

  <% unless payments.blank? %>
    <div class="table-responsive">
      <table class="table table-condensed table-borderless table-striped table-hover h-100">
        <thead>
          <tr>
            <th><%= sort_link @q, :broker_carrier_carrier_name, 'Carrier' %></th>
            <th><%= sort_link(@q, :due_on, 'Due') %></th>
            <th><%= sort_link(@q, :paid_on, 'Paid') %></th>
            <th><%= sort_link(@q, :bank_name, 'Bank') %></th>
            <th><%= sort_link @q, :balance_cents, 'Balance' %></th>
            <th><%= sort_link @q, :paid_cents, 'Pay' %></th>
          </tr>
        </thead>
        <tbody>
          <% payments.each do |payment| %>
            <tr>
              <td>
                <% unless payment.broker_carrier.blank? %>
                  <%= payment.broker_carrier.broker_customer_specific_name %>
                <% end %>
              </td>
              <td>
                <% unless payment.due_on.blank? %>
                  <%= link_to short_date(payment.due_on, current_user.time_zone), broker_payment_path(payment), target: '_top' %>
                <% end %>
              </td>
              <td>
                <% unless payment.paid_on.blank? %>
                  <%= link_to short_date(payment.paid_on, current_user.time_zone), broker_payment_path(payment), target: '_top' %>
                <% end %>
              </td>
              <td><%== payment.bank&.pretty_name %></td>
              <td><%= humanized_money_with_symbol payment.balance, no_cents_if_whole: false %></td>
              <td><%= humanized_money_with_symbol payment.paid, no_cents_if_whole: false %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%= render 'layouts/pagy', pagy: @pagy %>
  <% else %>
    <%= render 'layouts/no_content' %>
  <% end %>
<% end %>
