<% unless payments.blank? %>
  <% current_week = Date.current.strftime('%U').to_i %>
  <p><strong>Current Week: <%= current_week %></strong></p>
  <div class="table-responsive">
    <table class="table table-condensed table-borderless table-striped table-hover h-100">
      <thead>
        <tr>
          <th>Due</th>
          <% unless action_name == 'index' %>
            <th>Payment</th>
          <% end %>
          <th>Carrier</th>
          <th>Balance</th>
          <th>Pay</th>
        </tr>
      </thead>
      <tbody>
        <% payments.each do |payment| %>
          <tr class="<% if !payment.week.blank? && (payment.week < current_week) && payment.paid_on.blank? %>bg-warning<% end %>">
            <td>
              <%= link_to broker_payment_path(payment) do %>
                <% unless payment.due_on.blank? %>
                  <%= payment.due_on.year.to_s.length == 2 ? "20#{payment.due_on.year}" : payment.due_on.year %>
                <% end %>
                <%= payment.week.blank? ? 'Unknown' : payment.week %>
              <% end %>
            </td>
            <% unless action_name == 'index' %>
              <td>
                <%= short_date payment.paid_on, current_user.time_zone %>
                <% unless payment.bank.blank? %>
                  <%= payment.bank.pretty_name %>
                <% end %>
              </td>
            <% end %>
            <td>
              <% unless payment.broker_carrier.blank? %>
                <%= payment.broker_carrier.broker_customer_specific_name %>
              <% end %>
            </td>
            <td><%= humanized_money_with_symbol payment.balance, no_cents_if_whole: false %></td>
            <td><%= humanized_money_with_symbol payment.paid, no_cents_if_whole: false %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="section">
    <p><em>Nothing to show</em></p>
  </div>
<% end %>