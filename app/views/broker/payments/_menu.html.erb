<div class="navbar navbar-menu navbar-expand">
  <div class="container-fluid">
    <ul class="navbar-nav">
      <% if not action_name == 'index' %>
        <li class="navbar-item"><%= link_to icon('fas', 'level-up-alt', 'Payments'), broker_payments_path, class: 'nav-link' %></li>
      <% end %>
      <% if @payment and @payment.id %>
        <li class="navbar-item"><%= link_to icon('fas', 'asterisk', 'Overview'), broker_payment_path(@payment), class: 'nav-link' %></li>
        <li class="navbar-item"><%= link_to icon('fas', 'pencil-alt', 'Edit'), edit_broker_payment_path(@payment), class: 'nav-link' %></li>
        <% if current_user.has_role? 'controller' %>
          <% unless @payment.approved_at.blank? %>
            <li class="navbar-item"><%= link_to icon('fas', 'thumbs-up', 'Approve'), broker_payment_path(@payment, payment: { approved_by_id: current_user.id }), method: :patch, class: 'nav-link' %></li>
          <% end %>
        <% end %>
        <% if current_user.has_role? 'controller' or current_user.has_role? 'accounts_payable' %>
          <% if @payment.paid_on.blank? %>
            <li class="navbar-item"><%= link_to icon('fas', 'credit-card', 'Pay'), pay_broker_payment_path(@payment), class: 'nav-link' %></li>
          <% else %>
            <li class="navbar-item"><%= link_to icon('fas', 'undo-alt', 'Undo Payment'), broker_payment_path(@payment, payment: { paid_on: nil }), method: :patch, data: { confirm: 'Are you sure you want to undo this payment?' }, class: 'nav-link' %></li>
          <% end %>
          <li class="navbar-item"><%= link_to icon('fas', 'bomb', 'Delete'), broker_payment_path(@payment), method: :delete, data: { confirm: 'Are you sure you want to permanently delete this payment?' }, class: 'nav-link' %></li>
        <% end %>
      <% else %>
        <% if current_page? action: 'new' %>
          <li class="navbar-item"><%= link_to icon('fas', 'bomb', 'Reset'), new_broker_payment_path, data: { confirm: 'Reset the form? Unsaved changes will be lost.' }, class: 'nav-link' %></li>
        <% else %>
          <li class="navbar-item"><%= link_to icon('fas', 'check', 'Paid'), broker_ap_payments_paid_path, class: 'nav-link' %></li>
          <li class="navbar-item"><%= link_to icon('fas', 'file-import', 'Import Statement'), broker_ap_invoices_import_path, class: 'nav-link' %></li>
          <li class="navbar-item"><%= link_to icon('fas', 'file-import', 'Import Legacy Remittance'), broker_ap_payments_import_legacy_path, class: 'nav-link' %></li>
        <% end %>
      <% end %>
    </ul>
  </div>
</div>