<% provide :title, 'Payables' %>
<% provide :menu, render('menu') %>

<div class="page-header">
  <h1><%= yield :title %></h1>
</div>

<% unless @payments.blank? %>
  <%= render 'show_many', payments: @payments %>
  <%= render 'layouts/pagy', pagy: @pagy %>
<% else %>
  <%= render 'layouts/no_content' %>
<% end %>