<% unless q.blank? %>
  <div class="row">
    <div class="col">
      <%= render 'layouts/pagy', pagy: @pagy %>
    </div>
    <div class="col-auto float-right">
      <%= search_form_for(q, url: request.path, class: 'form-inline mb-3') do |f| %>
        <%= f.hidden_field :sorts, value: q.sorts %>
        <%= f.text_field :authorized_by_first_name_or_authorized_by_last_name_or_shipment_broker_customer_customer_name_or_shipment_load_id_cont, placeholder: 'Filter', class: 'form-control mr-2' %>
        <%= f.submit 'Filter', class: 'btn btn-primary' %>
      <% end %>
    </div>
  </div>
<% end %>
