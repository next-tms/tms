<%= turbo_frame_tag :receivables do %>
  <div class="btn-toolbar">
    <div class="btn-group">
      <% if @display_paid %>
        <%= link_to 'Pending', url_for({ 'q' => { 'paid_at_null' => '1' } }), class: 'btn btn-light' %>
        <%= link_to 'Paid', url_for({ 'q' => { 'paid_at_null' => '0' } }), class: 'btn btn-dark' %>
      <% else %>
        <%= link_to 'Pending', url_for({ 'q' => { 'paid_at_null' => '1' } }), class: 'btn btn-dark' %>
        <%= link_to 'Paid', url_for({ 'q' => { 'paid_at_null' => '0' } }), class: 'btn btn-light' %>
      <% end %>
    </div>
  </div>

  <%= render 'layouts/pagy', pagy: @pagy %>
  <% unless receivables.blank? %>
    <div class="table-responsive">
      <table class="table table-condensed table-borderless table-striped table-hover h-100">
        <thead>
          <tr>
            <th><%= sort_link @q, :shipment_load_id, '#' %></th>
            <% unless @display_paid %>
              <th><%= sort_link @q, :due_by, 'Due' %></th>
            <% else %>
              <th><%= sort_link @q, :paid_at, 'Paid' %></th>
            <% end %>
            <th><%= sort_link @q, :broker_customer_customer_name, 'Customer' %></th>
            <th>Invoiced?</th>
            <th><%= sort_link @q, :total_cents, 'Total' %></th>
          </tr>
        </thead>
        <tbody>
          <% receivables.each do |receivable| %>
          <tr class="<%= receivable.total != receivable.shipment.total_charges ? 'table-danger' : '' %>">
              <td>
                <%= link_to receivable.shipment.load_id, broker_receivable_path(receivable), target: '_top' %>
              </td>
              <% unless @display_paid %>
                <td><%= short_date receivable.due_by, current_user.time_zone %></td>
              <% else %>
                <td><%= short_date receivable.paid_at, current_user.time_zone %></td>
              <% end %>
              <td><%= receivable.broker_customer.customer.name %></td>
              <td><% if receivable.invoiced? %>✓<% end %></td>
              <td>
                <%= humanized_money_with_symbol receivable.total, no_cents_if_whole: false %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= render 'layouts/pagy', pagy: @pagy %>
  <% else %>
    <%= render 'layouts/no_content' %>
  <% end %>
<% end %>
