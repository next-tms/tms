<%= turbo_frame_tag :receivables do %>
  <% unless receivables.blank? %>
    <%= render 'broker/receivables/search_form', q: q %>

    <div class="table-responsive">
      <table class="table table-condensed table-borderless table-striped table-hover h-100">
        <thead>
          <tr>
            <th><%= sort_link q, :shipment_load_id, '#' %></th>
            <% unless controller.controller_name == 'broker_customers' %>
              <th><%= sort_link q, :broker_customer_customer_name, 'Customer' %></th>
            <% end %>
            <th class="text-nowrap"><%= sort_link q, :shipment_picked_up_at, 'Picked Up' %></th>
            <th><%= sort_link q, :shipment_delivered_at, 'Delivered' %></th>
            <th class="text-nowrap"><%= sort_link q, :authorized_by_first_name, 'Approved By' %></th>
            <th><%= sort_link q, :invoiced_eq_true, 'Invoiced?' %></th>
            <th><%= sort_link q, :sent_at, 'Sent' %></th>
            <th><%= sort_link q, :due_by, 'Due' %></th>
            <th class="text-nowrap"><%= sort_link q, :paid_at, 'Paid On' %></th>
            <th><%= sort_link q, :balance_cents, 'Balance' %></th>
            <th><%= sort_link q, :total_cents, 'Total' %></th>
          </tr>
        </thead>
        <tbody>
          <% receivables.each do |receivable| %>
          <tr class="
            <%= receivable.total != receivable.shipment.total_charges ? 'table-danger' : '' %>
            <%= (receivable.missing_carrier_bol? || receivable.missing_carrier_pod?) ? ' table-warning' : '' %>
          ">
              <td>
                <%= link_to receivable.shipment.load_id, broker_receivable_path(receivable), target: '_top' %>
              </td>
              <% unless controller.controller_name == 'broker_customers' %>
                <td>
                  <%= link_to receivable.broker_customer.customer.name, broker_broker_customer_path(receivable.broker_customer), target: '_new' %>
                </td>
              <% end %>
              <td><%= short_date receivable.shipment.picked_up_at, current_user.time_zone %></td>
              <td><%= short_date receivable.shipment.delivered_at, current_user.time_zone %></td>
              <td class="text-nowrap"><%= receivable.authorized_by&.full_name %></td>
              <td><% if receivable.invoiced? %>✓<% end %></td>
              <td><%= short_date receivable.sent_at, current_user.time_zone %></td>
              <td><%= short_date receivable.due_by, current_user.time_zone %></td>
              <td><%= short_date receivable.paid_at, current_user.time_zone %></td>
              <td>
                <%= humanized_money_with_symbol receivable.balance, no_cents_if_whole: false %>
              </td>
              <td>
                <%= humanized_money_with_symbol receivable.total, no_cents_if_whole: false %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%= render 'layouts/pagy', pagy: @pagy %>
  <% else %>
    <%= render 'layouts/no_content' %>
  <% end %>
<% end %>
