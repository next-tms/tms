<div class="page-header bg-light p-4 mb-4">
  <h1 class="mb-6">Invoice <%= @receivable.shipment.load_id %></h1>

  <% if !@receivable.new_record? %>
    <table class="table table-borderless w-auto">
      <thead>
        <tr>
          <th>Customer</th>
          <th>Load</th>
          <th>Due</th>
          <th>Paid</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td class="lead">
            <%= link_to @receivable.broker_customer.customer.name, broker_broker_customer_path(@receivable.broker_customer), target: '_blank' %>
          </td>

          <td class="lead">
            <%= link_to @receivable.shipment.load_id, broker_shipment_path(@receivable.shipment), target: '_blank' %>
          </td>

          <td class="lead">
            <%= short_date @receivable.due_by, current_user.time_zone %>
          </td>

          <td class="lead">
            <%= short_date @receivable.paid_at, current_user.time_zone %>
          </td>
        </tr>
      </tbody>
    </table>
  <% end %>

  <% unless @receivable.new_record? %>
    <%= render 'member_menu' %>
  <% end %>
</div>
