<div class="page-header bg-light p-4 mb-4">
  <h1 class="mb-6">Invoice <%= @receivable.shipment.load_id %></h1>

  <% if !@receivable.new_record? %>
    <table class="table table-borderless w-auto">
      <thead>
        <tr>
          <th>Customer</th>

          <th>Load</th>

          <% unless @receivable.shipment.shipper_reference.blank? %>
            <th>Shipper Ref</th>
          <% end %>

          <% unless @receivable.shipment.customer_reference.blank? %>
            <th>Customer Ref</th>
          <% end %>

          <% unless @receivable.shipment.bol.blank? %>
            <th>BOL</th>
          <% end %>

          <% unless real_pro(@receivable.shipment).blank? %>
            <th>Pro</th>
          <% end %>

          <th>Balance</th>
          <th>Total</th>

          <th>Due</th>
          <th>Paid</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td class="lead">
            <%= link_to @receivable.broker_customer.customer.name, broker_broker_customer_path(@receivable.broker_customer), target: '_blank' %>
          </td>

          <td class="lead">
            <%= link_to @receivable.shipment.load_id, broker_shipment_path(@receivable.shipment), target: '_blank' %>
          </td>

          <% unless @receivable.shipment.shipper_reference.blank? %>
            <td class="lead"><%= @receivable.shipment.shipper_reference %></td>
          <% end %>

          <% unless @receivable.shipment.customer_reference.blank? %>
            <td class="lead"><%= @receivable.shipment.customer_reference %></td>
          <% end %>

          <% unless @receivable.shipment.bol.blank? %>
            <td class="lead"><%= @receivable.shipment.bol %></td>
          <% end %>

          <% unless real_pro(@receivable.shipment).blank? %>
            <td class="lead">
              <% if tracking_uri(@receivable.shipment).blank? %>
                <%= real_pro(@receivable.shipment) %>
              <% else %>
                <%= link_to real_pro(@receivable.shipment), tracking_uri(@receivable.shipment), target: '_blank' %>
              <% end %>
            </td>
          <% end %>

          <td class="lead">
            <%= humanized_money_with_symbol @receivable.balance, no_cents_if_whole: true %>
          </td>

          <td class="lead">
            <%= humanized_money_with_symbol @receivable.total, no_cents_if_whole: true %>
          </td>

          <td class="lead">
            <%= short_date @receivable.due_by, current_user.time_zone %>
          </td>

          <td class="lead">
            <%= short_date @receivable.paid_at, current_user.time_zone %>
          </td>
        </tr>
      </tbody>
    </table>
  <% end %>

  <% unless @receivable.new_record? %>
    <%= render 'member_menu' %>
  <% end %>
</div>
