<div class="navbar navbar-menu navbar-expand">
  <div class="container-fluid">
    <ul class="navbar-nav">
      <% if not action_name == 'index' %>
        <li class="navbar-item">
          <%= link_to icon('solid', 'level-up-alt', 'Receivables'), broker_receivables_path, class: 'nav-link' %>
        </li>
      <% end %>
      <% if @receivable and @receivable.id %>
        <li class="navbar-item">
          <%= link_to icon('solid', 'asterisk', 'Overview'), broker_receivable_path(@receivable), class: 'nav-link' %>
        </li>
        <% if current_user.has_role? 'accounts_receivable' %>
          <% if @receivable.authorized_at.blank? %>
            <li class="navbar-item">
              <%= link_to icon('solid', 'thumbs-up', 'Approved'), broker_receivable_path(@receivable, receivable: { authorized_at: DateTime.current }), method: :patch, class: 'nav-link' %>
            </li>
          <% else %>
            <li class="navbar-item">
              <%= link_to icon('solid', 'thumbs-down', 'Not Approved'), broker_receivable_path(@receivable, receivable: { authorized_at: nil }), method: :patch, class: 'nav-link' %>
            </li>
            <% if @receivable.invoiced? %>
              <li class="navbar-item">
                <%= link_to icon('solid', 'thumbs-down', 'Not Invoiced'), broker_receivable_path(@receivable, receivable: { invoiced: false }), method: :patch, class: 'nav-link' %>
              </li>
            <% else %>
              <li class="navbar-item">
                <%= link_to icon('solid', 'thumbs-up', 'Invoiced'), broker_receivable_path(@receivable, receivable: { invoiced: true }), method: :patch, class: 'nav-link' %>
              </li>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    </ul>
  </div>
</div>
