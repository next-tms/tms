<div class="page-header p-4 mb-4">
  <h1 class="mb-6"><%= @broker_customer_sales_rep.full_name || 'Sales Rep' %></h1>

  <% unless @broker_customer_sales_rep.new_record? %>
    <table class="table table-borderless w-auto">
      <thead>
        <tr>
          <th>Customers</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td class="lead">
            <%= @broker_customer_sales_rep.broker_customers.size %>
          </td>
        </tr>
      </tbody>
    </table>
  <% end %>

  <% unless @broker_customer_sales_rep.new_record? %>
    <%= render 'member_menu' %>
  <% end %>
</div>
