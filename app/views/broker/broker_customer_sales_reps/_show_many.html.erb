<% unless broker_customer_sales_reps.blank? %>
  <div class="table-responsive">
    <table class="table table-borderless table-striped table-hover sortable">
      <thead>
        <tr>
          <th>Name</th>
          <th>Customers</th>
          <th>Week</th>
          <th>YTD</th>
        </tr>
      </thead>
      <tbody>
        <% broker_customer_sales_reps.each do |broker_customer_sales_rep| %>
          <tr data-link="<%= broker_broker_customer_sales_rep_path(broker_customer_sales_rep) %>" class="data-link">
            <td>
              <%= broker_customer_sales_rep.first_name %>
              <%= broker_customer_sales_rep.last_name %>
            </td>
            <td><%= BrokerCustomerSalesRep.where(user: broker_customer_sales_rep).size %></td>
            <td>
              <%= number_to_currency broker_customer_sales_rep.sales_rep_earnings((Date.current - 2.months).beginning_of_week, (Date.current - 2.months).end_of_week) %>
            </td>
            <td>
              <%= number_to_currency broker_customer_sales_rep.sales_rep_earnings(Date.current.beginning_of_year, Date.current.end_of_week) %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <%= render 'layouts/no_content' %>
<% end %>