<% unless q.blank? %>
  <div class="row">
    <div class="col">
      <%= render 'layouts/pagy', pagy: @pagy %>
    </div>
    <div class="col-auto float-end">
      <%= search_form_for(q, url: request.path, class: 'form-inline mb-3') do |f| %>
        <%= f.hidden_field :s, value: params[:q].try(:[], :s) %>
        <%= f.text_field :shipment_broker_customer_customer_name_cont, placeholder: 'Filter', class: 'form-control me-2' %>
        <%= f.submit 'Filter', class: 'btn btn-primary' %>
      <% end %>
    </div>
  </div>
<% end %>
