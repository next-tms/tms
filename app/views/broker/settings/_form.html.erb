<div class="row">
  <div class="col col-md-8">
    <%= bootstrap_form_with(model: [:broker, @setting], local: true, layout: :horizontal) do |f| %>
      <%= f.alert_message 'Unable to save:' %>

      <% if f.object.new_record? %>
        <%= f.text_field :key, autofocus: 'autofocus', class: 'font-monospace' %>
      <% end %>

      <% if f.object.address? %>
        <%= render 'address_fields', f: %>
      <% else %>
        <%= f.text_area :value, rows: 25, class: 'font-monospace' %>
      <% end %>

      <div class="form-group">
        <%= f.submit class: 'btn btn-primary mt-4', data: { turbo: false }, value: 'Save' %>
      </div>
    <% end %>
  </div>
</div>
