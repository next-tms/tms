<div class="page-header p-4 mb-4">
  <h1 class="mb-6"><%= @broker_carrier&.carrier&.name || 'Carrier' %></h1>

  <% unless @broker_carrier.new_record? %>
    <table class="table table-borderless w-auto">
      <thead>
        <tr>
          <th>Customer</th>
          <th>Shipments</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td class="lead">
            <% if @broker_carrier.broker_customer.blank? %>
              All
            <% else %>
              <%= link_to @broker_carrier.broker_customer.customer.name, broker_broker_customer_path(@broker_carrier.broker_customer), target: '_blank' %>
            <% end %>
          </td>

          <td class="lead">
            <%= link_to @broker_carrier.shipments.size, shipments_broker_broker_carrier_path(@broker_carrier), class: 'broker-carriers-shipments' %>
          </td>
        </tr>
      </tbody>
    </table>
  <% end %>

  <% unless @broker_carrier.new_record? %>
    <%= render 'member_menu' %>
  <% end %>
</div>
