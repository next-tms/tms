<% provide :title, 'Accounting' %>

<%= render 'header' %>
<h2><%= yield :title %></h2>

<p class="col-title">Vendor Mapping</p>

<div class="row">
  <div class="col-auto">
    <%= bootstrap_form_with scope: :accounting, url: accounting_broker_broker_carriers_path, method: :patch do |f| %>
      <div class="table-responsive">
        <table class="table table-striped">
          <thead>
            <th>Carrier</th>
            <th>Accounting Vendor</th>
          </thead>

          <tbody>
            <% @broker_carriers.each do |broker_carrier| %>
              <%= f.fields_for 'broker_carriers[]', broker_carrier do |broker_carrier_form| %>
              <tr>
                <td><%= broker_carrier_form.object.carrier.name %></td>

                <td>
                  <%= broker_carrier_form.select :accounting_vendor_id,
                                                 @vendors.collect { |vendor| [ vendor.display_name, vendor.id ] },
                                                 {
                                                   hide_label: true,
                                                   include_blank: 'None — Automatically Create When Needed',
                                                   class: 'form-select'
                                                 } %>
                </td>
              </tr>
              <% end %>
            <% end %>
          </tbody>
        </table>
      </div>

      <%= f.form_group do %>
        <%= f.submit class: 'btn btn-primary', data: { turbo: false }, value: 'Save' %>
      <% end %>
    <% end %>
  </div>
</div>
