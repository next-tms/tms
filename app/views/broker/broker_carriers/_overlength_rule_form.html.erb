<div class="overlength-rules-form-wrapper row gy-2 gx-3 align-items-center mb-4" data-new-record="<%= f.object.new_record? %>">
  <div class="col col-sm-4">
    <div class="input-group">
      <%= f.text_field :min_length, placeholder: 'Min', wrapper: false %>
      <%= f.text_field :max_length, placeholder: 'Max', wrapper: false %>
    </div>
  </div>

  <div class="col col-sm-2">
    <%= f.text_field :cost, prepend: '$', hide_label: true, placeholder: 'Cost', data: money_controller_data, wrapper: false, autocomplete: 'off' %>
  </div>

  <div class="col-auto">
    <%= f.hidden_field :_destroy, wrapper: false %>
    <%= link_to icon('fas', 'trash', 'Remove'), '#', data: { action: 'nested-form#remove' }, class: 'btn btn-light ml-2' %>
  </div>
</div>
