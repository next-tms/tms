<div class="pricing-rules-form-wrapper row gy-2 gx-3 align-items-top mb-4" data-new-record="<%= f.object.new_record? %>">
  <div class="col col-sm-3">
    <%= f.select :from_area_id,
                 areas,
                 {
                   hide_label: true,
                   include_blank: (PricingRule.human_attribute_name(:from_area) if f.object.new_record?),
                   readonly: f.object.persisted?
                 }
    %>
  </div>

  <div class="col col-sm-3">
    <%= f.select :to_area_id,
                 areas,
                 {
                   hide_label: true,
                   include_blank: (PricingRule.human_attribute_name(:to_area) if f.object.new_record?),
                   readonly: f.object.persisted?
                 }
    %>
  </div>

  <div class="col col-sm-3">
    <div class="input-group">
      <%= f.text_field :min_pallets, placeholder: 'Min', wrapper: false %>
      <%= f.text_field :max_pallets, placeholder: 'Max', wrapper: false %>
    </div>
  </div>

  <div class="col col-sm-2">
    <%= f.text_field :cost_per_pallet,
                     prepend: '$',
                     hide_label: true,
                     placeholder: 'Cost per pallet',
                     data: money_controller_data,
                     wrapper: false,
                     autocomplete: 'off'
    %>
  </div>

  <div class="col-auto">
    <%= f.hidden_field :_destroy, wrapper: false %>
    <%= link_to icon('solid', 'trash', 'Remove'), '#', data: { action: 'nested-form#remove' }, class: 'btn btn-light ms-2' %>
  </div>
</div>
