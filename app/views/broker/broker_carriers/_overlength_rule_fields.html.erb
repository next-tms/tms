<div class="nested-fields form-inline form-row mb-2">
  <%= f.hidden_field :_destroy %>
  <%= f.text_field :min_length, hide_label: true, placeholder: 'Min', class: 'mr-1 col-1', wrapper: false %>
  <%= f.text_field :max_length, hide_label: true, placeholder: 'Max', class: 'mr-1 col-1', wrapper: false %>
  <%= f.text_field :cost, prepend: '$', hide_label: true, placeholder: 'Cost', class: 'money', autocomplete: 'off' %>
  <div class="col">
    <%= link_to icon('fas', 'trash'), '#', class: 'remove-fields btn btn-light' %>
  </div>
</div>