<% provide :title, @api_key.name %>

<%= render 'broker/broker_carriers/member_header' %>
<h2><%= yield :title %></h2>

<div class="table-responsive">
  <table class="table table-borderless table-striped">
    <tbody>
      <tr>
        <th><%= APIKey.human_attribute_name(:token_suffix) %></th>
        <td>
          <input class="form-control font-monospace" data-action="click->clipboard#copy" data-controller="clipboard" readonly value="<%= @api_key.token %>">
          <div class="form-text"><%= t('.copy') %></div>
        </td>
      </tr>
      <tr>
        <th><%= APIKey.human_attribute_name(:created_at) %></th>
        <td><%= time(@api_key.created_at) %></td>
      </tr>
      <tr>
        <th><%= APIKey.human_attribute_name(:expires_at) %></th>
        <td><%= time(@api_key.expires_at) || t('.never') %></td>
      </tr>
      <tr>
        <th><%= APIKey.human_attribute_name(:last_used_at) %></th>
        <td><%= time(@api_key.last_used_at) || t('.never') %></td>
      </tr>
    </tbody>
  </table>
</div>

<% if @api_key.active? %>
  <%= link_to t('.roll'),
              [:broker, @broker_carrier, @api_key, :roll],
              class: 'btn btn-secondary',
              data: {
                turbo_confirm: t('.roll_confirm', grace_period: APIKey::ROLL_GRACE_PERIOD.inspect, model_name: APIKey.model_name.human),
                turbo_method: :post
              }
  %>
<% end %>

<%= link_to t('.destroy'),
            [:broker, @broker_carrier, @api_key],
            class: 'btn btn-danger',
            data: { turbo_confirm: t('.destroy_confirm', name: @api_key.name), turbo_method: :delete }
%>
