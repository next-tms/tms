<% provide :title, @broker_carrier.carrier.name %>
<% provide :menu, render('menu') %>

<div class="page-header">
  <h1><%= @broker_carrier.carrier.name %>
  <small>
    <%= @broker_carrier.account %>
    <% unless @broker_carrier.broker_customer.blank? %>
      <%= @broker_carrier.broker_customer.customer.name %>
    <% end %>
  </small>
  </h1>
  <p class="lead">Overview</p>
</div>

<div class="row">
  <div class="col col-md-6">
    <div class="table-responsive">
      <table class="table table-borderless table-striped">
        <tbody>
          <tr>
            <th>Account #</th>
            <td><%= @broker_carrier.account %></td>
          </tr>
          <tr>
            <th>Account Description</th>
            <td><%= @broker_carrier.account_desc %></td>
          </tr>
          <tr>
            <th>Customer-Specific Pricing</th>
            <td>
              <% unless @broker_carrier.broker_customer.blank? %>
                <br>
                <%= link_to @broker_carrier.broker_customer.customer.name, broker_broker_customer_path(@broker_carrier.broker_customer), target: '_blank' %>
              <% else %>
                N/A
              <% end %>
            </td>
          </tr>
          <tr>
            <th>Check Mailing Address</th>
            <td>
              <% unless @broker_carrier.check_mailing_address.blank? %>
                <address><%= @broker_carrier.check_mailing_address.pretty('<br>').html_safe %></address>
              <% end %>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>
