<% provide :title, 'Tariff' %>

<%= render 'member_header' %>
<h2><%= yield :title %></h2>

<% if !@broker_carrier.as_interstellar_carrier.blank? && !@broker_carrier.as_interstellar_carrier.rates_with_excessive_length_fees %>
  <%= bootstrap_form_with(model: [:broker, @broker_carrier], path: [:broker, @broker_carrier]) do |f| %>
    <%= f.alert_message 'Unable to update account:' %>

    <div class="form-group row">
      <label class="col-form-label col-sm-2">Overlength Rules</label>
        <div class="col-sm-10">
        <p>Minimum length and max length are inclusive, leave max length blank to mean “anything longer than minimum length”</p>

        <div data-controller="nested-form" data-nested-form-wrapper-selector-value=".overlength-rules-form-wrapper">
          <template data-nested-form-target="template">
            <%= f.fields_for :overlength_rules, OverlengthRule.new, child_index: 'NEW_RECORD' do |overlength_rules_form| %>
              <%= render 'overlength_rule_form', f: overlength_rules_form %>
            <% end %>
          </template>

          <%= f.fields_for :overlength_rules do |overlength_rules_form| %>
            <%= render 'overlength_rule_form', f: overlength_rules_form %>
          <% end %>

          <div data-nested-form-target="target"></div>

          <%= link_to icon('solid', 'plus', 'Add'), '#', data: { action: 'nested-form#add' }, class: 'btn btn-light' %>
        </div>
      </div>
    </div>

    <%= f.form_group do %>
      <%= f.submit class: 'btn btn-primary', value: 'Save' %>
    <% end %>
  <% end %>
<% elsif !@broker_carrier.carrier.carrier_areas.blank? %>
  <%= bootstrap_form_with(model: [:broker, @broker_carrier], path: [:broker, @broker_carrier]) do |f| %>
    <%= f.alert_message 'Unable to update account:' %>

    <div class="form-group row">
      <label class="col-form-label col-sm-2">Pallet Pricing Rules</label>
        <div class="col-sm-10">
        <p>Minimum and max pallets are inclusive and required</p>
        <%= f.fields_for :pricing_rules do |pricing_rules_form| %>
          <%= render 'pricing_rule_form', f: pricing_rules_form %>
        <% end %>
        </div>
      </div>
    </div>

    <%= f.form_group do %>
      <%= f.submit class: 'btn btn-primary', value: 'Save' %>
    <% end %>
  <% end %>
<% else %>
  <%= render 'layouts/message', title: 'Nothing to configure', message: !@broker_carrier.as_interstellar_carrier.blank? ? 'This carrier’s API handles tariff-specific pricing on its own.' : nil %>
<% end %>