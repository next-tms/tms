<% provide :title, 'Tariff' %>

<%= render 'member_header' %>
<h2><%= yield :title %></h2>

<% freight_kit_carrier = @broker_carrier.to_freight_kit_carrier %>

<% if freight_kit_carrier.present? && freight_kit_carrier.class.implemented?(:find_rates) %>
  <% if freight_kit_carrier.rates_with_excessive_length_fees %>
    <%= render 'layouts/message',
               title: 'Nothing to configure',
               message: 'This carrier’s API handles tariff-specific pricing on its own.'
    %>
  <% else %>
    <%= bootstrap_form_with(model: @broker_carrier, url: tariff_broker_broker_carrier_path(@broker_carrier)) do |f|%>
      <div class="form-group row">
        <label class="col-form-label col-sm-2">Overlength Rules</label>

        <div class="col-sm-10">
          <p>Minimum length and maximum length are inclusive. Leave maximum length blank to mean “anything longer than minimum length”</p>

          <div data-controller="nested-form" data-nested-form-wrapper-selector-value=".overlength-rules-form-wrapper">
            <template data-nested-form-target="template">
              <%= f.fields_for :overlength_rules, OverlengthRule.new, child_index: 'NEW_RECORD' do |overlength_rules_form| %>
                <%= render 'overlength_rule_form', f: overlength_rules_form %>
              <% end %>
            </template>

            <%= f.fields_for :overlength_rules do |overlength_rules_form| %>
              <%= render 'overlength_rule_form', f: overlength_rules_form %>
            <% end %>

            <div data-nested-form-target="target"></div>

            <%= link_to icon('solid', 'plus', 'Add'), '#', data: { action: 'nested-form#add' }, class: 'btn btn-light' %>
          </div>
        </div>
      </div>

      <%= f.form_group do %>
        <%= f.submit class: 'btn btn-primary', value: 'Save' %>
      <% end %>
    <% end %>
  <% end %>
<% else %>
  <%= bootstrap_form_with(model: @broker_carrier, url: tariff_broker_broker_carrier_path(@broker_carrier)) do |f| %>
    <div class="form-group row">
      <label class="col-form-label col-sm-2">Pallet Pricing Rules</label>

      <div class="col-sm-10">
        <p>
          Minimum pallet count and maximum pallet count are inclusive. Leave maximum pallet count blank to mean “anything more than
          minimum pallet count”
        </p>

        <div data-controller="nested-form" data-nested-form-wrapper-selector-value=".pricing-rules-form-wrapper">
          <template data-nested-form-target="template">
            <%= f.fields_for :pricing_rules, PricingRule.new(broker_carrier: f.object), child_index: 'NEW_RECORD' do |pricing_rules_form| %>
              <%= render 'pricing_rule_form', f: pricing_rules_form %>
            <% end %>
          </template>

          <%= f.fields_for :pricing_rules do |pricing_rules_form| %>
            <%= render 'pricing_rule_form', f: pricing_rules_form %>
          <% end %>

          <div data-nested-form-target="target"></div>

          <%= link_to icon('solid', 'plus', 'Add'), '#', data: { action: 'nested-form#add' }, class: 'btn btn-light' %>
        </div>
      </div>
    </div>

    <%= f.form_group do %>
      <%= f.submit class: 'btn btn-primary', value: 'Save' %>
    <% end %>
  <% end %>
<% end %>
