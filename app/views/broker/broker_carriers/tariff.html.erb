<% provide :title, 'Tariff' %>

<%= render 'member_header' %>
<h2><%= yield :title %></h2>

<% if @broker_carrier.api_configured? && @broker_carrier.carrier.find_rates_implemented? %>
  <% if @broker_carrier.carrier.rates_with_excessive_length_fees? %>
    <%= render 'layouts/message',
               title: 'Nothing to configure',
               message: 'This carrier’s API handles tariff-specific pricing on its own.'
    %>
  <% else %>
    <%= bootstrap_form_with(model: @broker_carrier, url: tariff_broker_broker_carrier_path(@broker_carrier)) do |f|%>
      <%= render 'overlength_rules_fields', f: %>

      <%= f.form_group do %>
        <%= f.submit class: 'btn btn-primary', value: 'Save' %>
      <% end %>
    <% end %>
  <% end %>
<% else %>
  <%= bootstrap_form_with(model: @broker_carrier, url: tariff_broker_broker_carrier_path(@broker_carrier)) do |f| %>
    <%= render 'pricing_rules_fields', f: %>
    <%= render 'overlength_rules_fields', f: %>

    <%= f.form_group do %>
      <%= f.submit class: 'btn btn-primary', value: 'Save' %>
    <% end %>
  <% end %>
<% end %>
