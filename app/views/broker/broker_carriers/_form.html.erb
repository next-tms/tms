<%= bootstrap_form_with(model: [:broker, @broker_carrier], path: [:broker, @broker_carrier], layout: :horizontal) do |f| %>
  <%= f.alert_message "Unable to create account:" %>

  <h3>Account</h3>
  <%= f.select :carrier_id, Carrier.all.order(:name).all.order(:name).collect {|c| [ c.name, c.id ] }, { label: 'Carrier', selected: (@broker_carrier.carrier ? @broker_carrier.carrier.id : nil) }, class: 'form-select' %>
  <%= f.select :broker_customer_id, [['None — Blanket Pricing', nil]] + current_user.broker.broker_customers.includes(:customer).sort_by { |broker_customer| broker_customer.customer.name }.collect { |broker_customer| [ broker_customer.customer.name, broker_customer.id ] }, { label: 'Customer', selected: (@broker_carrier.broker_customer ? @broker_carrier.broker_customer.id : (params[:broker_customer_id] ? params[:broker_customer_id] : nil)) }, class: 'form-select' %>
  <%= f.text_field :account, placeholder: 'Account #', autocomplete: 'off' %>
  <%= f.text_field :account_desc, placeholder: 'Description', autocomplete: 'off' %>

  <h3>Billing Details</h3>
  <%= f.text_area :accounting_notes, rows: 7 %>

  <%= f.number_field :days_to_pay_after_invoice_date, label: 'Days Until Due', help: 'Used to generate payment due dates when they are not specified on account statements', min: 0 %>

  <%= f.form_group label: { text: 'Invoicing' } do %>
    <%= f.check_box :create_invoice_on_pickup, label: 'Create invoice automaticaly when shipments pick up' %>
  <% end %>

  <div class="form-group row" data-controller="address">
    <label class="col-form-label col-sm-2">Check Mailing Address</label>
    <div class="col-sm-10">
      <%= f.fields_for :check_mailing_address do |check_mailing_address_form| %>
        <%= check_mailing_address_form.text_field :street, hide_label: true, placeholder: 'Street' %>
        <%= check_mailing_address_form.text_field :street2, hide_label: true %>
        <%= check_mailing_address_form.text_field :city, hide_label: true, placeholder: 'City' %>
        <%= check_mailing_address_form.select :region_id, (check_mailing_address_form.object.region_id.blank? ? [[current_user.broker.address.region.name, current_user.broker.address.region.id]] : [[check_mailing_address_form.object.region.abbreviation, check_mailing_address_form.object.region_id]]), { hide_label: true }, data: { 'address-target': 'regions' }, class: 'form-select' %>
        <%= check_mailing_address_form.text_field :zip_code, hide_label: true, placeholder: 'ZIP' %>
        <%= check_mailing_address_form.select :country_id, Country.order(:name).collect { |c| [c.name, c.id] }, { hide_label: true, selected: (check_mailing_address_form.object.country_id.blank? ? current_user.broker.address.country_id : check_mailing_address_form.object.country_id) }, data: { action: 'address#handle', 'address-target': 'country' }, class: 'form-select' %>
      <% end %>
    </div>
  </div>

  <%= f.text_area :default_bol_notes, label: 'Default BOL Notes', rows: 7 %>

  <% unless f.object.carrier&.as_interstellar_carrier&.blank? %>
    <h3>
      <% if f.object.carrier&.has_seperate_website_credentials? %>
        API & Website Credentials
      <% else %>
        API Credentials
      <% end %>
    </h3>
  
    <%= f.text_field :username, placeholder: 'Username', autocomplete: 'off' %>
    <%= f.text_field :password, placeholder: 'Password', autocomplete: 'off' %>
  
    <% if f.object.carrier&.has_seperate_website_credentials? %>
      <h3>Website Credentials</h3>
      <%= f.text_field :website_username, placeholder: 'Username', autocomplete: 'off' %>
      <%= f.text_field :website_password, placeholder: 'Password', autocomplete: 'off' %>
    <% end %>

    <% if f.object.persisted? && f.object.as_interstellar_carrier&.bol_requires_tracking_number? %>
      <%= f.check_box :ignore_bol_requires_tracking_number,
                      label: 'Generate BOL even if pro is missing?'
        %>
    <% end %>
  <% end %>

  <%= f.form_group do %>
    <%= f.submit class: 'btn btn-primary', data: { turbo: false }, value: 'Save' %>
  <% end %>
<% end %>