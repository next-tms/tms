<%= bootstrap_form_with(model: [:broker, @broker_carrier], path: [:broker, @broker_carrier], layout: :horizontal) do |f| %>
  <%= f.alert_message "Unable to create account:" %>

  <h3>Account</h3>
  <%= f.select :carrier_id, Carrier.all.order(:name).all.order(:name).collect {|c| [ c.name, c.id ] }, { label: 'Carrier', selected: (@broker_carrier.carrier ? @broker_carrier.carrier.id : nil) }, class: 'form-select' %>
  <%= f.select :broker_customer_id, [['None — Blanket Pricing', nil]] + BrokerCustomer.includes(:customer).sort_by { |broker_customer| broker_customer.customer.name }.collect { |broker_customer| [ broker_customer.customer.name, broker_customer.id ] }, { label: 'Customer', selected: (@broker_carrier.broker_customer ? @broker_carrier.broker_customer.id : (params[:broker_customer_id] ? params[:broker_customer_id] : nil)) }, class: 'form-select' %>
  <%= f.text_field :account, placeholder: 'Account #', autocomplete: 'off' %>
  <%= f.text_field :account_desc, placeholder: 'Description', autocomplete: 'off' %>

  <h3>Billing Details</h3>
  <%= f.text_area :accounting_notes, rows: 7 %>

  <%= f.number_field :days_to_pay_after_invoice_date, label: 'Days Until Due', help: 'Used to generate payment due dates when they are not specified on account statements', min: 0 %>

  <%= f.form_group label: { text: 'Invoicing' } do %>
    <%= f.check_box :create_invoice_on_pickup, label: 'Create invoice automaticaly when shipments pick up' %>
  <% end %>

  <div class="form-group row" data-controller="address">
    <label class="col-form-label col-sm-2">Check Mailing Address</label>
    <div class="col-sm-10">
      <%= f.fields_for :check_mailing_address do |check_mailing_address_form| %>
        <%= check_mailing_address_form.text_field :street, hide_label: true, placeholder: 'Street' %>
        <%= check_mailing_address_form.text_field :street2, hide_label: true %>
        <%= check_mailing_address_form.text_field :city, hide_label: true, placeholder: 'City' %>
        <%= check_mailing_address_form.select :region_iso31662, (check_mailing_address_form.object.region_iso31662.blank? ? [[Setting.mailing_address!.region.name, Setting.mailing_address!.region.id]] : [[check_mailing_address_form.object.region.abbreviation, check_mailing_address_form.object.region_iso31662]]), { hide_label: true }, data: { 'address-target': 'regions' }, class: 'form-select' %>
        <%= check_mailing_address_form.text_field :zip_code, hide_label: true, placeholder: 'ZIP' %>
        <%= check_mailing_address_form.select :country_alpha2, country_options(Transponder::ORM::Country.order(:name), check_mailing_address_form.object.country_alpha2), { hide_label: true, selected: (check_mailing_address_form.object.country_alpha2.blank? ? Setting.mailing_address!.country_alpha2 : check_mailing_address_form.object.country_alpha2) }, data: { action: 'address#handle', 'address-target': 'country' }, class: 'form-select' %>
      <% end %>
    </div>
  </div>

  <%= f.text_field :encrypted_ach_bank_name, autocomplete: 'off' %>
  <%= f.text_field :encrypted_ach_routing_number,
                   autocomplete: 'off',
                   inputmode: 'numeric',
                   maxlength: 9,
                   pattern: '\d{9}',
                   title: 'Nine digits'
  %>
  <%= f.text_field :encrypted_ach_account_number,
                   autocomplete: 'off',
                   inputmode: 'numeric',
                   maxlength: 17,
                   pattern: '\d{4,17}',
                   title: '4 to 17 digits'
  %>

  <%= f.text_area :default_bol_notes, label: 'Default BOL Notes', rows: 7 %>

  <% if f.object.carrier&.transponder_carrier.present? %>
    <h3>Website Credentials</h3>

    <% if (f.object.credential_columns & %i[website_username website_password]).any? %>
      <p>The API for <%= f.object.name %> uses these credentials.</p>
    <% end %>

    <%= f.text_field :website_username, label: 'Username', autocomplete: 'off' %>
    <%= f.text_field :website_password, label: 'Password', autocomplete: 'off' %>

    <% if (f.object.credential_columns & %i[encrypted_api_key username password]).any? %>
      <h3>API Credentials</h3>
      <% if f.object.credential_columns.include?(:encrypted_api_key) %>
        <%= f.text_field :encrypted_api_key, autocomplete: 'off' %>
      <% end %>

      <% if f.object.credential_columns.include?(:username) %>
        <%= f.text_field :username, autocomplete: 'off' %>
      <% end %>

      <% if f.object.credential_columns.include?(:password) %>
        <%= f.text_field :password, autocomplete: 'off' %>
      <% end %>
    <% end %>

    <% if f.object.persisted? && f.object.carrier.bol_requires_tracking_number? %>
      <%= f.check_box :ignore_bol_requires_tracking_number, label: 'Generate BOL even if pro is missing?' %>
    <% end %>
  <% end %>

  <%= f.form_group do %>
    <%= f.submit class: 'btn btn-primary', data: { turbo: false }, value: 'Save' %>
  <% end %>
<% end %>