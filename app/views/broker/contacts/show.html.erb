<% provide :title, @contact.full_name %>

<%= render 'member_header' %>
<h2>Overview</h2>

<% if @contact.user.present? %>
  <% if @contact.user.invitation_sent_at.present? %>
    <% if @contact.user.invitation_accepted? %>
      <%= render 'layouts/message',
                 title: 'Invitation accepted',
                 message: "#{@contact.full_name} accepted the invitation.",
                 classes: 'alert-success'
      %>
    <% else %>
      <%= render 'layouts/message',
                 title: 'Invitation sent',
                 message: "#{@contact.full_name} was invited but hasn’t set up their account.",
                 classes: 'alert-warning'
      %>
    <% end %>
  <% end %>
<% end %>

<div class="table-responsive">
  <table class="table table-borderless table-striped">
    <tbody>
      <tr>
        <th>Name</th>
        <td><%= @contact.full_name %></td>
      </tr>
      <tr>
        <th>Title</th>
        <td><%= @contact.job_title %></td>
      </tr>
      <tr>
        <th>Phones</th>
        <td>
          <ul class="list-unstyled">
            <% unless @contact.mobile_phone.blank? %>
              <li><%= link_to @contact.mobile_phone.phony_formatted, "tel:#{@contact.mobile_phone}" %> <span class="badge bg-info">Mobile</span></li>
            <% end %>
            <% unless @contact.work_phone.blank? %>
              <li><%= link_to @contact.work_phone.phony_formatted, "tel:#{@contact.work_phone}" %> <span class="badge bg-info">Office</span></li>
            <% end %>
          </ul>
        </td>
      </tr>
      <tr>
        <th>Email</th>
        <td>
          <% unless @contact.email.blank? %>
            <%= link_to @contact.email, "mailto:#{@contact.email}" %>
          <% end %>
        </td>
      </tr>
    </tbody>
  </table>
</div>
