<% provide :title, @contact.full_name %>
<% provide :menu, render('broker/contacts/menu') %>

<div class="page-header">
  <h1>Contacts</h1>
  <p class="lead"><%= yield :title %></p>
</div>

<div class="row">
  <div class="col col-md-6">
    <div class="btn-toolbar mb-3">
      <div class="btn-group">
        <% if @contact.user.blank? && @contact.broker_customer_id.present? %>
          <%= link_to icon('solid', 'plus', 'Invite Customer'), new_user_invitation_path(broker_customer_id: @contact.broker_customer_id, contact_id: @contact.id), class: 'btn btn-sm btn-primary' %>
        <% end %>
        <%= link_to icon('solid', 'pencil-alt', 'Edit'), edit_broker_contact_path(@contact), class: 'btn btn-sm btn-light' %>
      </div>
    </div>

    <div class="table-responsive">
      <table class="table table-borderless table-striped">
        <tbody>
          <tr>
            <th>Name</th>
            <td><%= @contact.full_name %></td>
          </tr>
          <tr>
            <th>Title</th>
            <td><%= @contact.job_title %></td>
          </tr>
          <tr>
            <th>Phones</th>
            <td>
              <ul class="list-unstyled">
                <% unless @contact.mobile_phone.blank? %>
                  <li><%= link_to @contact.mobile_phone.phony_formatted, "tel:#{@contact.mobile_phone}" %> <span class="badge bg-info">Mobile</span></li>
                <% end %>
                <% unless @contact.work_phone.blank? %>
                  <li><%= link_to @contact.work_phone.phony_formatted, "tel:#{@contact.work_phone}" %> <span class="badge bg-info">Office</span></li>
                <% end %>
              </ul>
            </td>
          </tr>
          <tr>
            <th>Email</th>
            <td>
              <% unless @contact.email.blank? %>
                <%= link_to @contact.email, "mailto:#{@contact.email}" %>
              <% end %>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>
