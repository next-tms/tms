<%= bootstrap_form_with(model: [:broker, @contact], layout: :horizontal) do |f| %>
  <%= f.alert_message "Unable to create contact:" %>

  <%= f.hidden_field :companyable_sgid, value: params[:companyable_sgid].presence || @contact.companyable_sgid %>
  <%= f.text_field :first_name, autofocus: true %>
  <%= f.text_field :last_name %>
  <%= f.text_field :job_title %>
  <%= f.text_field :mobile_phone %>
  <%= f.text_field :work_phone %>
  <%= f.email_field :email %>

  <%= f.form_group do %>
    <%= f.submit class: 'btn btn-primary', data: { turbo: false }, value: 'Save' %>
  <% end %>
<% end %>
