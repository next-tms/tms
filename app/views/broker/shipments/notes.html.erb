<% provide :title, "Notes — Load #{@shipment.load_id}" %>

<%= render 'member_header' %>
<h2>Notes</h2>

<% name = Setting.value(:name, 'broker') %>
<%= bootstrap_form_with(model: [:broker, @shipment], path: broker_shipment_path(@shipment), layout: :horizontal) do |f| %>
  <%= f.text_area :broker_notes, help: "Visible by #{name} only", autofocus: 'autofocus', rows: 5, autocomplete: 'off' %>
  <%= f.text_area :broker_and_broker_customer_notes, help: "Visible only to #{name} and #{f.object.broker_customer&.customer&.name || 'the customer'}", rows: 5, autocomplete: 'off' %>
  <%= f.text_area :public_notes, help: "Visible by everyone including #{name}, #{f.object.broker_customer&.customer&.name || 'the customer'}, and the public on tracking pages", rows: 5, autocomplete: 'off' %>
  <%= f.text_area :bol_notes, rows: 5 %>
  <div class="form-group">
    <%= f.submit class: 'btn btn-primary', value: 'Save' %>
  </div>
<% end %>
