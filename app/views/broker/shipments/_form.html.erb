<%= bootstrap_form_with(
      control_col: 'col-sm-8',
      data: { controller: 'autofill-shipper', 'autofill-shipper-target': 'form' },
      id: 'shipment-form',
      label_col: 'col-sm-3',
      layout: :horizontal,
      model: [:broker, @shipment],
    ) do |f| %>
  <span id="customerDispatcherIds" data-customer-dispatcher-ids="<%= @customer_dispatcher_ids %>">

  <% unless @shipment.quote_only? %>
    <div data-controller="shipments">
      <%= f.select :broker_customer_id,
                  current_user.broker_customers.includes(:customer).order('customers.name').collect { |broker_customer| [ broker_customer.customer.name, broker_customer.id ] },
                  { selected: (@shipment.broker_customer ? @shipment.broker_customer.id : (params[:broker_customer_id] ? params[:broker_customer_id] : nil)) },
                  data: { action: 'change->shipments#fillCustomerAddressByBrokerCustomerId' },
                  class: 'form-select col-sm-6 col-md-4 mt-2 mb-4' %>
    </div>
  <% end %>

  <% if current_user.any_role?(:dispatch, :root) || current_user.sales_rep_for?(@shipment.broker_customer) %>
    <% dispatcher_ids = User.active.dispatchers.ids %>
    <% dispatcher_ids << current_user.id %>
    <% dispatcher_ids << @shipment.dispatcher_id unless dispatcher_ids.include?(@shipment.dispatcher_id) %>

    <%= f.select :dispatcher_id,
                 User.where(id: dispatcher_ids).order(:first_name).collect { |user| [ user.full_name, user.id ] },
                 { include_blank: 'None — assign automatically' },
                 id: 'shipment_dispatcher_id',
                 class: 'form-select col-sm-6 col-md-4 mt-2 mb-4'
    %>
  <% end %>

  <div class="row">
    <div class="col-sm-12 col-md-4">
      <p class="col-title"><%= icon 'solid', 'industry', 'Shipper' %></p>
      <%= f.fields_for :shipper_address do |address_form| %>
        <%= address_form.text_field :name, autofocus: @accessorials_has_been_suggested.blank? %>
      <% end %>
      <%= f.text_field :pickup_on, data: flatpickr_data %>
      <%= f.text_field :pickup_hours_start_at, data: flatpickr_data(override: { flatpickr_enable_time: true, flatpickr_no_calendar: true, flatpickr_date_format: 'h:i K' }) %>
      <%= f.text_field :pickup_hours_end_at, data: flatpickr_data(override: { flatpickr_enable_time: true, flatpickr_no_calendar: true, flatpickr_date_format: 'h:i K' }) %>
      <%= f.text_field :shipper_contact_name %>
      <%= f.telephone_field :shipper_contact_phone %>
      <%= f.email_field :shipper_contact_email %>

      <div data-autofill-shipper-target="shipperAddress" data-controller="address">
        <%= render 'shipments/address_form', form: f, address_object: :shipper_address, fallback_address: Setting.mailing_address! %>
      </div>
    </div>

    <div class="col-sm-12 col-md-4">
      <p class="col-title"><%= icon 'solid', 'cart-arrow-down', 'Receiver' %></p>
      <%= f.fields_for :receiver_address do |address_form| %>
        <%= address_form.text_field :name %>
      <% end %>
      <%= f.text_field :delivery_appointment_on, data: flatpickr_data %>
      <%= f.text_field :delivery_hours_start_at, data: flatpickr_data(override: { flatpickr_enable_time: true, flatpickr_no_calendar: true, flatpickr_date_format: 'h:i K' }) %>
      <%= f.text_field :delivery_hours_end_at, data: flatpickr_data(override: { flatpickr_enable_time: true, flatpickr_no_calendar: true, flatpickr_date_format: 'h:i K' }) %>
      <%= f.text_field :receiver_contact_name %>
      <%= f.telephone_field :receiver_contact_phone %>
      <%= f.email_field :receiver_contact_email %>

      <div data-controller="address">
        <%= render 'shipments/address_form', form: f, address_object: :receiver_address, fallback_address: Setting.mailing_address! %>
      </div>
    </div>

    <div class="col-sm-12 col-md-4">
      <p class="col-title"><%= icon 'solid', 'barcode', 'References' %></p>
      <%= f.text_field :shipper_reference, autocomplete: 'off' %>
      <%= f.text_field :customer_reference, autocomplete: 'off' %>
      <%= f.text_field :bol, autocomplete: 'off' %>
      <%= f.text_field :pro, autocomplete: 'off' %>

      <p class="col-title"><%= icon 'solid', 'dollar-sign', 'Value' %></p>
      <%= f.text_field :value, prepend: '$', data: money_controller_data, autocomplete: 'off' %>
    </div>
  </div>

  <div data-controller="shipments">
    <span class="btn btn-primary" data-action="click->shipments#switchAddresses">
      <%= icon('solid', 'right-left', 'Switch') %>
    </span>
  </div>

  <p class="col-title mt-4">Services</p>

  <%= render 'shipments/nested_broker_accessorials_form',
             f: f,
             accessorials_has_been_suggested: @accessorials_has_been_suggested %>

  <p class="col-title mt-4">Freight</p>
  <%= f.check_box :truckload, class: 'mb-4' %>

  <%= render 'shipments/nested_items_form', f: f %>

  <p class="col-title mt-4">Special Instructions</p>
  <%= f.text_area :bol_notes, hide_label: true, rows: 5, autofocus: @accessorials_has_been_suggested.present?  %>

  <div class="form-group">
    <%= f.submit class: 'btn btn-success mt-4', value: 'Save' %>
  </div>
<% end %>