<%= bootstrap_form_with(model: [:broker, @shipment], local: true, layout: :horizontal, label_col: 'col-sm-3', control_col: 'col-sm-8', id: 'shipment-form', data: { controller: 'autofill-shipper', 'autofill-shipper-target': 'form', turbo: false }) do |f| %>
  <%= f.alert_message 'Unable to create shipment:' %>

  <% unless @shipment.quote_only? %>
    <%= f.select :broker_customer_id, current_user.broker_customers.includes(:customer).sort_by { |broker_customer| broker_customer.customer.name }.collect { |broker_customer| [ broker_customer.customer.name, broker_customer.id ] }, { label: 'Customer', selected: (@shipment.broker_customer ? @shipment.broker_customer.id : (params[:broker_customer_id] ? params[:broker_customer_id] : nil)) }, data: { action: 'autofill-shipper#handle', 'autofill-shipper-target': 'brokerCustomer' }, class: 'form-select col-sm-6 col-md-4 mt-2 mb-4' %>
  <% end %>

  <div class="row">
    <div class="col-sm-6 col-md-4">
      <p class="col-title"><%= icon 'fas', 'industry', 'Shipper' %></p>
      <%= f.text_field :shipper_name, label: 'Name', autofocus: 'autofocus' %>
      <%= f.text_field :pickup_on, label: 'Pickup', data: flatpickr_data %>
      <%= f.text_field :pickup_hours_start_at, label: 'Hours', data: flatpickr_data(override: { flatpickr_enable_time: true, flatpickr_no_calendar: true, flatpickr_date_format: 'h:i K' }) %>
      <%= f.text_field :pickup_hours_end_at, label: '&nbsp;'.html_safe, data: flatpickr_data(override: { flatpickr_enable_time: true, flatpickr_no_calendar: true, flatpickr_date_format: 'h:i K' }) %>
      <%= f.text_field :shipper_contact_name, label: 'Contact' %>
      <%= f.telephone_field :shipper_contact_phone, label: 'Phone' %>
      <%= f.email_field :shipper_contact_email, label: 'Email' %>
      <div data-autofill-shipper-target="shipperAddress">
        <%= f.fields_for :shipper_address do |shipper_address_form| %>
          <%= shipper_address_form.text_field :ref %>
          <%= shipper_address_form.text_field :street %>
          <%= shipper_address_form.text_field :street2, label: '&nbsp;'.html_safe %>
          <%= shipper_address_form.text_field :city %>
          <%= shipper_address_form.select :state, states_and_abbreviations, { include_blank: true, label: 'State', selected: (@shipment.shipper_address.state.blank? ? nil : @shipment.shipper_address.state) }, class: 'form-select' %>
          <%= shipper_address_form.text_field :zip_code, label: 'ZIP' %>
          <%= shipper_address_form.select :country_id, current_user.broker.countries.order(:name).collect { |c| [c.name, c.id] }, { label: 'Country', selected: (@shipment.shipper_address.country.blank? ? current_user.broker.address.country.id : @shipment.shipper_address.country.id) }, class: 'form-select' %>
        <% end %>
      </div>
    </div>

    <div class="col-sm-6 col-md-4">
      <p class="col-title"><%= icon 'fas', 'cart-arrow-down', 'Receiver' %></p>
      <%= f.text_field :receiver_name, label: 'Name' %>
      <%= f.text_field :delivery_appointment_on, label: 'Appointment', data: flatpickr_data %>
      <%= f.text_field :delivery_hours_start_at, label: 'Hours', data: flatpickr_data(override: { flatpickr_enable_time: true, flatpickr_no_calendar: true, flatpickr_date_format: 'h:i K' }) %>
      <%= f.text_field :delivery_hours_end_at, label: '&nbsp;'.html_safe, data: flatpickr_data(override: { flatpickr_enable_time: true, flatpickr_no_calendar: true, flatpickr_date_format: 'h:i K' }) %>
      <%= f.text_field :receiver_contact_name, label: 'Contact' %>
      <%= f.telephone_field :receiver_contact_phone, label: 'Phone' %>
      <%= f.email_field :receiver_contact_email, label: 'Email' %>
      <%= f.fields_for :receiver_address do |receiver_address_form| %>
        <%= receiver_address_form.text_field :ref %>
        <%= receiver_address_form.text_field :street %>
        <%= receiver_address_form.text_field :street2, label: '&nbsp;'.html_safe %>
        <%= receiver_address_form.text_field :city %>
        <%= receiver_address_form.select :state, states_and_abbreviations, { include_blank: true, label: 'State', selected: (@shipment.receiver_address.state.blank? ? nil : @shipment.receiver_address.state) }, class: 'form-select' %>
        <%= receiver_address_form.text_field :zip_code, label: 'ZIP' %>
        <%= receiver_address_form.select :country_id, current_user.broker.countries.order(:name).collect { |c| [c.name, c.id] }, { label: 'Country', selected: (@shipment.receiver_address.country.blank? ? current_user.broker.address.country.id : @shipment.receiver_address.country.id) }, class: 'form-select' %>
      <% end %>
    </div>

    <div class="col-sm-6 col-md-4">
      <p class="col-title"><%= icon 'fas', 'barcode', 'References' %></p>
      <%= f.text_field :shipper_reference, label: 'Shipper', autocomplete: 'off' %>
      <%= f.text_field :customer_reference, label: 'PO', autocomplete: 'off' %>
      <%= f.text_field :bol, label: 'BOL', autocomplete: 'off' %>
      <%= f.text_field :pro, label: 'Pro', autocomplete: 'off' %>

      <p class="col-title"><%= icon 'fas', 'dollar-sign', 'Value' %></p>
      <%= f.text_field :value, label: 'Total', prepend: '$', data: money_controller_data, autocomplete: 'off' %>
    </div>
  </div>

  <p class="col-title mt-4">Services</p>
  <div data-controller="nested-form" data-nested-form-wrapper-selector-value=".shipment-broker-accessorial-form-wrapper">
    <template data-nested-form-target="template">
      <%= f.fields_for :shipment_broker_accessorials, ShipmentBrokerAccessorial.new, child_index: 'NEW_RECORD' do |shipment_broker_accessorial_form| %>
        <%= render 'shipment_broker_accessorial_form', f: shipment_broker_accessorial_form %>
      <% end %>
    </template>

    <%= f.fields_for :shipment_broker_accessorials do |shipment_broker_accessorial_form| %>
      <%= render 'shipment_broker_accessorial_form', f: shipment_broker_accessorial_form %>
    <% end %>

    <div data-nested-form-target="target"></div>

    <%= link_to icon('fas', 'plus', 'Add'), '#', data: { action: 'nested-form#add' }, class: 'btn btn-light' %>
  </div>

  <p class="col-title mt-4">Freight</p>
  <%= f.check_box :truckload, label: 'Ship as a truckload?', class: 'mb-4' %>

  <div data-controller="nested-form" data-nested-form-wrapper-selector-value=".item-form-wrapper">
    <template data-nested-form-target="template">
      <%= f.fields_for :items, Item.new, child_index: 'NEW_RECORD' do |item_form| %>
        <%= render 'item_form', f: item_form %>
      <% end %>
    </template>

    <%= f.fields_for :items do |item_form| %>
      <%= render 'item_form', f: item_form %>
    <% end %>

    <div data-nested-form-target="target"></div>

    <%= link_to icon('fas', 'plus', 'Add'), '#', data: { action: 'nested-form#add' }, class: 'btn btn-light' %>
  </div>

  <p class="col-title mt-4">Special Instructions</p>
  <%= f.text_area :bol_notes, hide_label: true, rows: 5 %>

  <div class="form-group">
    <%= f.submit class: 'btn btn-primary mt-4', data: { turbo: false }, value: 'Save' %>
  </div>
<% end %>