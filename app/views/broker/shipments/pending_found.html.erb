<% provide :title, 'Lost — Shipments' %>
<% provide :menu, render('menu') %>
<% provide :auto_refresh, 'yes' %>

<div class="page-header">
  <h1>Shipments</h1>
  <p class="lead">Lost</p>
</div>

<% unless @shipments.blank? %>
  <%= render 'show_many_pending_delivery', shipments: @shipments %>
<% else %>
  <%= render 'layouts/no_content' %>
<% end %>