<td>
  <% unless shipment.broker_carrier.blank? %>
    <% if shipment.broker_carrier.carrier.acts_as_broker? and not shipment.tracking_carrier.blank? %>
      <%= shipment.tracking_carrier.name %>
      <br>
      via <%= shipment.broker_carrier.carrier.name %>
    <% else %>
      <%= shipment.broker_carrier.carrier.name %>
    <% end %>
  <% end %>
</td>