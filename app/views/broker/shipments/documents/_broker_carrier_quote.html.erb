<tr id="<%= this_dom_id %>_broker_carrier_quote">
  <% if shipment.broker_carrier_quote.attached? %>
    <td><%= shipment.broker_carrier.carrier.name %></td>
    <td>Carrier Quote</td>
    <%= render 'broker/shipments/documents/actions', shipment:, document_type: :broker_carrier_quote %>
    <td>
      <%= render 'broker/shipments/documents/document_upload', document_type: :broker_carrier_quote, replace: true %>
    </td>
  <% end %>
</tr>
