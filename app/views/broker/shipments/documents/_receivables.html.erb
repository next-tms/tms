<tr id="<%= this_dom_id %>_receivables">
  <% if shipment.receivables.any? %>
    <% shipment.receivables.with_invoice.order(:created_at).each do |receivable| %>
      <td><%= receivable.shipment.broker.name %></td>
      <td>Invoice</td>
      <td>
        <%= link_to icon('solid', 'eye', 'View'),
                    rails_blob_path(receivable.invoice, disposition: 'preview'),
                    target: '_blank'
        %>
      </td>
      <td>
        <%= link_to icon('solid', 'file-download', 'Download'),
                    rails_blob_path(receivable.invoice, disposition: 'attachment'),
                    data: { turbo: false }
        %>
      </td>
      <td>
        <%= link_to icon('solid', 'paper-plane', 'Send'),
                    send_document_broker_shipment_path(shipment, shipment_method: 'carrier_pod'),
                    data: { turbo_frame: 'modal' }
        %>
      </td>
      <td></td>
    <% end %>
  <% end %>
</tr>
