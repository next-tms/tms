<tr id="<%= this_dom_id %>_carrier_pod">
  <% if shipment.broker_carrier.present? && shipment.carrier_pod.attached? %>
    <td><%= shipment.broker_carrier.carrier.name %></td>
    <td>Proof of Delivery</td>
    <%= render 'broker/shipments/documents/actions', shipment:, document_type: :carrier_pod %>
    <td>
      <%= render 'broker/shipments/documents/document_upload', document_type: :carrier_pod, replace: true %>
    </td>
  <% end %>
</tr>
