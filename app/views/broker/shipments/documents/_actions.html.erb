<td>
  <%= link_to icon('solid', 'eye', 'View'),
              rails_blob_path(shipment.public_send(document_type), disposition: 'preview'),
              target: '_blank'
  %>
</td>
<td>
  <%= link_to icon('solid', 'file-download', 'Download'),
              rails_blob_path(shipment.public_send(document_type), disposition: 'attachment'),
              data: { turbo: false }
  %>
</td>
<td>
  <%= link_to icon('solid', 'paper-plane', 'Send'),
              send_document_broker_shipment_path(shipment, shipment_method: document_type),
              data: { turbo_frame: 'modal' }
  %>
</td>
