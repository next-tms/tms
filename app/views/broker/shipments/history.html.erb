<% provide :title, "History — Load #{@shipment.load_id}" %>

<%= render 'member_header' %>
<h2>History</h2>

<div class="table-responsive">
  <table class="table table-borderless table-striped">
    <thead>
      <tr>
        <th>When</th>
        <th>Updated By</th>
        <th>Changes</th>
      </tr>
    </thead>
    <tbody>
      <% @audits.each do |audit| %>
        <tr>
          <td>
            <%= time(audit.created_at) %>
          </td>
          <td>
           <%= audit.user&.full_name || 'Robot' %>
          </td>
          <td>
            <% if audit.auditable_type == 'Shipment' && audit.action == 'create' %>
              Initial Version
            <% elsif audit.action.in?(%w[create destroy]) %>
              Item <%= audit.action == 'create' ? 'added' : 'removed' %>
              <ul class="list-unstyled">
                <% audit.audited_changes.each do |field, value| %>
                  <li><%= field.split('_').map(&:capitalize).join(' ') %>: <strong>"<%= value %>"</strong></li>
                <% end %>
              </ul>
            <% else %>
              <% if audit.auditable_type == 'Address' %>
                <%= audit.auditable_id == @shipment.shipper_address_id ? 'Shipper' : 'Receiver' %> address updated
              <% elsif audit.auditable_type == 'Item' %>
                Item updated
              <% end %>
              <ul class="list-unstyled">
                <% audit.audited_changes.each do |field, changes| %>
                  <li><%= field.split('_').map(&:capitalize).join(' ') %> changed from
                    <strong>"<%= changes.first %>"</strong> to
                    <strong>"<%= changes.last %>"</strong>
                  </li>
                <% end %>
              </ul>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
