<nav class="nav border-top pt-4 mb-0">
  <% if !@shipment.quote_only? %>
    <%= link_to 'Overview', broker_shipment_path(@shipment), class: 'nav-link shipments-show' %>

    <a class="nav-link dropdown-toggle" href="#" id="shipment-mark-dropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
      Update
    </a>
    <ul class="dropdown-menu" aria-labelledby="shipment-mark-dropdown">
      <% if @shipment.booked_at.blank? %>
        <%= link_to 'Book', book_broker_shipment_path(@shipment), target: '_top', class: 'dropdown-item' %>
      <% else %>
        <%= link_to 'Unbook', unbook_broker_shipment_path(@shipment), target: '_top', class: 'dropdown-item' %>
      <% end %>

      <% if @shipment.canceled_at.blank? %>
        <%= link_to 'Cancel', broker_shipment_path(@shipment, shipment: { canceled_at: 'now' }), data: { confirm: 'Are you sure you want to cancel this shipment?', method: :patch }, target: '_top', class: 'dropdown-item' %>
      <% else %>
        <%= link_to 'Reinstate', broker_shipment_path(@shipment, shipment: { canceled_at: nil }), data: { method: :patch }, target: '_top', class: 'dropdown-item' %>
      <% end %>

      <% unless @shipment.charges_confirmed %>
        <%= link_to 'Confirm Charges', broker_shipment_path(@shipment, shipment: { charges_confirmed: true }), data: { confirm: 'Are you sure you want to confirm shipment charges?', method: :patch }, target: '_top', class: 'dropdown-item' %>
      <% end %>
    </ul>

    <%= link_to 'Plan', edit_broker_shipment_path(@shipment), class: 'nav-link shipments-edit' %>

    <% if current_user.has_role?('accounting') or current_user.has_role?('dispatch') or @shipment.broker_customer.sales_reps.include?(current_user) %>
      <%= link_to 'Pricing', pricing_broker_shipment_path(@shipment), class: 'nav-link shipments-pricing' %>
    <% end %>

    <% if current_user.has_role?('dispatch') || current_user.sales_rep_for?(@shipment.broker_customer) %>
      <%= link_to 'Routing', transit_broker_shipment_path(@shipment), class: 'nav-link shipments-transit shipments-quote' %>
      <%= link_to 'Tracking', edit_tracking_events_broker_shipment_path(@shipment), class: 'nav-link shipments-edit-tracking-events' %>
    <% end %>

    <% if current_user.has_role?('accounts_payable') || current_user.has_role?('accounts_receivable') || current_user.sales_rep_for?(@shipment.broker_customer) || current_user.dispatcher_for?(@shipment) || current_user == @shipment.dispatcher %>
      <%= link_to 'Accounting', accounting_broker_shipment_path(@shipment), class: 'nav-link shipments-accounting' %>
    <% end %>

    <% if (@shipment.claims.any? || @shipment.broker_carrier.present?) &&
          (
            current_user.has_role?('claims') ||
            current_user.has_role?('accounts_payable') ||
            current_user.has_role?('accounts_receivable') ||
            current_user.sales_rep_for?(@shipment.broker_customer) ||
            current_user.dispatcher_for?(@shipment) ||
            current_user == @shipment.dispatcher
          )
    %>
      <%= link_to 'Claims', claims_broker_shipment_path(@shipment), class: 'nav-link shipments-claims' %>
    <% end %>

    <%= link_to 'Documents', documents_broker_shipment_path(@shipment), class: 'nav-link shipments-documents' %>
    <%= link_to 'Notes', notes_broker_shipment_path(@shipment), class: 'nav-link shipments-notes' %>
    <%= link_to 'History', history_broker_shipment_path(@shipment), class: 'nav-link shipments-history' %>
  <% elsif @shipment.quote_only? %>
    <%= link_to icon('solid', 'pencil-alt', 'Edit'), edit_broker_shipment_path(@shipment), class: 'nav-link shipments-edit' %>
    <%= link_to icon('solid', 'bell', 'Book'), book_modal_broker_shipment_path(@shipment), data: { 'turbo-frame': 'modal' }, class: 'nav-link' %>
  <% end %>
</nav>
