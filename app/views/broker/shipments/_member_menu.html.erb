<div class="btn-toolbar mt-4 mb-4">
  <div class="btn-group">
      <% if @shipment&.id && !@shipment.quote_only? %>
        <%= link_to icon('fas', 'asterisk', 'Overview'), broker_shipment_path(@shipment), class: 'btn btn-sm' %>
        <% if @shipment.booked_at.blank? %>
          <%= link_to icon('fas', 'bell', 'Book'), book_broker_shipment_path(@shipment), class: 'btn btn-sm' %>
        <% else %>
          <%= link_to icon('fas', 'bell-slash', 'Unbook'), unbook_broker_shipment_path(@shipment), class: 'btn btn-sm' %>
        <% end %>
        <%= link_to icon('fas', 'pencil-alt', 'Edit'), edit_broker_shipment_path(@shipment), class: 'btn btn-sm' %>
        <% if current_user.has_role?('accounting') or current_user.has_role?('dispatch') or @shipment.broker_customer.sales_reps.include?(current_user) %>
          <%= link_to icon('fas', 'dollar-sign', 'Pricing'), pricing_broker_shipment_path(@shipment), class: 'btn btn-sm' %>
        <% end %>
        <% if current_user.has_role? 'dispatch' %>
          <%= link_to icon('fas', 'map-signs', 'Routing'), transit_broker_shipment_path(@shipment), class: 'btn btn-sm' %>
          <%= link_to icon('fas', 'map-pin', 'Tracking'), edit_tracking_events_broker_shipment_path(@shipment), class: 'btn btn-sm' %>
        <% end %>
        <%= link_to icon('fas', 'folder', 'Documents'), documents_broker_shipment_path(@shipment), class: 'btn btn-sm' %>
        <%= link_to icon('fas', 'sticky-note', 'Notes'), notes_broker_shipment_path(@shipment), class: 'btn btn-sm' %>

          <% unless @shipment.canceled_at.blank? %>
            <%= link_to icon('fas', 'arrow-up', 'Reinstate'), broker_shipment_path(@shipment, shipment: { canceled_at: nil }), data: { method: :patch }, class: 'btn btn-sm' %>
          <% else %>
            <%= link_to icon('fas', 'ban', 'Cancel'), broker_shipment_path(@shipment, shipment: { canceled_at: DateTime.now }), data: { confirm: 'Are you sure you want to cancel this shipment?', method: :patch }, class: 'btn btn-sm' %>
          <% end %>

      <% elsif @shipment&.id && @shipment.quote_only? %>
        <%= link_to icon('fas', 'pencil-alt', 'Edit'), edit_broker_shipment_path(@shipment), class: 'btn btn-sm' %>

          <%= link_to icon('fas', 'bell', 'Book'), book_modal_broker_shipment_path(@shipment), data: { 'turbo-frame': 'modal' }, class: 'btn btn-sm' %>

      <% else %>
        <% if action_name.include?('new') %>
          <%= link_to icon('fas', 'bomb', 'Reset'), new_broker_shipment_path, data: { confirm: 'Reset the form? Unsaved changes will be lost.' }, class: 'btn btn-sm' %>
        <% end %>
      <% end %>
      <% if action_name == 'index' or action_name.include? 'pending' or ['booked', 'delivered', 'late', 'missing_delivery_appointment', 'missing_pricing', 'missing_pro'].include? action_name %>

          <%= link_to icon('fas', 'plus', 'Fast Quote'), broker_quote_only_path, class: 'btn btn-sm' %>
          <%= link_to broker_shipments_pending_quotation_path, class: 'btn btn-sm' do %>
            <%= icon 'far', 'inbox', 'Inbox' %>
            <%= maybe_badge Shipment.where(broker_customer: [ current_user.broker_customers ]).active.pending_quotation.or(Shipment.where(broker_customer: [ current_user.broker_customers ]).canceled_recently).distinct.size, type: 'bg-dark' %>
          <% end %>

          <%= link_to broker_shipments_pending_dispatch_path, class: 'btn btn-sm' do %>
            <%= icon 'fas', 'file-invoice-dollar', 'Quoted' %>
            <%= maybe_badge Shipment.where(broker_customer: [ current_user.broker_customers ]).active.pending_dispatch.size, type: 'bg-dark' %>
          <% end %>

          <%= link_to broker_shipments_booked_path, class: 'btn btn-sm' do %>
            <%= icon 'fas', 'bell', 'Booked' %>
            <%= maybe_badge Shipment.where(broker_customer: [ current_user.broker_customers ]).active.booked.size, type: 'bg-dark' %>
          <% end %>

          <%= link_to broker_shipments_pending_pickup_path, class: 'btn btn-sm' do %>
            <%= icon 'fas', 'industry', 'Dispatched' %>
            <%= maybe_badge Shipment.where(broker_customer: [ current_user.broker_customers ]).active.pending_pickup.or(Shipment.where(broker_customer: [ current_user.broker_customers ]).canceled_recently.pending_pickup).distinct.size, type: 'bg-dark' %>
          <% end %>

          <%= link_to broker_shipments_pending_departure_path, class: 'btn btn-sm' do %>
            <%= icon 'fas', 'arrow-circle-up', 'Pending Departure' %>
            <%= maybe_badge (Shipment.where(broker_customer: [ current_user.broker_customers ]).pending_departure).size, type: 'bg-dark' %>
          <% end %>

          <%= link_to broker_shipments_pending_found_path, class: 'btn btn-sm' do %>
            <%= icon 'fas', 'exclamation-circle', 'Lost' %>
            <%= maybe_badge Shipment.where(broker_customer: [ current_user.broker_customers ]).pending_found.size, type: 'bg-danger' %>
          <% end %>

          <%= link_to broker_shipments_pending_delivery_path, class: 'btn btn-sm' do %>
            <%= icon 'fas', 'arrow-circle-right', 'In Transit' %>
            <%= maybe_badge (Shipment.where(broker_customer: [ current_user.broker_customers ]).active.pending_delivery - Shipment.where(broker_customer: [ current_user.broker_customers ]).active.late).size, type: 'bg-dark' %>
          <% end %>

          <%= link_to icon('fas', 'check-square', 'Delivered'), broker_shipments_delivered_path, class: 'btn btn-sm' %>

        <%= link_to icon('fas', 'calendar-times', 'Missing Appointment'), broker_shipments_missing_delivery_appointment_path, class: 'btn btn-sm' %>
        <%= link_to icon('fas', 'barcode', 'Missing Pro'), broker_shipments_missing_pro_path, class: 'btn btn-sm' %>
        <%= link_to icon('fas', 'dollar-sign', 'Missing Pricing'), broker_shipments_missing_pricing_path, class: 'btn btn-sm' %>
      <% end %>
  </div>
</div>