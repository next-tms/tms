<% provide :title, 'Dispatched — Shipments' %>
<% provide :menu, render('menu') %>
<% provide :auto_refresh, 'yes' if not @shipments_for_pickup_today.blank? or not @shipments_for_pickup_later.blank? %>

<div class="page-header">
  <h1>Shipments</h1>
  <p class="lead">Dispatched</p>
</div>

<% unless @shipments_missed_pickup.blank? %>
  <h2>Overdue</h2>
  <%= render 'show_many_pending_pickups', shipments: @shipments_missed_pickup %>
<% end %>

<% unless @shipments_for_pickup_today.blank? %>
  <h2>Today</h2>
  <%= render 'show_many_pending_pickups', shipments: @shipments_for_pickup_today %>
<% end %>

<% unless @shipments_for_pickup_later.blank? %>
  <h2>Future</h2>
  <%= render 'show_many_pending_pickups', shipments: @shipments_for_pickup_later %>
<% end %>

<% if @shipments_for_pickup_today.blank? and @shipments_for_pickup_later.blank? %>
  <%= render 'layouts/no_content' %>
<% end %>