<% provide :title, 'Dispatched' %>

<%= render 'header' %>

<% unless @shipments_missed_pickup.blank? %>
  <h2>Overdue</h2>
  <%= render 'show_many_pending_pickups', shipments: @shipments_missed_pickup %>
<% end %>

<% unless @shipments_for_pickup_today.blank? %>
  <h2>Today</h2>
  <%= render 'show_many_pending_pickups', shipments: @shipments_for_pickup_today %>
<% end %>

<% unless @shipments_for_pickup_later.blank? %>
  <h2>Future</h2>
  <%= render 'show_many_pending_pickups', shipments: @shipments_for_pickup_later %>
<% end %>

<% if @shipments_missed_pickup.blank? && @shipments_for_pickup_today.blank? && @shipments_for_pickup_later.blank? %>
  <%= render 'layouts/no_content' %>
<% end %>
