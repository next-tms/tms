<div class="tracking-event-form-wrapper row gy-2 gx-3 align-items-center mb-4" data-controller="address" data-new-record="<%= f.object.new_record? %>">
  <div class="col-auto">
    <%= f.select :event_id, Event.order(:name).collect { |event| [ event.name.capitalize, event.id ] }, { label: 'Event', hide_label: true }, class: 'form-select' %>
  </div>

  <div class="col-auto">
    <%= f.text_field :at, label: 'At', hide_label: true, autocomplete: 'off', data: flatpickr_datetime_data(f.object.at, f.object.time_zone), value: maybe_in_time_zone(datetime: f.object.at, time_zone: f.object.time_zone) %>
  </div>

  <div class="col-auto">
    <%= f.text_field :city, hide_label: true, placeholder: 'City' %>
  </div>

  <div class="col-auto">
    <%= f.select :region_iso31662, (f.object.region_iso31662.blank? ? [[Setting.mailing_address!.region.name, Setting.mailing_address!.region.id]] : [[f.object.region.abbreviation, f.object.region_iso31662]]), { hide_label: true }, data: { 'address-target': 'regions' }, class: 'form-select' %>
  </div>

  <div class="col-auto">
    <%= f.select :country_alpha2, country_options(Transponder::ORM::Country.order(:name), f.object.country_alpha2), { hide_label: true, selected: (f.object.country_alpha2.blank? ? Setting.mailing_address!.country_alpha2 : f.object.country_alpha2) }, data: { action: 'address#handle', 'address-target': 'country' }, class: 'form-select' %>
  </div>

  <div class="col-auto">
    <%= f.form_group do %>
      <%= f.hidden_field :_destroy %>
      <%= link_to icon('solid', 'trash', 'Remove'), '#', data: { action: 'nested-form#remove' }, class: 'btn btn-light' %>
    <% end %>
  </div>
</div>
