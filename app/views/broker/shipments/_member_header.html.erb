<div class="page-header p-4 mb-4" data-controller="highlightable">
  <span data-highlightable-target="attr" data-attr-name="<%= params[:attr] %>">

  <h1 class="mb-6">
    <% if @shipment.new_record? %>
      <%= action_name == 'quote_only' ? 'Shipment' : 'Quote' %>
    <% elsif @shipment.quote_only? %>
      Quote <%= @shipment.load_id %>
    <% else %>
      Load <%= @shipment.load_id %>
    <% end %>
  </h1>

  <% if !@shipment.new_record? && !@shipment.quote_only? %>
    <table class="table table-borderless w-auto">
      <thead>
        <tr>
          <th>Customer</th>

          <% unless @shipment.dispatcher.blank? %>
            <th>Dispatcher</th>
          <% end %>

          <th>Status</th>

          <% unless @shipment.broker_carrier.blank? %>
            <th>Carrier</th>
          <% end %>

          <% if (@shipment.picked_up_at.blank? || @shipment.pro.blank?) && !real_pickup_confirmation(@shipment).blank? %>
            <th>Pickup Ref</th>
          <% end %>

          <% unless @shipment.shipper_reference.blank? %>
            <th>Shipper Ref</th>
          <% end %>

          <% unless @shipment.customer_reference.blank? %>
            <th>Customer Ref</th>
          <% end %>

          <% unless @shipment.bol.blank? %>
            <th>BOL</th>
          <% end %>

          <% unless real_pro(@shipment).blank? %>
            <th>Pro</th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td class="lead">
            <% unless @shipment.broker_customer.blank? %>
              <%= link_to @shipment.broker_customer.customer.name, broker_broker_customer_path(@shipment.broker_customer), target: '_blank' %>
            <% end %>
          </td>

          <% unless @shipment.dispatcher.blank? %>
            <td class="lead">
              <%= highlightable_element :dispatcher_id do %>
                <%= @shipment.dispatcher.full_name %>
              <% end %>
            </td>
          <% end %>

          <td class="lead">
            <%= @shipment.late? ? "Late, #{enum_l(@shipment, :status)}" : enum_l(@shipment, :status) %>
          </td>

          <% unless @shipment.broker_carrier.blank? %>
            <td class="lead">
              <% if @shipment.broker_carrier.carrier.acts_as_broker? and not @shipment.tracking_carrier.blank? %>
                <li class="list-inline-item"><%= @shipment.tracking_carrier.name %> via <%= link_to @shipment.broker_carrier.carrier.name, broker_broker_carrier_path(@shipment.broker_carrier), target: '_blank' %></li>
              <% else %>
                <li class="list-inline-item"><%= link_to @shipment.broker_carrier.carrier.name, broker_broker_carrier_path(@shipment.broker_carrier), target: '_blank' %></li>
              <% end %>
            </td>
          <% end %>

          <% if (@shipment.picked_up_at.blank? || @shipment.pro.blank?) && !real_pickup_confirmation(@shipment).blank? %>
            <td class="lead">
              <% unless pickup_uri(@shipment).blank? %>
                <%= link_to real_pickup_confirmation(@shipment), pickup_uri(@shipment), target: '_blank' %>
              <% else %>
                <%= real_pickup_confirmation(@shipment) %>
              <% end %>
            </td>
          <% end %>

          <% unless @shipment.shipper_reference.blank? %>
            <td class="lead"><%= @shipment.shipper_reference %></td>
          <% end %>

          <% unless @shipment.customer_reference.blank? %>
            <td class="lead"><%= @shipment.customer_reference %></td>
          <% end %>

          <% unless @shipment.bol.blank? %>
            <td class="lead"><%= @shipment.bol %></td>
          <% end %>

          <% unless real_pro(@shipment).blank? %>
            <td class="lead">
              <% if tracking_uri(@shipment).blank? %>
                <%= real_pro(@shipment) %>
              <% else %>
                <%= link_to real_pro(@shipment), tracking_uri(@shipment), target: '_blank' %>
              <% end %>
            </td>
          <% end %>
        </tr>
      </tbody>
    </table>
  <% end %>

  <% unless @shipment.new_record? %>
    <%= render 'broker/shipments/member_menu' %>
  <% end %>
</div>
