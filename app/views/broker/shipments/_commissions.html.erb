<p class="col-title"><%= icon 'fas', 'dollar-sign', 'Commissions' %></p>
<div class="table-responsive mb-2">
  <table class="table table-condensed table-borderless table-striped table-hover h-100">
    <thead>
      <th>Name</th>
      <th>%</th>
      <th>Amount</th>
      <th>Paid?</th>
    </thead>
    <tbody>
      <% total_amount_cents = 0 %>
      <% total_percent = 0 %>
      <% if current_user.has_role?('accounting') || current_user.has_role?('dispatch') %>
        <% commissions = shipment.commissions.order(:name) %>
      <% else %>
        <% commissions = current_user.commissions.where(shipment: shipment) %>
      <% end %>
      <% commissions.find_each do |commission| %>
        <% total_amount_cents += commission.amount_cents %>
        <% total_percent += commission.percent %>
        <tr>
          <td><%= commission.user.contact.full_name %></td>
          <td><%= commission.percent * 100 %></td>
          <td><%= humanized_money_with_symbol commission.amount, no_cents_if_whole: false %></td>
          <td>
            <% if commission.paid? %>✓<% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
    <tfoot>
      <tr class="bg-light font-weight-bold">
        <td></td>
        <td><%= total_percent * 100 %></td>
        <td><%= humanized_money_with_symbol Money.new(total_amount_cents), no_cents_if_whole: false %></td>
        <td></td>
      </tr>
    </tfoot>
  </table>
</div>
