<% provide :title, "Load #{@shipment.load_id}" %>

<% content_for(:alt_links) do %>
  <link rel="alternate" type="application/json" title="JSON" href="<%= api_v1_broker_shipment_path(@shipment) %>" />
<% end %>

<%= render 'member_header' %>

<% if (current_user.has_role?('dispatcher') || current_user.has_role?('root')) &&
      @shipment.dispatcher != current_user && @shipment.picked_up_at.blank?
%>
  <div class="alert alert-warning">
    <p class="lead">You’re not the dispatcher</p>

    <div class="btn-toolbar">
      <%= button_to 'Become Dispatcher', { shipment: { dispatcher_id: current_user.id } }, method: :patch, class: 'btn btn-warning' %>
    </div>
  </div>
<% end %>

<% problems = @shipment.problems.unresolved.or(@shipment.problems.resolved.where('resolved_at >= ?', 4.hours.ago)).order(:created_at, :resolved_at) %>
<% if problems.any? %>
  <div class="alert">
    <p class="col-title"><%= icon 'solid', 'table-list', 'Tasks' %></p>

    <%= render 'broker/problems/show_many', problems: problems, q: problems.ransack %>
  </div>
<% end %>

<% if @shipment.broker_customer.present? && !@shipment.broker_customer.internal_notes.blank? %>
  <div class="alert alert-danger">
    <p class="lead">Customer guide</p>
    <%= simple_format @shipment.broker_customer.internal_notes %>
  </div>
<% end %>

<% if @shipment.incomplete? && !@shipment.applied_rate.blank? %>
  <div class="alert alert-warning">
    <p class="lead">Quote may be invalid</p>
    <p>This shipment is missing important information but already has a quote applied. Please enter missing information and re-quote.</p>
  </div>
<% end %>

<% if !@shipment.applied_rate.blank? && @shipment.fingerprint != @shipment.applied_rate.shipment_fingerprint %>
  <div class="alert alert-warning">
    <p class="lead">Quote may be invalid</p>
    <% if @shipment.picked_up_at.blank? %>
      <p>This shipment has changed since it was quoted. Please re-quote.</p>
    <% else %>
      <p>
        This shipment has changed since it was dispatched.
        <% if @shipment.broker_customer.blank? %>
          Please re-quote and send the correct documents.
        <% else %>
          Please re-quote and send the correct documents to <%= @shipment.broker_customer.customer.name %>.
        <% end %>
      </p>
    <% end %>
  </div>
<% end %>

<% if @shipment.charges_confirmed %>
  <div class="alert alert-info">
    <%= charges_confirmed_note(@shipment) %>
  </div>
<% end %>

<% if !@shipment.charges_confirmed &&
      (@shipment.broker.requires_charges_confirmed_on_receivables || @shipment.broker_customer&.requires_charges_confirmed_on_receivables) %>
  <div class="alert alert-warning">
    <%= requires_charges_confirmed_note(@shipment) %>
  </div>
<% end %>

<% if @shipment.dispatched_at.blank? and not @shipment.suggested_broker_accessorials.blank?  %>
  <div class="alert alert-warning">
    <p class="lead"><%= icon 'solid', 'dollar-sign', 'Missing Services' %></p>
    <p>Based on the shipment information the following services may be required and charged by the carrier:</p>
    <ul class="list-unstyled list-inline">
      <% @shipment.suggested_broker_accessorials.each do |broker_accessorial| %>
        <li class="list-inline-item">
          <%= link_to "Add #{broker_accessorial.name}", broker_shipment_path(@shipment, shipment: { accessorial_codes: ( (@shipment.broker_accessorials.blank? ? [] : @shipment.broker_accessorials.map(&:code)) + [ broker_accessorial.code ] ).join(', ') }), method: :patch, class: 'btn btn-light' %>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>

<div class="row">
  <% cache [@shipment, @shipment.shipper_address] do %>
    <div class="col-sm-3">
      <p class="col-title"><%= icon 'solid', 'industry', 'Shipper' %></p>
        <% unless @shipment.shipper_address.types.blank? %>
          <ul class="list-inline list-unstyled text-muted text-uppercase">
            <% @shipment.shipper_address.types.each do |type| %>
              <li class="list-inline-item"><%= type.gsub('-', ' ') %></li>
            <% end %>
          </ul>
        <% end %>
      <ul class="list-unstyled">
        <% unless @shipment.shipper_contact_name.blank? %>
          <li><%= @shipment.shipper_contact_name %></li>
        <% end %>
        <% unless @shipment.shipper_contact_phone.blank? %>
          <li><%= link_to @shipment.shipper_contact_phone.phony_formatted, "tel:#{@shipment.shipper_contact_phone.phony_formatted}" %></li>
        <% end %>
        <% unless @shipment.shipper_contact_email.blank? %>
          <li><%= link_to @shipment.shipper_contact_email, "mailto:#{@shipment.shipper_contact_email}" %></li>
        <% end %>
      </ul>
      <address>
        <%= @shipment.shipper_name %>
        <br>
        <%= @shipment.shipper_address.pretty('<br>').html_safe %>
      </address>
      <ul class="list-inline list-unstyled">
        <li class="list-inline-item"><%= link_to icon('brands', 'google', 'Map'), "https://www.google.com/maps/search/?api=1&query=#{URI.encode_www_form_component(@shipment.shipper_address.proper(', '))}", target: '_blank' %></li>
        <li class="list-inline-item"><%= link_to icon('brands', 'apple', 'Map'), "https://maps.apple.com/?address=#{URI.encode_www_form_component(@shipment.shipper_address.proper(', '))}", target: '_blank' %></li>
      </ul>
      <% if @shipment.lift_gate_pickup? %><p>LG</p><% end %>
    </div>
  <% end %>

  <% cache [@shipment, @shipment.receiver_address] do %>
    <div class="col-sm-3">
      <p class="col-title"><%= icon 'solid', 'cart-arrow-down', 'Receiver' %></p>
      <% unless @shipment.receiver_address.types.blank? %>
        <ul class="list-inline list-unstyled text-muted text-uppercase">
          <% @shipment.receiver_address.types.each do |type| %>
            <li class="list-inline-item"><%= type.gsub('_', ' ') %></li>
          <% end %>
        </ul>
      <% end %>
      <ul class="list-unstyled">
        <% unless @shipment.receiver_contact_name.blank? %>
          <li><%= @shipment.receiver_contact_name %></li>
        <% end %>
        <% unless @shipment.receiver_contact_phone.blank? %>
          <li><%= link_to @shipment.receiver_contact_phone.phony_formatted, "tel:#{@shipment.receiver_contact_phone.phony_formatted}" %></li>
        <% end %>
        <% unless @shipment.receiver_contact_email.blank? %>
          <li><%= link_to @shipment.receiver_contact_email, "mailto:#{@shipment.receiver_contact_email}" %></li>
        <% end %>
      </ul>
      <address>
        <%= @shipment.receiver_name %>
        <br>
        <%= @shipment.receiver_address.pretty('<br>').html_safe %>
      </address>

      <ul class="list-inline list-unstyled">
        <li class="list-inline-item">
          <%= link_to icon('brands', 'google', 'Map'), "https://www.google.com/maps/search/?api=1&query=#{URI.encode_www_form_component(@shipment.receiver_address.proper(', '))}", target: '_blank' %>
        </li>
        <li class="list-inline-item">
          <%= link_to icon('brands', 'apple', 'Map'), "https://maps.apple.com/?address=#{URI.encode_www_form_component(@shipment.receiver_address.proper(', '))}", target: '_blank' %>
        </li>
      </ul>

      <ul class="list-inline list-unstyled">
        <li class="list-inline-item">
          <%= link_to icon('brands', 'google', 'Directions'), "https://www.google.com/maps/search/?api=1&query=#{URI.encode_www_form_component(@shipment.shipper_address.proper(', '))}%20to%20#{URI.encode_www_form_component(@shipment.receiver_address.proper(', '))}", target: '_blank' %>
        </li>
        <li class="list-inline-item">
          <%= link_to icon('brands', 'apple', 'Directions'), "https://maps.apple.com/?saddr=#{URI.encode_www_form_component(@shipment.shipper_address.proper(', '))}&daddr=#{URI.encode_www_form_component(@shipment.receiver_address.proper(', '))}", target: '_blank' %>
        </li>
      </ul>
    </div>
  <% end %>

  <% cache [@shipment, 'schedule'] do %>
    <div class="col-sm-3">
      <p class="col-title"><%= icon 'solid', 'map-signs', 'Routing' %></p>
      <table class="table table-borderless table-condensed">
        <tbody>
          <tr>
            <th>Pickup</th>
            <td>
              <% unless @shipment.pickup_on.blank? %>
                <%= short_date @shipment.pickup_on, @shipment.shipper_address.time_zone %> between
              <% else %>
                Between
              <% end %>

              <% unless @shipment.pickup_hours_start_at.blank? or @shipment.pickup_hours_end_at.blank? %>
                <%= @shipment.pickup_hours_start_at %> and <%= @shipment.pickup_hours_end_at %> <small><%= @shipment.shipper_address.time_zone.tzinfo.abbr %></small>
              <% end %>
            </td>
          </tr>
          <tr class="<% unless @shipment.promised_delivery_by.blank? %>bg-danger<% end %>">
            <th>Promised</th>
            <td>
              <% if @shipment.promised_delivery_by.blank? %>
                Standard transit time
              <% else %>
                <%= short_date @shipment.promised_delivery_by, @shipment.receiver_address.time_zone %>
              <% end %>
              <% unless @shipment.delivery_hours_start_at.blank? or @shipment.delivery_hours_end_at.blank? %>
                between <%= @shipment.delivery_hours_start_at %> and <%= @shipment.delivery_hours_end_at %> <small><%= @shipment.shipper_address.time_zone.tzinfo.abbr %></small>
              <% end %>
            </td>
          </tr>
          <% unless @shipment.broker_carrier.blank? %>
            <% if @shipment.delivered_at.blank? %>
              <tr>
                <th>ETA</th>
                <td>
                  <%= short_date @shipment.delivery_eta_on, @shipment.receiver_address.time_zone %>
                  <% unless @shipment.delivery_hours_start_at.blank? or @shipment.delivery_hours_end_at.blank? %>
                    between <%= @shipment.delivery_hours_start_at %> and <%= @shipment.delivery_hours_end_at %> <small><%= @shipment.shipper_address.time_zone.tzinfo.abbr %></small>
                  <% end %>
                </td>
              </tr>
            <% else %>
              <tr>
                <th>Delivered</th>
                <td><%= short_date @shipment.delivered_at, @shipment.receiver_address.time_zone %></td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <div class="col-sm-3">
    <p class="col-title"><%= icon 'solid', 'sticky-note', 'Notes' %></p>
    <div class="notes">
      <% unless @shipment.broker_notes.blank? %>
        <%= simple_format @shipment.broker_notes %>
      <% end %>
      <% unless @shipment.customer_notes.blank? %>
        <%= simple_format @shipment.customer_notes %>
      <% end %>
      <% if @shipment.broker_notes.blank? and @shipment.customer_notes.blank? %>
        <p><em>No notes yet</em></p>
      <% end %>
    </div>

    <p class="col-title"><%= icon 'solid', 'dollar-sign', 'Value' %></p>
    <% if @shipment.value > 0 %>
      <ul class="list-unstyled">
        <li><%= humanized_money_with_symbol @shipment.value, no_cents_if_whole: false %></li>
        <li><%= humanized_money_with_symbol (@shipment.value / @shipment.total_weight), no_cents_if_whole: false %> per pound</li>
      </ul>
    <% else %>
      <p><em>Not provided</em></p>
    <% end %>
  </div>

  <div class="col-sm-6">
    <p class="col-title"><%= icon 'solid', 'map-pin', 'Tracking' %></p>
    <%= render 'tracking/tracking', shipment: @shipment, search_terminals_links: true %>
  </div>

  <div class="col-sm-6">
    <% if current_user.has_role?('dispatch') ||
          current_user.has_role?('accounting') ||
          (@shipment.broker_customer.present? && @shipment.broker_customer.sales_reps.include?(current_user))
    %>
      <%= render 'pricing', shipment: @shipment %>
      <%= render 'commissions', shipment: @shipment %>
    <% else %>
      <p>&nbsp;</p>
    <% end %>
  </div>
</div>

<p class="col-title"><%= icon 'solid', 'pallet', 'Freight' %></p>
<% if not @shipment.items.count == 0 %>
  <div class="table-responsive">
    <table class="table table-borderless table-striped table-hover">
      <thead>
        <tr>
          <th>Piece</th>
          <th>Description</th>
          <th>HZ<small class="text-muted">***</small></th>
          <th><small class="text-muted">inches</small><br>Dimensions</th>
          <th><small class="text-muted">lbs</small><br>Weight</th>
          <th><small class="text-muted">Declared</small><br>Class</th>
          <th><small class="text-muted">Auto</small><br>Class</th>
          <th>NMFC</th>
          <th><small class="text-muted">(L×W×H) inches ÷ 1,728</small><br>Cubic Ft</th>
          <th><small class="text-muted">lbs/cubic ft</small><br>Density</th>
        </tr>
      </thead>
      <tbody>
        <% @shipment.items.each do |item| %>
          <tr>
            <td><%= pluralize item.quantity, item.packaging.name %></td>
            <td><%= item.desc %></td>
            <td><% if item.hazmat %>✓<% end %></td>
            <td><% if item.l and item.w and item.h %><%= item.l %>x<%= item.w %>x<%= item.h %><% end %></td>
            <td>
              <% if item.quantity > 1 %>
                <%= number_with_delimiter(item.weight / item.quantity) %> per <%= item.packaging.name %>
              <% end %>
              <%= number_with_delimiter item.weight %> <% if item.quantity > 1 %>total<% end %>
            </td>
            <td><%= item.forced_freight_class %></td>
            <td><%= item.calculated_freight_class %></td>
            <td><%= item.nmfc %></td>
            <td><%= item.cubic_ft rounded: true %></td>
            <td><%= item.density rounded: true %></td>
          </tr>
        <% end %>
      </tbody>
      <tfoot>
        <tr class="bg-light font-weight-bold">
          <td><%= pluralize @shipment.total_pieces, 'piece' %></td>
          <td>&nbsp;</td>
          <td>&nbsp;</td>
          <td>
            <% if @shipment.linear_ft %>
              <span class="text-nowrap"><%= @shipment.linear_ft %> linear ft <small class="text-muted">*, **</small></span>
            <% end %>
          </td>
          <td><%= number_with_delimiter @shipment.total_weight %> lbs</td>
          <td>&nbsp;</td>
          <td>&nbsp;</td>
          <td>&nbsp;</td>
          <td>
            <% if @shipment.total_cubic_ft(rounded: true) %>
              <%= number_with_delimiter @shipment.total_cubic_ft(rounded: true) %> <small class="text-muted">*</small>
            <% end %>
          </td>
          <td>
            <% if @shipment.total_density(rounded: true) %>
              <%= number_with_delimiter @shipment.total_density(rounded: true) %> <small class="text-muted">*</small>
            <% end %>
          </td>
        </tr>
      </tfoot>
    </table>
    <p class="text-muted">
      <small>* Individual values shown may not match total shown as individual lines are rounded up, but totals are calculated precisely then rounded up ** Linear footage calculation assumes pallets can be rotated in any direction *** HZ indicates hazardous material</small>
    </p>
  </div>
<% end %>

<p class="col-title">BOL Instructions</p>
<%= simple_format @shipment.broker.default_bol_notes %>
<%= simple_format @shipment.broker_carrier.default_bol_notes unless @shipment.broker_carrier.blank? %>
<%= simple_format @shipment.broker_customer.default_bol_notes unless @shipment.broker_customer.blank? %>
<%= simple_format @shipment.bol_notes %>

<% if false %>
<% if current_user.has_role? 'accounts_receivable' or current_user.has_role? 'quoting' %>
  <h2>Easy Copy & Paste</h2>

  <div class="row">

    <% if current_user.has_role? 'quoting' %>
      <div class="col-sm-4">
        <p class="col-title">For Quoting</p>
<textarea class="form-control" data-action="click->clipboard#copy" data-controller="clipboard" rows="4" readonly>
Load <%= @shipment.load_id %>

Origin: <%= @shipment.shipper_address.city %>, <%= @shipment.shipper_address.region.abbreviation %>, <%= @shipment.shipper_address.zip_code %>
Destination: <%= @shipment.receiver_address.city %>, <%= @shipment.receiver_address.region.abbreviation %>, <%= @shipment.receiver_address.zip_code %>

<% unless @shipment.shipment_broker_accessorials.blank? %>
<% @shipment.shipment_broker_accessorials.each do |shipment_broker_accessorial| %>
<%= shipment_broker_accessorial.broker_accessorial.name %>
<% end %>
<% end %>

<% unless @shipment.items.empty? %>
<% @shipment.items.each do |item| %>
<%= item.quantity %> <%= item.packaging.name %> <%= item.desc %> <% if item.l and item.w and item.h %><%= item.l %>x<%= item.w %>x<%= item.h %><% end %> <%= item.calculated_freight_class %> <%= number_with_delimiter item.weight %> lbs
<% end %>
<% end %>
</textarea>
      </div>
    <% end %>

    <% if current_user.has_role? 'accounts_receivable' %>
      <div class="col-sm-4">
        <p class="col-title">For Invoicing</p>
<textarea class="form-control copyable" rows="4" readonly>
Load <%= @shipment.load_id %>

Shipper Ref: <%= @shipment.shipper_reference %>
PO Ref: <%= @shipment.customer_reference %>

Origin
<%= @shipment.shipper_name %>
<%= @shipment.shipper_address.pretty("\n") %>

Destination
<%= @shipment.receiver_name %>
<%= @shipment.receiver_address.pretty("\n") %>

<% unless @shipment.shipment_broker_accessorials.blank? %>
<% @shipment.shipment_broker_accessorials.each do |shipment_broker_accessorial| %>
<%= shipment_broker_accessorial.broker_accessorial.name %>
<% end %>
<% end %>

<% unless @shipment.items.empty? %>
<% @shipment.items.each do |item| %>
<%= item.quantity %> <%= item.packaging.name %> <%= item.desc %> <% if item.l and item.w and item.h %><%= item.l %>x<%= item.w %>x<%= item.h %><% end %> <%= item.forced_freight_class ? item.forced_freight_class : item.calculated_freight_class %> <%= number_with_delimiter item.weight %> lbs
<% end %>
<% end %>
</textarea>
      </div>
    <% end %>

  </div>
<% end %>
<% end %>