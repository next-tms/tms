<% unless payment_transactions.blank? %>
  <div class="table-responsive">
    <table class="table table-condensed table-borderless table-striped table-hover h-100">
      <thead>
        <tr>
          <th>Carrier</th>
          <th>Payment</th>
          <th>Due</th>
          <th>Pro</th>
          <th>Balance</th>
          <th>Variance</th>
          <th>Pay</th>
          <th>Remarks</th>
        </tr>
      </thead>
      <tbody>
        <% payment_transactions.each do |payment_transaction| %>
          <tr class="<%= 'bg-warning' if payment_transaction.variance and payment_transaction.variance > 0 %>">
            <td><%= payment_transaction.broker_carrier.carrier.name %></td>
            <td>
              <% unless payment_transaction.payment.blank? %>
                <%= link_to payment_transaction.payment.week, broker_payment_path(payment_transaction.payment) %>
              <% end %>
            </td>
            <td><%= short_date payment_transaction.due_on, current_user.time_zone %></td>
            <td><%= payment_transaction.pro %></td>
            <td><%= humanized_money_with_symbol payment_transaction.balance, no_cents_if_whole: false %></td>
            <td>
              <% unless payment_transaction.shipment.blank? %>
                <%= humanized_money_with_symbol payment_transaction.variance, no_cents_if_whole: false %>
              <% end %>
            </td>
            <td><%= humanized_money_with_symbol payment_transaction.paid, no_cents_if_whole: false %></td>
            <td><%= payment_transaction.notes %>
          </tr>
        <% end %>
      </tbody>
      <tfoot>
        <tr>
          <th>&nbsp;</th>
          <th>&nbsp;</th>
          <th>&nbsp;</th>
          <th><%= humanized_money_with_symbol payment_transactions.map(&:balance).inject(Money.new(0)) { |sum, balance| (sum = sum + balance) unless balance.blank? }, no_cents_if_whole: false %></th>
          <th>&nbsp;</th>
          <th><%= humanized_money_with_symbol payment_transactions.map(&:variance).inject(Money.new(0)) { |sum, variance| (sum = sum + variance) unless variance.blank? }, no_cents_if_whole: false %></th>
          <th><%= humanized_money_with_symbol payment_transactions.map(&:paid).inject(Money.new(0)) { |sum, paid| (sum = sum + paid) unless paid.blank? }, no_cents_if_whole: false %></th>
          <th>&nbsp;</th>
        </tr>
      </tfoot>
    </table>
  </div>
<% else %>
  <div class="section">
    <p><em>Nothing to show</em></p>
  </div>
<% end %>