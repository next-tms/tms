<%= bootstrap_form_with(
      control_col: 'col-sm-8',
      data: { controller: 'highlightable' },
      id: 'shipment-transit-form',
      label_col: 'col-sm-6 col-md-4',
      layout: :horizontal,
      model: [:broker, shipment],
      url: update_transit_broker_shipment_path(shipment),
    ) do |f| %>
  <span data-highlightable-target="attr" data-attr-name="<%= params[:attr] %>">
  <div class="row">

    <div class="col-sm-6 col-md-4">
      <p class="col-title"><%= icon 'solid', 'truck', 'Carrier' %>
      <div class="form-group row">
        <label class="col-form-label col-sm-6 col-md-4">Carrier</label>
        <div class="col-sm-8">
          <% broker_carriers = shipment.eligible_broker_carriers(user_type: :broker) %>
          <% if shipment.broker_carrier.present? && broker_carriers.exclude?(shipment.broker_carrier) %>
            <% broker_carriers += [shipment.broker_carrier] %>
          <% end %>

          <%= f.select :broker_carrier_id,
                       broker_carriers.collect { |broker_carrier| [ broker_carrier.broker_customer_specific_name, broker_carrier.id ] }.sort,
                       {
                         label: 'Carrier',
                         hide_label: true,
                         include_blank: true,
                         help: 'For manual quotes',
                         wrapper: false
                       },
                       class: 'form-select'
          %>

          <% if shipment.broker_carrier&.carrier&.acts_as_broker? %>
            <%= f.select :tracking_carrier_id,
                         Carrier.order(:name).collect { |carrier| [ carrier.name, carrier.id ] },
                         {
                           help: 'For tracking',
                           hide_label: true,
                           include_blank: true,
                           label: 'Carrier',
                           wrapper: false
                         },
                         class: 'form-select'
            %>
          <% end %>
          <%= link_to 'Find Rates', quote_broker_shipment_path(shipment), class: 'btn btn-primary mt-2' %>
        </div>
      </div>
      <%= f.text_field :quoted_delivery_by, label: 'Quoted ETA', autocomplete: 'off', data: flatpickr_data, value: maybe_in_time_zone(datetime: f.object.quoted_delivery_by, time_zone: f.object.receiver_address.time_zone) %>
      <%= f.text_field :quote_id, label: 'Quote #', autocomplete: 'off' %>
      <%= render 'pro_fields', f: f %>
      <%= f.text_field :carrier_cost, prepend: '$', label: 'Cost', data: money_controller_data, autocomplete: 'off' %>
    </div>

    <div class="col-sm-6 col-md-4">
      <p class="col-title"><%= icon 'solid', 'truck-loading', 'Pickup' %></p>
        <%= f.text_field :pickup_on, label: 'Pickup On', autocomplete: 'off', data: flatpickr_data, value: maybe_in_time_zone(datetime: f.object.pickup_on, time_zone: f.object.shipper_address.time_zone) %>
      <% unless shipment.broker_carrier.blank? %>
        <%= highlightable_element :dispatched_at do %>
          <%= f.text_field :dispatched_at, label: 'Dispatched', autocomplete: 'off', data: flatpickr_datetime_data(f.object.dispatched_at, f.object.shipper_address.time_zone), value: maybe_in_time_zone(datetime: f.object.dispatched_at, time_zone: f.object.shipper_address.time_zone) %>
        <% end %>

        <%= render 'pickup_confirmation_fields', f: f %>

        <%= f.text_field :pickup_driver_assigned_at, label: 'Assigned', autocomplete: 'off', data: flatpickr_datetime_data(f.object.pickup_driver_assigned_at, f.object.shipper_address.time_zone), value: maybe_in_time_zone(datetime: f.object.pickup_driver_assigned_at, time_zone: f.object.shipper_address.time_zone) %>
        <%= f.text_field :pickup_eta_at, label: 'ETA', data: flatpickr_data(override: { flatpickr_enable_time: true, flatpickr_no_calendar: true, flatpickr_date_format: 'h:i K' }), value: maybe_in_time_zone(datetime: f.object.pickup_eta_at, time_zone: f.object.shipper_address.time_zone) %>

        <%= highlightable_element :picked_up_at do %>
          <%= f.text_field :picked_up_at, label: 'Picked Up', autocomplete: 'off', data: flatpickr_datetime_data(f.object.picked_up_at, f.object.shipper_address.time_zone), value: maybe_in_time_zone(datetime: f.object.picked_up_at, time_zone: f.object.shipper_address.time_zone) %>
        <% end %>

        <%= highlightable_element :departed_origin_terminal_at do %>
          <%= f.text_field :departed_origin_terminal_at, label: 'Departed', autocomplete: 'off', data: flatpickr_datetime_data(f.object.departed_origin_terminal_at, f.object.shipper_address.time_zone), value: maybe_in_time_zone(datetime: f.object.departed_origin_terminal_at, time_zone: f.object.shipper_address.time_zone) %>
        <% end %>

        <% unless shipment.shipper_address.time_zone.blank? %>
          <p class="text-muted text-end">Pickup times in <%= shipment.shipper_address.time_zone.tzinfo.abbr %></p>
        <% end %>
      <% end %>
    </div>

    <div class="col-sm-6 col-md-4">
      <p class="col-title"><%= icon 'solid', 'people-carry', 'Delivery' %></p>
      <%= f.text_field :promised_delivery_by, label: 'Promised By', autocomplete: 'off', data: flatpickr_datetime_data(f.object.promised_delivery_by, f.object.receiver_address.time_zone), value: maybe_in_time_zone(datetime: f.object.promised_delivery_by, time_zone: f.object.receiver_address.time_zone) %>
      <% unless shipment.broker_carrier.blank? %>
        <%= f.text_field :delivery_eta_on, label: 'ETA', autocomplete: 'off', data: flatpickr_data, value: maybe_in_time_zone(datetime: f.object.delivery_eta_on, time_zone: f.object.receiver_address.time_zone) %>
        <%= highlightable_element :out_for_delivery_at do %>
          <%= f.text_field :out_for_delivery_at, label: 'Out for delivery', autocomplete: 'off', data: flatpickr_datetime_data(f.object.out_for_delivery_at, f.object.receiver_address.time_zone), value: maybe_in_time_zone(datetime: f.object.out_for_delivery_at, time_zone: f.object.receiver_address.time_zone) %>
        <% end %>

        <%= f.text_field :lost_on, label: 'Lost On', autocomplete: 'off', data: flatpickr_data %>
        <%= f.text_field :pending_appointment_since, label: 'Appointment Pending Since', autocomplete: 'off', data: flatpickr_data, value: maybe_in_time_zone(datetime: f.object.pending_appointment_since, time_zone: f.object.receiver_address.time_zone) %>

        <%= highlightable_element :delivery_appointment_on do %>
          <%= f.text_field :delivery_appointment_on, label: 'Appointment On', autocomplete: 'off', data: flatpickr_data, value: maybe_in_time_zone(datetime: f.object.delivery_appointment_on, time_zone: f.object.receiver_address.time_zone) %>
        <% end %>

        <%= highlightable_element :delivery_appointment_at do %>
          <%= f.text_field :delivery_appointment_at, label: 'Appointment At', autocomplete: 'off', data: flatpickr_datetime_data(f.object.delivery_appointment_at, f.object.receiver_address.time_zone), value: maybe_in_time_zone(datetime: f.object.delivery_appointment_at, time_zone: f.object.shipper_address.time_zone) %>
        <% end %>

        <%= highlightable_element :delivered_at do %>
          <%= f.text_field :delivered_at, label: 'Delivered', autocomplete: 'off', data: flatpickr_datetime_data(f.object.delivered_at, f.object.receiver_address.time_zone), value: maybe_in_time_zone(datetime: f.object.delivered_at, time_zone: f.object.shipper_address.time_zone) %>
        <% end %>

        <% unless shipment.receiver_address.time_zone.blank? %>
          <p class="text-muted text-end">Delivery times in <%= shipment.receiver_address.time_zone.tzinfo.abbr %></p>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="form-group">
    <% if shipment.whodunnit('total_charges_cents')&.customer? %>
      <%= f.submit 'Save', data: { turbo_confirm: "Are you sure to update pricing set by the customer?" }, class: "btn btn-success mt-2"  %>
    <% else %>
      <%= f.submit class: 'btn btn-success mt-2', value: 'Save' %>
    <% end %>
  </div>
<% end %>
