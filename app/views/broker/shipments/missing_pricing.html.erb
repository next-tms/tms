<% provide :title, 'Missing Pricing — Shipments' %>
<% provide :menu, render('menu') %>
<% provide :auto_refresh, 'yes' %>

<div class="page-header">
  <h1>Shipments</h1>
  <p class="lead">Missing Pricing</p>
</div>

<%= turbo_frame_tag :shipments do %>
  <%= render 'broker/shipments/show_many', table: shipment_show_many_table(shipments: @shipments, td_names: ['id', 'status', 'total_cost', 'total_charges', 'shipper', 'receiver', 'broker_carrier', 'pro', 'picked_up_at', 'delivery_eta_on', 'promised_delivery_by', 'size']) %>
<% end %>
