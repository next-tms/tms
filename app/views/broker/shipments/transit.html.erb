<% provide :title, "Routing — Load #{@shipment.load_id}" %>
<% provide :menu, render('menu') %>
<% provide :no_cache, 'yes' %>

<%= render 'header', page_title: 'Routing' %>

<%= bootstrap_form_with(model: [:broker, @shipment], path: broker_shipment_path(@shipment), layout: :horizontal, label_col: 'col-sm-4', control_col: 'col-sm-8') do |f| %>
  <div class="row">

    <div class="col-sm-4">
      <p class="col-title"><%= icon 'fas', 'truck', 'Carrier' %>
      <div class="form-group row">
        <label class="col-form-label col-sm-4">Carrier</label>
        <div class="col-sm-8">
          <%= f.select :broker_carrier_id, current_user.broker.broker_carriers.includes(:carrier).collect { |broker_carrier| [ broker_carrier.broker_customer_specific_name, broker_carrier.id ] }.sort, { label: 'Carrier', hide_label: true, help: 'For manual quotes', selected: (@shipment.broker_carrier ? @shipment.broker_carrier.id : nil) }, class: 'custom-select' %>
          <% if not @shipment.broker_carrier.blank? and @shipment.broker_carrier.carrier.acts_as_broker? %>
            <%= f.select :tracking_carrier_id, Carrier.all.collect { |carrier| [ carrier.name, carrier.id ] }.sort, { label: 'Carrier', hide_label: true, help: 'For tracking', selected: (@shipment.tracking_carrier ? @shipment.tracking_carrier.id : nil) }, class: 'custom-select' %>
          <% end %>
          <%= link_to 'Find Rates', quote_broker_shipment_path(@shipment), class: 'btn btn-light' %>
        </div>
      </div>
      <%= f.text_field :quoted_delivery_by, label: 'Quoted ETA', autocomplete: 'off', class: 'flatpickr', value: maybe_in_time_zone(datetime: @shipment.quoted_delivery_by, time_zone: @shipment.receiver_address.time_zone), append: link_to(icon('fas', 'trash'), '#', class: 'clear-flatpickr text-danger') %>
      <%= f.text_field :quote_id, label: 'Quote Ref', autocomplete: 'off' %>
      <%= f.text_field :pro, label: 'Pro', autocomplete: 'off' %>
      <% if not @shipment.broker_carrier.blank? and @shipment.broker_carrier.carrier.acts_as_broker? %>
        <%= f.text_field :tracking_carrier_pro, label: 'Carrier Pro', autocomplete: 'off' %>
      <% end %>
      <%= f.text_field :carrier_cost, prepend: '$', label: 'Cost', class: 'money', autocomplete: 'off' %>
    </div>

    <div class="col-sm-4">
      <p class="col-title"><%= icon 'fas', 'truck-loading', 'Pickup' %></p>
        <%= f.text_field :pickup_on, label: 'Pickup On', autocomplete: 'off', class: 'flatpickr-date', value: maybe_in_time_zone(datetime: @shipment.pickup_on, time_zone: @shipment.shipper_address.time_zone), append: link_to(icon('fas', 'trash'), '#', class: 'clear-flatpickr text-danger') %>
      <% unless @shipment.broker_carrier.blank? %>
        <%= f.text_field :dispatched_at, label: 'Dispatched', autocomplete: 'off', class: 'flatpickr', value: maybe_in_time_zone(datetime: @shipment.dispatched_at, time_zone: @shipment.shipper_address.time_zone), append: link_to(icon('fas', 'trash'), '#', class: 'clear-flatpickr text-danger') %>
        <%= f.text_field :pickup_confirmation, label: (@shipment.broker_carrier.carrier.acts_as_broker? ? 'Pickup Ref' : 'Broker Pickup Ref'), autocomplete: 'off' %>
        <% if not @shipment.broker_carrier.blank? and @shipment.broker_carrier.carrier.acts_as_broker? %>
          <%= f.text_field :tracking_carrier_pickup_confirmation, label: 'Carrier Pickup Ref', autocomplete: 'off' %>
        <% end %>
        <%= f.text_field :pickup_driver_assigned_at, label: 'Assigned', autocomplete: 'off', class: 'flatpickr', value: maybe_in_time_zone(datetime: @shipment.pickup_driver_assigned_at, time_zone: @shipment.shipper_address.time_zone), append: link_to(icon('fas', 'trash'), '#', class: 'clear-flatpickr text-danger') %>
        <%= f.text_field :pickup_eta_at, label: 'ETA', class: 'timepicker' %>
        <%= f.text_field :picked_up_at, label: 'Pickup', autocomplete: 'off', class: 'flatpickr', value: maybe_in_time_zone(datetime: @shipment.picked_up_at, time_zone: @shipment.shipper_address.time_zone), append: link_to(icon('fas', 'trash'), '#', class: 'clear-flatpickr text-danger') %>
        <%= f.text_field :departed_origin_terminal_at, label: 'Departed', autocomplete: 'off', class: 'flatpickr', value: maybe_in_time_zone(datetime: @shipment.departed_origin_terminal_at, time_zone: @shipment.shipper_address.time_zone), append: link_to(icon('fas', 'trash'), '#', class: 'clear-flatpickr text-danger') %>
        <% unless @shipment.shipper_address.time_zone.blank? %>  
          <p class="text-muted text-right">Pickup times in <%= @shipment.shipper_address.time_zone.abbr(Date.current) %></p>
        <% end %>
      <% end %>
    </div>

    <div class="col-sm-4">
      <p class="col-title"><%= icon 'fas', 'people-carry', 'Delivery' %></p>
      <%= f.text_field :promised_delivery_by, label: 'Promised By', autocomplete: 'off', class: 'flatpickr', value: maybe_in_time_zone(datetime: @shipment.promised_delivery_by, time_zone: @shipment.receiver_address.time_zone), append: link_to(icon('fas', 'trash'), '#', class: 'clear-flatpickr text-danger') %>
      <% unless @shipment.broker_carrier.blank? %>
        <%= f.text_field :deliver_by, label: 'ETA', autocomplete: 'off', class: 'flatpickr-date', value: maybe_in_time_zone(datetime: @shipment.deliver_by, time_zone: @shipment.receiver_address.time_zone), append: link_to(icon('fas', 'trash'), '#', class: 'clear-flatpickr text-danger') %>
        <%= f.text_field :out_for_delivery_at, label: 'Out for delivery', autocomplete: 'off', class: 'flatpickr-datetime-max-today', value: maybe_in_time_zone(datetime: @shipment.out_for_delivery_at, time_zone: @shipment.receiver_address.time_zone), append: link_to(icon('fas', 'trash'), '#', class: 'clear-flatpickr text-danger') %>
        <%= f.text_field :pending_appointment_since, label: 'Appointment Pending Since', autocomplete: 'off', class: 'flatpickr-date', value: maybe_in_time_zone(datetime: @shipment.pending_appointment_since, time_zone: @shipment.receiver_address.time_zone), append: link_to(icon('fas', 'trash'), '#', class: 'clear-flatpickr text-danger') %>
        <%= f.text_field :delivery_appointment_on, label: 'Appointment On', autocomplete: 'off', class: 'flatpickr-date', value: maybe_in_time_zone(datetime: @shipment.delivery_appointment_on, time_zone: @shipment.receiver_address.time_zone), append: link_to(icon('fas', 'trash'), '#', class: 'clear-flatpickr text-danger') %>
        <%= f.text_field :delivery_appointment_at, label: 'Appointment At', autocomplete: 'off', class: 'flatpickr', value: maybe_in_time_zone(datetime: @shipment.delivery_appointment_at, time_zone: @shipment.shipper_address.time_zone), append: link_to(icon('fas', 'trash'), '#', class: 'clear-flatpickr text-danger') %>
        <%= f.text_field :delivered_at, label: 'Delivered', autocomplete: 'off', class: 'flatpickr-datetime-max-today', value: maybe_in_time_zone(datetime: @shipment.delivered_at, time_zone: @shipment.shipper_address.time_zone), append: link_to(icon('fas', 'trash'), '#', class: 'clear-flatpickr text-danger') %>
        <% unless @shipment.receiver_address.time_zone.blank? %>
          <p class="text-muted text-right">Delivery times in <%= @shipment.receiver_address.time_zone.abbr(Date.current) %></p>
        <% end %>
      <% end %>
    </div>

  </div>

  <div class="form-group">
    <%= f.submit class: 'btn btn-primary mt-2', value: 'Save' %>
  </div>
<% end %>