<% provide :title, "Pricing — Load #{@shipment.load_id}" %>

<%= render 'member_header' %>
<h2>Pricing</h2>

<% if @shipment.receivables.any? %>
  <div class="alert alert-danger mt-2">
    <p class="lead">Already invoiced</p>
    <p>
      Updating pricing below will not update any existing associated invoices.
      Only users with accounting privileges may make further changes.
    </p>
  </div>
<% end %>

<% if @shipment.applied_rate.present? && @total_charges_updated_by.present? %>
  <% if @total_charges_updated_by&.customer? %>
    <%= render 'layouts/message',
        classes: 'alert-danger',
        title: "#{@shipment.broker_customer.customer.name} set these charges",
        message: <<~MESSAGE
          #{humanized_money_with_symbol(@shipment.total_charges, no_cents_if_whole: false)}
          was selected from a quote they found online.
        MESSAGE
    %>
  <% else %>
    <%= render 'layouts/message',
        classes: 'alert-info',
        title: "#{Setting.value!(:name)} set these charges",
        message: <<~MESSAGE
          #{@total_charges_updated_by.full_name} last updated the total charges to
          #{humanized_money_with_symbol(@shipment.total_charges, no_cents_if_whole: false)}.
        MESSAGE
    %>
  <% end %>
<% end %>

<% if @shipment.receivables.blank? || current_user.role?(:accounts_receivable) %>
  <%= bootstrap_form_with(model: [:broker, @shipment], path: broker_shipment_path(@shipment)) do |f| %>
    <p class="col-title"><%= @shipment.broker_carrier.blank? ? 'Carrier' : @shipment.broker_carrier.carrier.name %></p>
    <div class="row gy-2 gx-3 align-items-center mb-4">
      <div class="col-auto">
        <%= f.text_field :carrier_cost, prepend: '$', data: money_controller_data, autocomplete: 'off' %>
      </div>

      <div class="col-auto">
        <%= f.text_field :carrier_charge, prepend: '$', data: money_controller_data, autocomplete: 'off' %>
      </div>
    </div>

    <p class="col-title">Services</p>
    <div data-controller="nested-form" data-nested-form-wrapper-selector-value=".tracking-event-form-wrapper">
      <template data-nested-form-target="template">
        <%= f.fields_for :shipment_broker_accessorials, ShipmentBrokerAccessorial.new, child_index: 'NEW_RECORD' do |shipment_broker_accessorials_form| %>
          <%= render 'shipments/broker_accessorial_form', f: shipment_broker_accessorials_form %>
        <% end %>
      </template>

      <%= f.fields_for :shipment_broker_accessorials do |shipment_broker_accessorials_form| %>
        <%= render 'shipments/broker_accessorial_form', f: shipment_broker_accessorials_form %>
      <% end %>

      <div data-nested-form-target="target"></div>

      <%= link_to icon('solid', 'plus', 'Add'), '#', data: { action: 'nested-form#add' }, class: 'btn btn-light' %>
    </div>

    <%= f.form_group do %>
      <% if @total_charges_updated_by&.customer? %>
        <%= f.submit 'Save', data: { turbo_confirm: "Are you sure to update pricing set by the customer?" }, class: "btn btn-primary"  %>
      <% else %>
        <%= f.submit class: 'btn btn-primary', value: 'Save' %>
      <% end %>
    <% end %>
  <% end %>
<% end %>