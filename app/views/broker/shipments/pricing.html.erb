<% provide :title, "Pricing — Load #{@shipment.load_id}" %>
<% provide :menu, render('menu') %>
<% provide :no_cache, 'yes' %>

<%= render 'header', page_title: 'Pricing' %>

<%= bootstrap_form_with(model: [:broker, @shipment], path: broker_shipment_path(@shipment)) do |f| %>
  <h2 class="h5"><%= @shipment.broker_carrier.blank? ? 'Carrier' : @shipment.broker_carrier.carrier.name %></h2>
  <div class="form-inline form-row mb-2">
    <%= f.text_field :carrier_cost, prepend: '$', label: 'Cost', data: money_controller_data, autocomplete: 'off' %>
    <%= f.text_field :carrier_charge, prepend: '$', label: 'Charge', data: money_controller_data, autocomplete: 'off' %>
  </div>

  <h2 class="h5">Services</h2>
  <%= f.fields_for :shipment_broker_accessorials do |shipment_broker_accessorials_form| %>
    <%= render 'shipment_broker_accessorial_fields', f: shipment_broker_accessorials_form %>
  <% end %>
  <%= link_to_add_fields icon('fas', 'plus', 'Add'), f, :shipment_broker_accessorials, 'btn btn-light' %>

  <div class="form-group mt-2">
    <%= f.submit class: 'btn btn-primary', value: 'Save' %>
  </div>
<% end %>
