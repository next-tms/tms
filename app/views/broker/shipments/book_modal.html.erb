<%= provide :title, 'Customer' %>

<%= bootstrap_form_with(model: [:broker, @shipment], method: :patch) do |f| %>
  <%= f.hidden_field :quote_only, value: false %>

  <% if defined?(@rate_uid) %>
    <%= f.hidden_field :rate_uid, value: @applied_rate_uid %>
  <% end %>

  <%= f.select :broker_customer_id, @broker_customers.collect { |c| [c.customer.name, c.id] }, { include_blank: false, label: 'Customer' }, class: 'form-select' %>
  <%= f.submit 'Book', data: { turbo: false }, class: 'btn btn-primary' %>
<% end %>
