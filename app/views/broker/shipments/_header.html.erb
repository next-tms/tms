<div class="page-header bg-light p-4 mb-4">
  <h1 class="mb-6">Shipments</h1>

  <table class="table table-borderless">
    <thead>
      <tr>
        <th>Inbox</th>
        <th>Quoted</th>
        <th>Dispatched</th>
        <th>In Transit</th>
        <th></th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td class="display-6">
          <%= link_to current_user.shipments.pending_quotation.size, broker_shipments_pending_quotation_path, class: 'shipments-pending-quotation' %>
        </td>
        <td class="display-6">
          <%= link_to current_user.shipments.pending_dispatch.size, broker_shipments_pending_dispatch_path, class: 'shipments-pending-dispatch' %>
        </td>
        <td class="display-6">
          <%= link_to current_user.shipments.pending_pickup.size, broker_shipments_pending_pickup_path, class: 'shipments-pending-pickup' %>
        </td>
        <td class="display-6">
          <%= link_to current_user.shipments.pending_delivery.size, broker_shipments_pending_delivery_path, class: 'shipments-pending-delivery' %>
        </td>
        <td class="display-6">
          <%= link_to icon('solid', 'plus', 'Add'), new_broker_shipment_path, class: 'btn' %>
          <%= link_to icon('solid', 'plus', 'Fast Quote'), broker_quote_only_path, class: 'btn' %>
        </td>
      </tr>
    </tbody>
  </table>

  <%= render 'menu' %>
</div>
