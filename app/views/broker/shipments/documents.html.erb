<% provide :title, "Documents — Load #{@shipment.load_id}" %>
<% provide :no_cache, 'yes' %>

<%= render 'header', page_title: 'Documents' %>
<%= render 'member_menu' %>

<% if !@shipment.broker_bol_valid? && @shipment.pro.blank? && @shipment.broker_carrier&.as_interstellar_carrier&.bol_requires_tracking_number? %>
  <div class="alert alert-warning">
    <p class="lead">Missing pro number</p>
    <p>Some documents for this shipment were not generated because <%= @shipment.broker_carrier.carrier.name %> requires the pro number to be entered first.</p>
  </div>
<% end %>

<div class="row">
  <div class="col col-md-8">
    <div class="table-responsive">
      <table class="table table-borderless table-striped">
        <thead>
          <tr>
            <th>Author</th>
            <th>Kind</th>
            <th></th>
            <th></th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% if @shipment.broker_quote_valid? %>
            <tr>
              <td><%= @shipment.broker.name %></td>
              <td>Quote</td>
              <td><%= link_to icon('fas', 'eye', 'View'), rails_blob_path(@shipment.broker_quote, disposition: 'preview'), 'data-turquoteinks': 'false', target: '_blank' %></td>
              <td><%= link_to icon('fas', 'file-download', 'Download'), rails_blob_path(@shipment.broker_quote, disposition: 'attachment'), 'data-turquoteinks': 'false', download: "#{@shipment.load_id} Quote.pdf" %></td>
              <td><%= link_to icon('fas', 'paper-plane', 'Send'), send_document_broker_shipment_path(@shipment, shipment_method: 'broker_quote'), data: { 'turbo-frame': 'modal' } %></td>
            </tr>
          <% end %>

          <% if @shipment.broker_bol_valid? %>
            <tr>
              <td><%= @shipment.broker.name %></td>
              <td>Bill of Lading</td>
              <td><%= link_to icon('fas', 'eye', 'View'), rails_blob_path(@shipment.broker_bol, disposition: 'preview'), 'data-turbo': 'false', target: '_blank' %></td>
              <td><%= link_to icon('fas', 'file-download', 'Download'), rails_blob_path(@shipment.broker_bol, disposition: 'attachment'), 'data-turbo': 'false', download: "#{@shipment.load_id} BOL.pdf" %></td>
              <td><%= link_to icon('fas', 'paper-plane', 'Send'), send_document_broker_shipment_path(@shipment, shipment_method: 'broker_bol'), data: { 'turbo-frame': 'modal' } %></td>
            </tr>
          <% end %>

          <% if @shipment.broker_dispatch_sheet_valid? %>
            <tr>
              <td><%= @shipment.broker.name %></td>
              <td>Dispatch Sheet</td>
              <td><%= link_to icon('fas', 'eye', 'View'), rails_blob_path(@shipment.broker_dispatch_sheet, disposition: 'preview'), 'data-turquoteinks': 'false', target: '_blank' %></td>
              <td><%= link_to icon('fas', 'file-download', 'Download'), rails_blob_path(@shipment.broker_dispatch_sheet, disposition: 'attachment'), 'data-turquoteinks': 'false', download: "#{@shipment.load_id} Dispatch Sheet.pdf" %></td>
              <td><%= link_to icon('fas', 'paper-plane', 'Send'), send_document_broker_shipment_path(@shipment, shipment_method: 'broker_dispatch_sheet'), data: { 'turbo-frame': 'modal' } %></td>
            </tr>
          <% end %>

          <% unless @shipment.carrier_bol.blank? %>
            <tr>
              <td><%= @shipment.broker_carrier.carrier.name %></td>
              <td>Bill of Lading</td>
              <td><%= link_to icon('fas', 'eye', 'View'), rails_blob_path(@shipment.carrier_bol, disposition: 'preview'), 'data-turbo': 'false', target: '_blank' %></td>
              <td><%= link_to icon('fas', 'file-download', 'Download'), rails_blob_path(@shipment.carrier_bol, disposition: 'attachment'), 'data-turbo': 'false', download: "#{@shipment.load_id} BOL - #{@shipment.broker_carrier.carrier.name}.pdf" %></td>
              <td><%= link_to icon('fas', 'paper-plane', 'Send'), send_document_broker_shipment_path(@shipment, shipment_method: 'carrier_bol'), data: { 'turbo-frame': 'modal' } %></td>
            </tr>
          <% end %>

          <% unless @shipment.carrier_pod.blank? %>
            <tr>
              <td><%= @shipment.broker_carrier.carrier.name %></td>
              <td>Proof of Delivery</td>
              <td><%= link_to icon('fas', 'eye', 'View'), rails_blob_path(@shipment.carrier_pod, disposition: 'preview'), target: '_blank' %></td>
              <td><%= link_to icon('fas', 'file-download', 'Download'), rails_blob_path(@shipment.carrier_pod, disposition: 'attachment'), download: "#{@shipment.load_id} POD.pdf" %></td>
              <td><%= link_to icon('fas', 'paper-plane', 'Send'), send_document_broker_shipment_path(@shipment, shipment_method: 'carrier_pod'), data: { 'turbo-frame': 'modal' } %></td>
            </tr>
          <% end %>
        <tbody>
      </table>
    </div>
  </div>
</div>
