<% provide :title, "Documents — Load #{@shipment.load_id}" %>

<%= turbo_stream_from @shipment, :documents %>

<%= render 'member_header' %>

<% undocumentable_reasons = @shipment.undocumentable_reasons %>
<% if undocumentable_reasons.values.any? { |value| value.any? } %>
  <div class="alert alert-warning">
    <p class="lead">
      <%= 'Document'.pluralize(undocumentable_reasons.keys.count) %>
      pending
    </p>

    <% undocumentable_reasons.each do |documentable_type, undocumentable_reasons| %>
      <% next if undocumentable_reasons.empty? %>

      <p><%= Shipment.human_attribute_name(documentable_type).downcase.capitalize %> hasn’t been created because:</p>

      <ul>
        <% undocumentable_reasons.sort.each do |undocumentable_reason| %>
          <li><%= undocumentable_reason %></li>
        <% end %>
      </ul>
    <% end %>
  </div>
<% end %>

<% this_dom_id = "broker_#{dom_id(@shipment)}" %>
<div id="<%="#{this_dom_id}_document_notification"%>"></div>

<div class="table-responsive" data-controller="highlightable">
  <span data-highlightable-target="attr" data-attr-name="<%= params[:attr] %>">
  <table class="table table-borderless table-bordered">
    <thead class="table-borderless">
      <tr>
        <th>Author</th>
        <th>Kind</th>
        <th></th>
        <th></th>
        <th></th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <%= highlightable_element :broker_quote, table_element: true do %>
        <%= render 'broker/shipments/documents/broker_quote', this_dom_id:, shipment: @shipment %>
      <% end %>

      <%= highlightable_element :broker_bol, table_element: true do %>
        <%= render 'broker/shipments/documents/broker_bol', this_dom_id:, shipment: @shipment %>
      <% end %>

      <%= render 'broker/shipments/documents/broker_label', this_dom_id:, shipment: @shipment %>

      <%= highlightable_element :broker_dispatch_sheet, table_element: true do %>
        <%= render 'broker/shipments/documents/broker_dispatch_sheet', this_dom_id:, shipment: @shipment %>
      <% end %>

      <%= render 'broker/shipments/documents/carrier_label', this_dom_id:, shipment: @shipment %>

      <% unless @shipment.broker_carrier&.carrier&.consider_bol_and_pod_documents_same? %>
        <%= highlightable_element :carrier_bol, table_element: true do %>
          <%= render 'broker/shipments/documents/carrier_bol', this_dom_id:, shipment: @shipment %>
        <% end %>
      <% end %>

      <%= highlightable_element :carrier_pod, table_element: true do %>
        <%= render 'broker/shipments/documents/carrier_pod', this_dom_id:, shipment: @shipment %>
      <% end %>

      <%= render 'broker/shipments/documents/broker_carrier_quote', this_dom_id:, shipment: @shipment %>
    </tbody>
  </table>
</div>
