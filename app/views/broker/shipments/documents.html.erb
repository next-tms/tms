<% provide :title, "Documents — Load #{@shipment.load_id}" %>

<%= turbo_stream_from @shipment, :documents %>

<%= render 'member_header' %>
<h2>Documents</h2>

<% if !@shipment.broker_bol_valid? && @shipment.pro.blank? && @shipment.broker_carrier&.bol_requires_tracking_number? %>
  <div class="alert alert-warning">
    <p class="lead">Missing pro number</p>
    <p>Some documents for this shipment were not generated because <%= @shipment.broker_carrier.carrier.name %> requires the pro number to be entered first.</p>
  </div>
<% end %>

<% if !@shipment.broker_bol_valid? && (@shipment.shipper_name.blank? || @shipment.receiver_name.blank?) %>
  <div class="alert alert-warning">
    <p class="lead">Missing shipper or receiver name</p>
    <p>Some documents for this shipment were not generated because the shipper or receiver name is blank.</p>
  </div>
<% end %>

<% if !@shipment.broker_bol_valid? && !(@shipment.shipper_address.full_address? && @shipment.receiver_address.full_address?) %>
  <div class="alert alert-warning">
    <p class="lead">Missing shipper or receiver address</p>
    <p>Some documents for this shipment were not generated because the shipper or receiver address is incomplete.</p>
  </div>
<% end %>

<% this_dom_id = dom_id(@shipment) %>
<div id="<%="#{this_dom_id}_document_notification"%>"></div>

<div class="table-responsive">
  <table class="table table-borderless table-bordered">
    <thead class="table-borderless">
      <tr>
        <th>Author</th>
        <th>Kind</th>
        <th></th>
        <th></th>
        <th></th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <%= render 'shipments/documents/broker_quote', this_dom_id:, shipment: @shipment %>
      <%= render 'shipments/documents/broker_bol', this_dom_id:, shipment: @shipment %>
      <%= render 'shipments/documents/broker_label', this_dom_id:, shipment: @shipment %>
      <%= render 'broker/shipments/documents/broker_dispatch_sheet', this_dom_id:, shipment: @shipment %>
      <%= render 'shipments/documents/carrier_label', this_dom_id:, shipment: @shipment %>
      <% unless @shipment.broker_carrier&.carrier&.consider_bol_and_pod_documents_same? %>
        <%= render 'shipments/documents/carrier_bol', this_dom_id:, shipment: @shipment %>
      <% end %>
      <%= render 'shipments/documents/carrier_pod', this_dom_id:, shipment: @shipment %>
      <%= render 'broker/shipments/documents/broker_carrier_quote', this_dom_id:, shipment: @shipment %>
    </tbody>
  </table>
</div>
