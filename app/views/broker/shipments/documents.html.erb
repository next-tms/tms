<% provide :title, "Documents — Load #{@shipment.load_id}" %>
<% provide :menu, render('menu') %>
<% provide :no_cache, 'yes' %>

<%= render 'header', page_title: 'Documents' %>

<div class="row">
  <div class="col col-md-6">
    <div class="table-responsive">
      <table class="table table-borderless table-striped">
        <thead>
          <tr>
            <th>Author</th>
            <th>Kind</th>
            <th></th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><%= current_user.broker.name %></td>
            <td>Bill of Lading</td>
            <td><%= link_to icon('fas', 'eye', 'View'), bol_document_broker_shipment_path(@shipment), 'data-turbolinks': 'false', target: '_blank' %></td>
            <td></td>
          </tr>
          <tr>
            <td><%= current_user.broker.name %></td>
            <td>Customer Quote</td>
            <td><%= link_to icon('fas', 'eye', 'View'), quote_document_broker_shipment_path(@shipment), 'data-turbolinks': 'false', target: '_blank' %></td>
            <td></td>
          </tr>
          <% unless @shipment.carrier_bol.blank? %>
            <tr>
              <td><%= @shipment.broker_carrier.carrier.name %></td>
              <td>Bill of Lading</td>
              <td><%= link_to icon('fas', 'eye', 'View'), rails_blob_path(@shipment.carrier_bol, disposition: 'preview'), 'data-turbolinks': 'false', target: '_blank' %></td>
              <td><%= link_to icon('fas', 'file-download', 'Download'), rails_blob_path(@shipment.carrier_bol, disposition: 'attachment'), 'data-turbolinks': 'false', download: "#{@shipment.load_id} BOL.pdf" %></td>
            </tr>
          <% end %>
          <% unless @shipment.carrier_pod.blank? %>
            <tr>
              <td><%= @shipment.broker_carrier.carrier.name %></td>
              <td>Proof of Delivery</td>
              <td><%= link_to icon('fas', 'eye', 'View'), rails_blob_path(@shipment.carrier_pod, disposition: 'preview'), target: '_blank' %></td>
              <td><%= link_to icon('fas', 'file-download', 'Download'), rails_blob_path(@shipment.carrier_pod, disposition: 'attachment'), download: "#{@shipment.load_id} POD.pdf" %></td>
            </tr>
          <% end %>
        <tbody>
      </table>
    </div>
  </div>
</div>
