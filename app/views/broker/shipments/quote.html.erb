<% provide :title, "Find Rates — Load #{@shipment.load_id}" %>
<% provide :menu, render('menu') %>
<% provide :no_cache, 'yes' %>

<%= render 'header', page_title: 'Find Rates' %>

<div class="table-responsive">
  <table class="table table-borderless table-striped table-hover sortable">
    <thead>
      <tr>
        <% if !@shipment.quote_only? %>
          <th>&nbsp;</th>
        <% end %>
        <th>Carrier</th>
        <th>Class</th>
        <th>Quote</th>
        <th>Rate</th>
        <th>Service</th>
        <th>Transit</th>
        <% if !@shipment.quote_only? && !@shipment.total_charges_cents == 0 %>
          <th>Profit</th>
        <% end %>
      </tr>
    </thead>
    <tbody id="rates">
    </tbody>
  </table>
</div>

<% @broker_carriers.each do |broker_carrier| %>
  <% @use_forced_freight_classes.each do |use_forced_freight_classes| %>
    <%= turbo_frame_tag "#{@shipment.id}_#{broker_carrier.id}_forced_freight_classes_#{use_forced_freight_classes}", src: rates_fetch_path(broker_carrier_id: broker_carrier.id, shipment_id: @shipment.id, use_forced_freight_classes: use_forced_freight_classes, format: 'turbo_stream') do %>
    <% end %>
  <% end %>
<% end %>
