<% provide :title, "Find Rates — Load #{@shipment.load_id}" %>

<%= render 'member_header' %>
<div data-controller="rates">
  <h4>Find Rates</h4>

  <% if @populate_rate_jobs_on_queue %>
    <div class="alert alert-success d-flex justify-content-between" data-rates-target="loading">
      <h5>Fetching Rates  </h5>
      <span class="spinner-border" role="status">
        <span class="sr-only">Loading...</span>
      </span> 
    </div>
  <% end %>

  <% if !@shipment.broker_carrier.blank? && !@shipment.pickup_confirmation.blank? %>
    <%= render 'layouts/message', classes: 'alert-warning', title: 'Dispatched', message: "You must contact #{@shipment.broker_carrier.carrier.name} to cancel pickup #{@shipment.pickup_confirmation} or you may be charged." %>
  <% elsif !@shipment.broker_carrier.blank? && @shipment.pickup_confirmation.blank? %>
    <%= render 'layouts/message', classes: 'alert-warning', title: 'Assigned', message: "Shipment is assigned to a #{@shipment.broker_carrier.carrier.name} but no pickup confirmation has been added — if switching carriers you must contact #{@shipment.broker_carrier.carrier.name} to cancel pickup." %>
  <% end %>

  <% if !@shipment.quote_only? && @shipment.incomplete? %>
    <%= render 'layouts/message', classes: 'alert-warning', title: 'Partial quote', message: 'In order to ensure rates are accurate make the shipper’s name and street address, the receiver’s name and street address, and all freight dimensions and weights are completed.' %>
  <% end %>

  <% if @declared_freight_classes == [false] %>
    <div class="table-responsive">
      <table class="table table-borderless table-striped table-hover sortable">
        <thead>
          <tr>
            <th></th>
            <th>Carrier</th>
            <th>Quote</th>
            <th id="sortOnTurboFrameLoad">Rate</th>
            <th>Source</th>
            <th>Service</th>
            <th>Transit</th>
            <% if !@shipment.quote_only? && !@shipment.total_charges_cents.zero? %>
              <th>Profit</th>
            <% end %>
          </tr>
        </thead>
        <tbody id="rates_false" data-rates-target="ratesContainer" data-shipment-id="<%= @shipment.id %>">
          <%= render "rates_service/rates", rates: @rates_declared_freight_classes_false, shipment: @shipment if @rates_declared_freight_classes_false %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="row">
      <% @declared_freight_classes.each do |declared_freight_classes| %>
        <div class="col col-md-6">
          <p class="col-title">
            <% classes = @shipment.freight_classes(use_declared_freight_class: declared_freight_classes) %>
            Based on <%= declared_freight_classes ? 'Declared' : 'Calculated' %>
            <%= 'class'.pluralize(classes.size).titleize %>
            <%= classes.join(', ') %>
          </p>

          <div class="table-responsive">
            <table class="table table-borderless table-striped table-hover sortable">
              <thead>
                <tr>
                  <% unless @shipment.quote_only? %>
                    <th></th>
                  <% end %>
                  <th>Carrier</th>
                  <th>Quote</th>
                  <th>Rate</th>
                  <th>Source</th>
                  <th>Service</th>
                  <th>Transit</th>
                  <% if !@shipment.quote_only? && !@shipment.total_charges_cents == 0 %>
                    <th>Profit</th>
                  <% end %>
                </tr>
              </thead>
              <tbody id="rates_<%= declared_freight_classes %>" data-rates-target="ratesContainer" data-shipment-id="<%= @shipment.id %>">
                <% existing_rates = instance_variable_get("@rates_declared_freight_classes_#{declared_freight_classes}") %>
                <%= render "rates_service/rates", rates: existing_rates, shipment: @shipment if existing_rates.present? %>
              </tbody>
            </table>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
