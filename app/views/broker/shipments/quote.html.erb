<% provide :title, "Find Rates — Load #{@shipment.load_id}" %>
<% provide :menu, render('menu') %>
<% provide :no_cache, 'yes' %>

<%= render 'header', page_title: 'Find Rates' %>

<% if !@shipment.broker_carrier.blank? && !@shipment.pickup_confirmation.blank? %>
  <%= render 'layouts/message', classes: 'bg-warning', title: 'Dispatched', message: "You must contact #{@shipment.broker_carrier.carrier.name} to cancel pickup #{@shipment.pickup_confirmation} or you may be charged." %>
<% elsif !@shipment.broker_carrier.blank? && @shipment.pickup_confirmation.blank? %>
  <%= render 'layouts/message', classes: 'bg-warning', title: 'Assigned', message: "Shipment is assigned to a #{@shipment.broker_carrier.carrier.name} but no pickup confirmation has been added — if switching carriers you must contact #{@shipment.broker_carrier.carrier.name} to cancel pickup." %>
<% end %>

<% if !@shipment.quote_only? && @shipment.incomplete? %>
  <%= render 'layouts/message', classes: 'bg-warning', title: 'Partial quote', message: 'In order to ensure rates are accurate make the shipper’s name and street address, the receiver’s name and street address, and all freight dimensions and weights are completed.' %>
<% end %>

<ul class="list-inline list-unstyled font-weight-bold">
  <li class="list-inline-item">Quoted <%= long_date DateTime.current, current_user.time_zone %></li>
  <li class="list-inline-item">Rates valid through <%= long_date (DateTime.current + 14.days), current_user.time_zone %></li>
</ul>

<% if not @shipment.rates.without_error.with_forced_freight_classes.blank? and @shipment.rates.without_error.with_calculated_freight_classes.blank? %>
  <%= render 'quotes_show_many', rates: @shipment.rates.without_error.with_forced_freight_classes %>
<% else %>
  <div class="row">
    <% unless @shipment.rates.without_error.with_calculated_freight_classes.blank? %>
      <div class="col">
        <p class="col-title">Using Calculated Freight <%= 'Class'.pluralize @shipment.calculated_freight_classes.size %> <%= @shipment.calculated_freight_classes.join(', ') %></p>
        <%= render 'quotes_show_many', rates: @shipment.rates.without_error.with_calculated_freight_classes %>
      </div>
    <% end %>
    <% unless @shipment.rates.without_error.with_forced_freight_classes.blank? %>
      <div class="col">
        <p class="col-title">Using Declared Freight <%= 'Class'.pluralize @shipment.forced_freight_classes.size %> <%= @shipment.forced_freight_classes.join(', ') %></p>
        <%= render 'quotes_show_many', rates: @shipment.rates.without_error.with_forced_freight_classes %>
      </div>
    <% end %>
  </div>
<% end %>