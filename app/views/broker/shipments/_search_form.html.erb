<% unless q.blank? %>
  <div class="row">
    <div class="col">
      <%= render 'layouts/pagy', pagy: @pagy %>
    </div>
    <div class="col-auto float-end">
      <div class="d-flex align-items-center mb-3">
        <%= search_form_for(q, url: request.path, class: 'form-inline me-2') do |f| %>
          <%= f.hidden_field :s, value: params[:q].try(:[], :s) %>
          <%= f.text_field :created_at_gteq, placeholder: 'From', autocomplete: 'off', data: flatpickr_data({ flatpickr_max_date: Date.current }), class: 'form-control me-1' %>
          <%= f.text_field :delivered_at_lteq, placeholder: 'Until', autocomplete: 'off', data: flatpickr_data({ flatpickr_max_date: Date.current }), class: 'form-control me-1' %>
          <%= f.text_field Shipment::SEARCH_PREDICATE, placeholder: 'Filter', class: 'form-control me-2' %>
          <%= f.submit 'Filter', class: 'btn btn-primary' %>
        <% end %>

        <%= render 'shared/export_buttons' %>
      </div>
    </div>
  </div>
<% end %>
