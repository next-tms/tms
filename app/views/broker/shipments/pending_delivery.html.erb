<% provide :title, 'In Transit — Shipments' %>
<% provide :menu, render('menu') %>
<% provide :auto_refresh, 'yes' %>

<div class="page-header">
  <h1>Shipments</h1>
  <p class="lead">In Transit</p>
</div>

<h2>Missing ETA</h2>
<%= turbo_frame_tag :shipments_without_delivery_eta_on, src: broker_shipments_pending_delivery_without_delivery_eta_on_path do %>
  <%= render 'shared/loading' %>
<% end %>

<h2>Late</h2>
<%= turbo_frame_tag :shipments_late, src: broker_shipments_pending_delivery_late_path do %>
  <%= render 'shared/loading' %>
<% end %>

<h2>On Time</h2>
<%= turbo_frame_tag :shipments_on_time, src: broker_shipments_pending_delivery_on_time_path do %>
  <%= render 'shared/loading' %>
<% end %>
