<% unless users.blank? %>
  <%= render 'broker/users/search_form' %>

  <div class="table-responsive">
    <table class="table table-borderless table-striped">
      <thead>
        <tr>
          <th><%= sort_link @q, :first_name, 'Name' %></th>
          <th><%= sort_link @q, :email, 'Email' %></th>
          <% if !controller_name == 'broker_customers' %>
            <th>Roles</th>
          <% end %>
          <th><%= sort_link @q, :last_sign_in_at, 'Last Sign In' %></th>
        </tr>
      </thead>
      <tbody>
        <% users.each do |user| %>
          <tr>
            <td class="text-nowrap"><%= user.contact.full_name %></td>
            <td cass="text-nowrap"><%= user.email %></td>
            <% if !controller_name == 'broker_customers' %>
              <td><%= (user.roles.map(&:name) - ['root']).sort.join(', ') %></td>
            <% end %>
            <td class="text-nowrap"><%= pretty_date(user.last_sign_in_at, current_user.time_zone) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  
  <%= render 'layouts/pagy', pagy: @pagy %>
<% else %>
  <%= render 'layouts/no_content' %>
<% end %>
