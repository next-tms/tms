<%= turbo_frame_tag :users do %>
  <%= render 'broker/users/search_form', q: q %>

  <% unless users.blank? %>
    <div class="table-responsive">
      <table class="table table-borderless table-striped">
        <thead>
          <tr>
            <th><%= sort_link q, :first_name, 'Name' %></th>
            <% if controller_name == 'users' %>
              <th><%= sort_link q, :broker_customer_id, 'Kind' %></th>
              <th>Active?</th>
            <% end %>
            <% if controller_name != 'broker_customers' %>
              <th>Roles</th>
            <% end %>
            <th><%= sort_link q, :email, 'Email' %></th>
            <th class="text-nowrap"><%= sort_link q, :invitation_accepted_at, 'Invitation Accepted' %></th>
            <th class="text-nowrap"><%= sort_link q, :last_sign_in_at, 'Last Sign In' %></th>
          </tr>
        </thead>
        <tbody>
          <% users.each do |user| %>
            <tr class="<% if user.deactivated? %>table-danger<% end %>">
              <td class="text-nowrap"><%= link_to user.full_name, broker_user_path(user), target: '_top' %></td>
              <% if controller_name == 'users' %>
                <td>
                  <% unless user.deactivated? %>
                    <%= user.customer? ? 'Customer' : 'Staff' %>
                  <% end %>
                </td>
                <td><% unless user.deactivated? %>✓<% end %></td>
              <% end %>
              <% if controller_name != 'broker_customers' %>
                <td><%= (user.roles.map(&:name) - ['root']).sort.join(', ') %></td>
              <% end %>
              <td cass="text-nowrap"><%= link_to user.email, "mailto:#{user.email}" %></td>
              <td class="text-nowrap">
                <%= pretty_date(user.invitation_accepted_at, current_user.time_zone) || 'Never' %>
              </td>
              <td class="text-nowrap">
                <%= pretty_date(user.last_sign_in_at, current_user.time_zone) || 'Never' %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%= render 'layouts/pagy', pagy: @pagy %>
  <% else %>
    <%= render 'layouts/no_content' %>
  <% end %>
<% end %>
