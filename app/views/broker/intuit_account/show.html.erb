<% provide :title, 'Intuit Quickbooks' %>

<div class="page-header">
  <h1>Settings</h1>
  <p class="lead"><%= yield :title %></p>
</div>

<% if current_user.broker.intuit_account&.connected? %>
  <div class="alert alert-info">
    <p>Connected to Intuit QuickBooks</p>
  </div>
<% else %>
  <div class="alert alert-warning">
    <p>Not connected to Intuit QuickBooks</p>
  </div>

  <%= link_to 'Connect', authenticate_intuit_account_path, class: 'btn btn-primary' %>
<% end %>
