<% provide :title, 'Import Statement' %>
<% provide :menu, render('broker/payments/menu') %>

<div class="page-header">
  <h1>Invoices</h1>
  <p class="lead"><%= yield :title %></p>
</div>

<%= bootstrap_form_with(model: [:broker, @payment_transaction], local: true, layout: :horizontal, label_col: 'col-sm-3', control_col: 'col-sm-8') do |f| %>
  <%= f.alert_message 'Unable to import statement:' %>
  <%= f.select :broker_carrier_id, current_user.broker.broker_carriers.sort_by { |broker_carrier| broker_carrier.carrier.name }.collect { |broker_carrier| [ broker_carrier.broker_customer_specific_name, broker_carrier.id ] }, { label: 'Carrier', selected: (@payment_transaction.broker_carrier ? @payment_transaction.broker_carrier.id : (params[:broker_carrier_id] ? params[:broker_carrier_id] : nil)) }, class: 'custom-select col-sm-6 col-md-4 mt-2 mb-4' %>
  <%= f.text_area :csv, label: 'CSV', placeholder: 'pro, balance, due', help: 'Note: Dates must be in format YYYY-MM-DD', value: (params[:csv].blank? ? '' : params[:csv]), rows: 5, class: 'col-sm-6' %>
  <div class="form-group">
    <%= f.submit class: 'btn btn-primary mt-4', value: 'Import' %>
  </div>
<% end %>