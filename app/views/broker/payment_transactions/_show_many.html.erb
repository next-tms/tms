<%= turbo_frame_tag :payment_transactions do %>
  <%= render 'broker/payment_transactions/search_form', q: q %>

  <% unless payment_transactions.blank? %>
    <div class="table-responsive">
      <table class="table table-condensed table-borderless table-striped table-hover h-100">
        <thead>
          <tr>
            <th><%= sort_link(q, :id, '#') %></th>

            <% unless action_name == 'show' %>
              <th><%= sort_link(q, :broker_carrier_carrier_name, 'Debtor') %></th>
            <% end %>

            <th class="text-nowrap"><%= sort_link(q, :invoice, 'Debtor Ref') %></th>
            <th><%= sort_link(q, :due_on, 'Due') %></th>
            <th><%= sort_link(q, :shipment_load_id, 'Load') %></th>
            <th><%= sort_link(q, :balance_cents, 'Balance') %></th>
            <th class="text-nowrap"><%= sort_link(q, :shipment_total_cost_cents, 'Predicted Balance') %></th>
            <th>Variance</th>
            <th><%= sort_link(q, :pay_cents, 'Pay') %></th>

            <% if action_name == 'show' %>
              <th><%= sort_link(q, :notes, 'Notes') %></th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% payment_transactions.each do |payment_transaction| %>
            <tr class="<%= 'table-danger' if payment_transaction.variance and payment_transaction.variance > 0 %>">
              <td>
                <%= link_to (payment_transaction.shipment&.load_id || payment_transaction.legacy_load_id),
                            broker_payment_transaction_path(payment_transaction),
                            target: '_top'
                %>
              </td>

              <% unless action_name == 'show' %>
                <td>
                  <%= link_to payment_transaction.broker_carrier.carrier.name,
                              [:broker, payment_transaction.broker_carrier.carrier, payment_transaction.broker_carrier, :payment_transactions],
                              target: '_blank'
                  %>
                </td>
              <% end %>

              <td>
                <% if !payment_transaction.legacy_load_id.blank? %>
                  <%= payment_transaction.legacy_load_id %>
                <% else %>
                  <%= link_to (payment_transaction.invoice.blank? ? payment_transaction.shipment.pro : payment_transaction.invoice),
                              broker_shipments_path(q: { pro_cont: payment_transaction.shipment.pro }),
                              target: '_blank'
                  %>
                <% end %>
              </td>

              <td><%= short_date payment_transaction.due_on, current_user.time_zone %></td>
              <td>
                <% if not payment_transaction.shipment.blank? %>
                  <%= link_to payment_transaction.shipment.load_id, broker_shipment_path(payment_transaction.shipment), target: '_top' %>
                <% elsif not payment_transaction.legacy_load_id.blank? %>
                  <%= payment_transaction.legacy_load_id %> <small class="text-uppercase text-primary">legacy</small>
                <% end %>
              </td>
              <td><%= humanized_money_with_symbol payment_transaction.balance, no_cents_if_whole: false %></td>
              <td>
                <% if not payment_transaction.shipment.blank? and not payment_transaction.additional_charge? %>
                  <%= humanized_money_with_symbol payment_transaction.shipment.carrier_cost, no_cents_if_whole: false %>
                <% end %>
              </td>
              <td>
                <% unless payment_transaction.shipment.blank? %>
                  <%= humanized_money_with_symbol payment_transaction.variance, no_cents_if_whole: false %>
                <% end %>
              </td>
              <td><%= humanized_money_with_symbol payment_transaction.paid, no_cents_if_whole: false %></td>

              <% if action_name == 'show' %>
                <td><%= payment_transaction.notes %></th>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <%= render 'layouts/no_content' %>
  <% end %>
<% end %>
