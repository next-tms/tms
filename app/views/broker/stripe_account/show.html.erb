<% provide :title, 'Stripe' %>

<div class="page-header">
  <h1>Settings</h1>
  <p class="lead"><%= yield :title %></p>
</div>

<% if current_user.broker.stripe_account&.connected? %>
  <div class="alert alert-info">
    <p>Connected to Stripe</p>
  </div>
<% else %>
  <div class="alert alert-warning">
    <p>Not connected to Stripe</p>
  </div>

  <%= link_to 'Connect',
              authenticate_stripe_account_url(
                host: Rails.env.development? ? request.host : 'tms.next-tms.com',
                state: current_user.broker.uuid
              ),
              class: 'btn btn-primary',
              data: { turbo: false }
  %>
<% end %>
