<%= turbo_frame_tag :claim_items do %>
  <% unless claim_items.blank? %>
    <div class="table-responsive">
      <table class="table table-condensed table-borderless table-striped table-hover h-100">
        <thead>
          <tr>
            <th>Payee</th>
            <th>Total</th>
            <th>Balance</th>
          </tr>
        </thead>
        <tbody>
          <% claim_items.each do |claim_item| %>
            <tr>
              <td><%= claim_item.payee.name %></td>
              <td><%= humanized_money_with_symbol claim_item.total, no_cents_if_whole: false %></td>
              <td><%= humanized_money_with_symbol claim_item.balance, no_cents_if_whole: false %></td>
            </tr>
          <% end %>
        </tbody>
        <tfoot>
          <tr>
            <th>&nbsp;</th>
            <th><%= humanized_money_with_symbol Money.new(claim_items.sum(:total_cents)), no_cents_if_whole: false %></th>
            <th><%= humanized_money_with_symbol Money.new(claim_items.sum(:balance_cents)), no_cents_if_whole: false %></th>
          </tr>
        </tfoot>
      </table>
    </div>
  <% else %>
    <%= render 'layouts/no_content' %>
  <% end %>
<% end %>
