<% provide :title, 'Reports' %>

<div class="page-header d-flex align-items-center justify-content-between">
  <h1>Reports</h1>
  <%= link_to icon('solid', 'plus', 'New Report'), new_broker_report_path, class: 'btn btn-primary' %>
</div>

<div class="table-responsive">
  <table class="table table-borderless table-striped table-hover">
    <thead>
      <tr>
        <th>Name</th>
        <th>Details</th>
        <th>Created By</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @presets.each do |preset| %>
        <tr>
          <td>
            <%= link_to preset.name, broker_report_path(preset) %>
            <span class="badge text-bg-secondary">Pre-built</span>
          </td>
          <td><%= preset.description %></td>
          <td></td>
          <td class="text-end">
            <%= link_to 'Duplicate', new_broker_report_path(duplicate: preset.key), class: 'btn btn-sm btn-outline-secondary' %>
          </td>
        </tr>
      <% end %>

      <% @reports.each do |report| %>
        <tr>
          <td><%= link_to report.name, broker_report_path(report) %></td>
          <td><%= report_record_name(report.record_class) %>, <%= pluralize(report.columns.size, 'column') %></td>
          <td><%= report.created_by.full_name %></td>
          <td class="text-end">
            <%= link_to 'Duplicate', new_broker_report_path(duplicate: report.id), class: 'btn btn-sm btn-outline-secondary' %>
            <% if allowed_to?(:edit?, report) %>
              <%= link_to 'Edit', edit_broker_report_path(report), class: 'btn btn-sm btn-outline-secondary' %>
              <%= button_to 'Delete',
                            broker_report_path(report),
                            class: 'btn btn-sm btn-outline-danger',
                            form: { class: 'd-inline', data: { turbo_confirm: "Delete #{report.name}?" } },
                            method: :delete
              %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
