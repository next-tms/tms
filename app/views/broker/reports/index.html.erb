<% provide :title, 'All' %>

<%= render 'header' %>
<h2><%= yield :title %></h2>

<div class="table-responsive">
  <table class="table table-condensed table-borderless table-striped table-hover">
    <thead>
      <tr>
        <th class="text-nowrap">Name</th>
        <th class="text-nowrap">Records</th>
        <th class="text-nowrap">Columns</th>
        <th class="text-nowrap">Created By</th>
      </tr>
    </thead>
    <tbody>
      <% @presets.each do |preset| %>
        <tr>
          <td><%= link_to preset.name, [ :broker, preset ] %></td>
          <td><%= report_record_name(preset.record_class) %></td>
          <td><%= preset.columns.size %></td>
          <td>Pre-built</td>
        </tr>
      <% end %>

      <% @reports.each do |report| %>
        <tr>
          <td><%= link_to report.name, [ :broker, report ] %></td>
          <td><%= report_record_name(report.record_class) %></td>
          <td><%= report.columns.size %></td>
          <td><%= report.created_by.full_name %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
