<% record_class = @report.record_class %>

<%= bootstrap_form_with(model: [ :broker, @report ], data: { controller: 'date-range' }, layout: :horizontal) do |f| %>
  <%= f.alert_message 'Unable to save report:' %>

  <%= f.hidden_field :record_type %>
  <%= f.form_group :record_type, label: { text: 'Records' } do %>
    <p class="form-control-plaintext"><%= report_record_name(record_class) %></p>
  <% end %>

  <%= f.text_field :name, autofocus: true %>

  <%= f.form_group :columns, label: { text: 'Columns' } do %>
    <%= hidden_field_tag 'report[columns][]', '', id: nil %>
    <% @report.columns.each do |column| %>
      <%= hidden_field_tag 'report[column_order][]', column, id: nil %>
    <% end %>
    <%= render 'shared/export_columns',
               association: nil,
               mark_internal: true,
               name: 'report[columns][]',
               record_class:,
               selected: @report.columns
    %>
  <% end %>

  <%= f.select :date_attribute,
               @date_attributes.map { |date_attribute| [ record_class.human_attribute_name(date_attribute), date_attribute ] },
               { help: 'Asks for a date range when you run the report', include_blank: 'None', label: 'Date' },
               { data: { action: 'date-range#update', date_range_target: 'select' } }
  %>

  <%= f.form_group :filters, label: { text: 'Filters' } do %>
    <% if @report.filters.empty? %>
      <p class="form-control-plaintext text-muted">None</p>
    <% end %>

    <% @report.filters.each do |key, value| %>
      <% label = report_filter_label(record_class, key) %>
      <div class="mb-2">
        <% case value %>
        <% when true, 'true' %>
          <div class="form-check">
            <%= hidden_field_tag "report[filters][#{key}]", '', id: nil %>
            <%= check_box_tag "report[filters][#{key}]", 'true', true, class: 'form-check-input', id: "report_filters_#{key}" %>
            <%= label_tag "report_filters_#{key}", label, class: 'form-check-label' %>
          </div>
        <% when Array %>
          <div class="small text-muted"><%= label %></div>
          <%= hidden_field_tag "report[filters][#{key}][]", '', id: nil %>
          <% value.each do |item| %>
            <div class="form-check form-check-inline">
              <%= check_box_tag "report[filters][#{key}][]", item, true, class: 'form-check-input', id: "report_filters_#{key}_#{item.to_s.parameterize}" %>
              <%= label_tag "report_filters_#{key}_#{item.to_s.parameterize}", item, class: 'form-check-label' %>
            </div>
          <% end %>
        <% when Hash %>
          <div class="small text-muted"><%= label %></div>
          <span class="form-control-plaintext"><%= report_filter_value(value) %></span>
          <%= query_hidden_fields({ key => value }, 'report[filters]') %>
        <% else %>
          <%= label_tag "report_filters_#{key}", label, class: 'form-label small text-muted mb-0' %>
          <%= text_field_tag "report[filters][#{key}]", value, class: 'form-control', id: "report_filters_#{key}" %>
        <% end %>
      </div>
    <% end %>

    <small class="form-text text-muted">Clear or uncheck a filter to remove it</small>
  <% end %>

  <%= tag.div class: ('d-none' unless @report.date_range?), data: { date_range_target: 'range' } do %>
    <%= render 'date_range' %>
  <% end %>

  <%= f.form_group do %>
    <%= f.submit 'Save', class: 'btn btn-primary' %>
    <%= f.submit 'Preview', class: 'btn btn-secondary', data: { turbo_frame: 'report-preview' }, name: 'preview' %>
  <% end %>
<% end %>

<%= turbo_frame_tag 'report-preview' do %>
  <% if @preview %>
    <%= render 'preview', exporter: @preview %>
  <% elsif params[:preview] && @report.errors.any? %>
    <div class="alert alert-danger">Unable to preview: <%= @report.errors.full_messages.to_sentence %></div>
  <% end %>
<% end %>
