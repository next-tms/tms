<% provide :title, 'New' %>

<%= render 'member_header' %>

<% if @report.record_class && Report::Runnable.record_type_available?(@report.record_type, current_user) %>
  <%= render 'form' %>
<% else %>
  <h2>What should this report list?</h2>

  <div class="table-responsive">
    <table class="table table-condensed table-borderless table-striped table-hover">
      <thead>
        <tr>
          <th class="text-nowrap">Records</th>
        </tr>
      </thead>
      <tbody>
        <% Report::Runnable.record_types(current_user).each do |record_type| %>
          <tr>
            <td><%= link_to report_record_name(record_type.constantize), [ :new, :broker, :report, { record_type: } ] %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
