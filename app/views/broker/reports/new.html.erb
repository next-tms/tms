<% provide :title, 'New Report' %>

<div class="page-header">
  <h1>New Report</h1>
</div>

<% if @report.record_class %>
  <%= render 'form' %>
<% else %>
  <p class="lead">What should this report list?</p>

  <div class="list-group">
    <% Report::RECORD_TYPES.each do |record_type| %>
      <%= link_to report_record_name(record_type.constantize),
                  new_broker_report_path(record_type:),
                  class: 'list-group-item list-group-item-action'
      %>
    <% end %>
  </div>
<% end %>
