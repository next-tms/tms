<% provide :title, @report.name %>

<%= render 'member_header' %>

<% internal_columns = report_internal_columns(@report) %>
<% if internal_columns.any? %>
  <div class="alert alert-warning">
    This report includes internal columns that customers must not see:
    <%= internal_columns.map { |column| ExporterService.column_header(@report.record_class, column) }.to_sentence %>.
  </div>
<% end %>

<%= form_with(url: [ :broker, @report ], method: :get, data: { turbo: false }) do %>
  <% if @report.date_range? %>
    <%= render 'date_range' %>
  <% end %>

  <div class="mb-3 row">
    <div class="<%= @report.date_range? ? 'col-sm-10 offset-sm-2' : 'col' %>">
      <% if @report.date_range? %>
        <%= submit_tag 'Preview', class: 'btn btn-secondary', name: nil %>
      <% end %>
      <%= render 'shared/format_buttons', label: 'Download', target: [ :broker, @report ] %>
    </div>
  </div>
<% end %>

<%= render 'preview', exporter: @preview %>
