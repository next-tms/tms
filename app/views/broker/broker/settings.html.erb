<% provide :title, 'Edit' %>

<div class="page-header p-4 mb-4">
  <h1 class="mb-6">Company</h1>
</div>

<%= render 'form' %>

<% if current_user.role?(:root) %>
  <h2>Integrations</h2>
  
  <div class="table-responsive">
    <table class="table table-borderless table-striped">
      <thead>
        <th>Service</th>
        <th>Connected?</th>
      </thead>
      <tbody>
        <tr>
          <td>
            <%= link_to 'Intuit QuickBooks', broker_settings_company_intuit_path, target: '_blank' %>
          </td>
          <td>
            <% if current_user.broker.intuit_account&.connected? %>
              ✓
            <% end %>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
<% end %>
