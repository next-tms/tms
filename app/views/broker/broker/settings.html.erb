<% provide :title, 'Settings' %>
<% provide :menu, render('menu') %>

<div class="page-header">
  <h1>Settings</h1>
  <p class="lead">Overview</p>
</div>

<%= render 'form' %>

<% if current_user.role?(:root) %>
  <h2>Integrations</h2>
  
  <div class="table-responsive">
    <table class="table table-borderless table-striped">
      <thead>
        <th>Service</th>
        <th>Connected?</th>
      </thead>
      <tbody>
        <tr>
          <td>
            <%= link_to 'Intuit QuickBooks', broker_settings_intuit_path, target: '_blank' %>
          </td>
          <td>
            <% if current_user.broker.intuit_account&.connected? %>
              ✓
            <% end %>
          </td>
        </tr>
        <tr>
          <td>
            <%= link_to 'Stripe', broker_settings_stripe_path, target: '_blank' %>
          </td>
          <td>
            <% if current_user.broker.stripe_account&.connected? %>
              ✓
            <% end %>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
<% end %>
