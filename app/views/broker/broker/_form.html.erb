<div class="table-responsive">
  <table class="table table-borderless table-striped">
    <tbody>
      <% Broker::BrokerController::COMPANY_SETTING_KEYS.each do |key| %>
        <% setting = @settings[key] %>

        <tr>
          <th><%= key.humanize %></th>
          <td><%= setting&.address? ? setting.value.pretty(', ') : setting&.value %></td>
          <td class="text-end"><%= link_to 'Edit', setting.present? ? edit_broker_setting_path(setting) : new_broker_setting_path(key:) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<h2>Service Countries</h2>

<div class="table-responsive">
  <table class="table table-borderless table-striped">
    <tbody>
      <% @broker_countries.each do |broker_country| %>
        <tr>
          <td><%= broker_country.country.name %></td>
          <td class="text-end"><%= button_to icon('solid', 'trash'), broker_broker_country_path(broker_country), method: :delete, class: 'btn btn-light' %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%= bootstrap_form_with(model: [ :broker, BrokerCountry.new ], layout: :inline) do |f| %>
  <%= f.select :country_alpha2, @unserviced_countries.map { |country| [ country.name, country.id ] }, { hide_label: true }, class: 'form-select' %>
  <%= f.submit 'Add', class: 'btn btn-primary' %>
<% end %>
