<%= bootstrap_form_with(model: [:broker, @broker], url: broker_update_settings_path, layout: :horizontal) do |f| %>
  <%= f.alert_message "Unable to save customer:" %>

  <div class="form-group form-row">
    <label class="col-form-label col-sm-2">Address</label>

    <div class="col-sm-10" data-controller="address">
      <%= f.fields_for :address do |address_form| %>
        <%= address_form.text_field :street, hide_label: true, placeholder: 'Street' %>
        <%= address_form.text_field :street2, hide_label: true %>
        <%= address_form.text_field :city, hide_label: true, placeholder: 'City' %>
        <%= address_form.select :region_id, [[address_form.object.region.name, address_form.object.region_id]], { include_blank: 'State', hide_label: true }, data: { 'address-target': 'regions' }, class: 'form-select' %>
        <%= address_form.text_field :zip_code, hide_label: true, placeholder: 'ZIP' %>
        <%= address_form.select :country_id, current_user.broker.countries.order(:name).collect { |c| [c.name, c.id] }, { hide_label: true, selected: (address_form.object.country_id.blank? ? current_user.broker.address.country_id : address_form.object.country_id) }, data: { action: 'address#handle', 'address-target': 'country' }, class: 'form-select' %>
      <% end %>
    </div>
  </div>

  <%= f.email_field :customer_service_email, autocomplete: 'off', label: 'Customer service email' %>
  <%= f.telephone_field :phone, autocomplete: 'off', label: 'Customer service phone', value: f.object.phone.phony_formatted %>

  <div class="form-group form-row">
    <label class="col-form-label col-sm-2">Service Countries</label>
    <div class="col-sm-10">
      <%= f.fields_for :broker_countries do |broker_countries_form| %>
        <%= render 'broker_country_fields', f: broker_countries_form %>
      <% end %>

      <%= link_to_add_fields icon('solid', 'plus', 'Add'), f, :broker_countries, 'btn btn-light mt-2 mb-4' %>
    </div>
  </div>

  <div class="form-row">
    <%= f.check_box :automatically_authorize_receivables %>
  </div>

  <div class="form-row">
    <%= f.check_box :automatically_update_shipment_tracking_based_on_carrier_apis %>
  </div>

  <div class="form-row">
    <%=
      f.check_box :ignore_broker_carrier_bol_requires_tracking_number,
                  label: 'Generate BOL even if pro is missing and the carrier requires it?'
    %>
  </div>

  <div class="form-row">
    <%= f.check_box :requires_charges_confirmed_on_receivables,
                    label: 'Require Shipment Charges to be Confirmed before sending Receivables?' %>
  </div>

  <hr>

  <label class="col-form-label fw-bold"> Notification Preferences: List of Events to be notified on via email when you're not logged in</label>

  <div class="d-flex">
    <% @splitted_notification_types.each do |notif_group| %>
      <table class="table table-borderless w-auto me-4">
        <tbody>
          <% notif_group.each do |notification_type| %>
            <tr>
              <td><%= humanized_notification_type(notification_type) %></td>
              <td> <%= check_box_tag "email_notifications_blacklist[]", notification_type, @blacklist.exclude?(notification_type) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>

  <div class="form-row my-4">
    <%= f.submit 'Save', data: { turbo: false }, class: 'btn btn-primary' %>
  </div>
<% end %>
