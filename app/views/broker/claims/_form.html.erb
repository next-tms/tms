<%= bootstrap_form_with(model: [:broker, @claim], local: true, layout: :horizontal, label_col: 'col col-md-2', control_col: 'col') do |f| %>
  <%= f.alert_message 'Unable to save claim:' %>

  <% if f.object.new_record? %>
    <%= f.hidden_field :shipment_id, value: params[:shipment_id] %>
  <% end %>

  <%= f.text_field :due_on, label: 'Due', autocomplete: 'off', data: flatpickr_data, value: maybe_in_time_zone(datetime: @claim.due_on, time_zone: current_user.time_zone)&.to_date %>

  <p class="col-title">Owed</p>
  <div class="form-group row">
    <div data-controller="nested-form" data-nested-form-wrapper-selector-value=".claim-item-form-wrapper">
      <template data-nested-form-target="template">
        <%= f.fields_for :claim_items, ClaimItem.new, child_index: 'NEW_RECORD' do |claim_items_form| %>
          <%= render 'claim_item_form', f: claim_items_form %>
        <% end %>
      </template>

      <%= f.fields_for :claim_items do |claim_items_form| %>
        <%= render 'claim_item_form', f: claim_items_form %>
      <% end %>

      <div data-nested-form-target="target"></div>

      <%= link_to icon('solid', 'plus', 'Add'), '#', data: { action: 'nested-form#add' }, class: 'btn btn-light' %>
    </div>
  </div>

  <%= f.form_group do %>
    <%= f.submit class: 'btn btn-primary', data: { turbo: false }, value: 'Save' %>
  <% end %>
<% end %>
