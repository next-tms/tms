<% provide :title, 'Search' %>

<div class="page-header">
  <h1>Search</h1>
</div>

<%= render 'form' %>

<% unless params[:q].blank? %>
  <h3>Carriers</h3>
  <%= turbo_frame_tag 'broker_carriers', src: broker_broker_carriers_path(q: { carrier_name_cont: params[:q] }) %>

  <h3>Customers</h3>
  <%= turbo_frame_tag 'broker_customers', src: broker_broker_customers_path(q: { customer_name_cont: params[:q] }) %>

  <h3>Shipments</h3>
  <%= turbo_frame_tag 'shipments', src: broker_shipments_path(q: { Shipment::SEARCH_PREDICATE => params[:q] }) %>
<% else %>
  <%= render 'layouts/no_content' %>
<% end %>
