<div class="page-header p-4 mb-4">
  <h1 class="mb-6">
    <% if @carrier %>
      <%= link_to @carrier.name, [:broker, @carrier], class: 'text-reset' %>
    <% else %>
      Carrier
    <% end %>
  </h1>

  <% unless @broker_carrier.new_record? %>
    <table class="table table-borderless w-auto">
      <thead>
        <tr>
          <th>Account</th>
          <th>Shipments</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td class="lead">
            <% if @broker_carrier.broker_customer.blank? %>
              All Customers
            <% else %>
              <%= link_to @broker_carrier.broker_customer.customer.name, broker_broker_customer_path(@broker_carrier.broker_customer), target: '_blank' %>
            <% end %>
          </td>

          <td class="lead">
            <%= link_to @broker_carrier.shipments.size, [:broker, @carrier, @broker_carrier, :shipments], class: 'shipments-index' %>
          </td>
        </tr>
      </tbody>
    </table>

    <%= render 'broker/carriers/broker_carriers/member_menu' %>
  <% end %>
</div>
