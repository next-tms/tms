<div class="page-header p-4 mb-4">
  <h1 class="mb-6"><%= @carrier.name %></h1>

  <table class="table table-borderless w-auto">
    <thead>
      <tr>
        <th>Accounts</th>
        <th>Shipments</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td class="lead"><%= link_to @carrier.broker_carriers.size, [:broker, @carrier, :broker_carriers], class: 'broker-carriers-index' %></td>
        <td class="lead"><%= link_to @carrier.broker_carriers.sum(:shipments_count), [:broker, @carrier, :shipments], class: 'shipments-index' %></td>
      </tr>
    </tbody>
  </table>

  <%= render 'broker/carriers/member_menu' %>
</div>
