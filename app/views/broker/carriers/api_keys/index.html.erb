<% provide :title, APIKey.model_name.human(count: 2) %>

<%= render 'broker/carriers/member_header' %>
<h2><%= yield :title %></h2>

<p><%= t('.intro_html', model_name_plural: APIKey.model_name.human(count: 2)) %></p>

<p><%= link_to icon('solid', 'plus', t('.new')), [:new, :broker, @carrier, :api_key], class: 'btn btn-primary' %></p>

<% if @api_keys.any? %>
  <%= render 'layouts/pagy', pagy: @pagy %>

  <div class="table-responsive">
    <table class="table table-condensed table-borderless table-striped table-hover h-100">
      <thead>
        <tr>
          <% %i[name token_suffix].each do |attribute| %>
            <th><%= sort_link @q, attribute, APIKey.human_attribute_name(attribute) %></th>
          <% end %>
          <th><%= APIKey.human_attribute_name(:user) %></th>
          <% %i[created_at expires_at last_used_at].each do |attribute| %>
            <th><%= sort_link @q, attribute, APIKey.human_attribute_name(attribute) %></th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% @api_keys.each do |api_key| %>
          <tr>
            <td><%= link_to api_key.name, [:broker, @carrier, api_key] %></td>
            <td><code><%= APIKey::TOKEN_PREFIX %>…<%= api_key.token_suffix %></code></td>
            <td><%= api_key.user.full_name %></td>
            <td><%= time(api_key.created_at) %></td>
            <td><%= time(api_key.expires_at) %></td>
            <td><%= time(api_key.last_used_at) || t('.never') %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%= render 'layouts/pagy', pagy: @pagy %>
<% else %>
  <%= render 'layouts/no_content' %>
<% end %>
