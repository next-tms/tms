<%= render layout: 'layouts/pdf' do %>
  <table>
    <thead>
      <tr>
        <td>
          <h1><%= shipment.broker.name %></h1>
          <address><%= shipment.broker.address.pretty(', ').gsub('Apt', 'Ste').html_safe %></address>
          <ul class="list-unstyled list-inline">
            <li><%= URI.parse(Setting.value!('website_homepage')).host %></li>
            <li><%= shipment.broker.phone.phony_formatted %></li>
            <li><%= shipment.broker.customer_service_email %></li>
          </ul>
        <td class="text-end">
          <h2>Quote</h2>
          <ul class="list-unstyled">
            <li><b>Load:</b> <%= shipment.load_id %></li>
            <% unless shipment.shipper_reference.blank? %>
              <li><b>Shipper Ref:</b> <%= shipment.shipper_reference %></li>
            <% end %>
            <% unless shipment.customer_reference.blank? %>
              <li><b>PO Ref:</b> <%= shipment.customer_reference %></li>
            <% end %>
            <li><strong>Date:</strong> <%= long_date Date.current, shipment.shipper_address.time_zone %></li>
            <li><strong>Pickup Date:</strong> <%= shipment.pickup_on %></li>
          </ul>
        </td>
      </tr>
    </thead>
  </table>

  <table>
    <tbody>
      <tr>
        <td>
          <h3>Shipper</h3>
          <address>
            <%= shipment.shipper_name %>
            <br>
            <%= shipment.shipper_address.pretty('<br>').html_safe %>
          </address>
          <ul class="list-unstyled list-inline margin-top">
            <% unless shipment.shipper_contact_name.blank? %>
              <li><%= shipment.shipper_contact_name %></li>
            <% end %>
            <% unless shipment.shipper_contact_phone.blank? %>
              <li><%= shipment.shipper_contact_phone.phony_formatted %></li>
            <% end %>
            <% unless shipment.shipper_contact_email.blank? %>
              <li><%= shipment.shipper_contact_email %></li>
            <% end %>
          </ul>
        </td>
        <td>
          <h3>Consignee</h3>
          <address>
            <%= shipment.receiver_name %>
            <br>
            <%= shipment.receiver_address.pretty('<br>').html_safe %>
          </address>
          <ul class="list-unstyled list-inline margin-top">
            <% unless shipment.receiver_contact_name.blank? %>
              <li><%= shipment.receiver_contact_name %></li>
            <% end %>
            <% unless shipment.receiver_contact_phone.blank? %>
              <li><%= shipment.receiver_contact_phone.phony_formatted %></li>
            <% end %>
            <% unless shipment.receiver_contact_email.blank? %>
              <li><%= shipment.receiver_contact_email %></li>
            <% end %>
          </ul>
        </td>
      </tr>
    </tbody>
  </table>

  <table>
    <thead>
      <tr>
        <th>Units</th>
        <th>Description</th>
        <th>Dimensions (L x W x H)</th>
        <th>HZ<tiny>*</tiny></th>
        <th>Class</th>
        <th>Weight</th>
      </tr>
    </thead>
    <tbody>
      <% shipment.items.each do |item| %>
        <tr>
          <td><%= pluralize item.quantity, item.packaging.name %></td>
          <td><%= item.desc %></td>
          <td>
            <% if item.l and item.w and item.h %>
              <%= item.l %>x<%= item.w %>x<%= item.h %>
            <% end %>
          </td>
          <td><% if item.hazmat %>✓<% end %></td>
          <td>
            <% if shipment.calculated_freight_classes? %>
              <%= item.calculated_freight_class.presence || item.declared_freight_class %>
            <% else %>
              <%= item.declared_freight_class.presence || item.calculated_freight_class %>
            <% end %>
          </td>
          <td>
            <%= number_with_delimiter item.weight %> lbs
          </td>
        </tr>
      <% end %>
      <tr class="total">
        <td><%= pluralize shipment.total_pieces, 'piece' %></td>
        <td class="empty">&nbsp;</td>
        <td class="empty">&nbsp;</td>
        <td class="empty">&nbsp;</td>
        <td><%= number_with_delimiter shipment.total_weight %> lbs</td>
      </tr>
    </tbody>
  </table>

  <table class="w-33 bordered">
    <thead>
      <th>Service</th>
      <th class="text-end">Charge</th>
    </thead>
    <tbody>
      <tr>
        <td>Shipping</td>
        <td class="text-end">
          <%= humanized_money_with_symbol shipment.carrier_charge, no_cents_if_whole: false %>
        </td>
      </tr>

      <% shipment.shipment_broker_accessorials.sort_by{ |shipment_broker_accessorial| shipment_broker_accessorial.broker_accessorial.name }.each do |shipment_broker_accessorial| %>
        <% unless shipment_broker_accessorial.broker_accessorial.broker_only %>
          <tr>
            <td><%= shipment_broker_accessorial.broker_accessorial.name %></td>
            <td class="text-end"><%= humanized_money_with_symbol shipment_broker_accessorial.charge, no_cents_if_whole: false %></td>
          </tr>
        <% end %>
      <% end %>

      <tr class="font-weight-bold">
        <td></td>
        <td class="text-end"><strong>Total: <%= humanized_money_with_symbol shipment.total_charges, no_cents_if_whole: false %></strong></td>
      </tr>
    </tbody>
  </table>
<% end %>
