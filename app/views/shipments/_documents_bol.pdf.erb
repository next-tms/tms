<%= render layout: 'layouts/pdf' do %>
  <table>
    <thead>
      <tr>
        <td>
          <%== @qrcode %>
          <br>
          <b>Load <%= shipment.load_id %></b>
        </td>
        <td>
          <h1><%= shipment.broker.name %></h1>
          <address><%= shipment.broker.address.pretty('<br>').html_safe.gsub('Apt', 'Ste').html_safe %></address>
          <ul class="list-unstyled list-inline">
            <li><%= domain %></li>
            <li><%= shipment.broker.phone.phony_formatted %></li>
            <li><%= shipment.broker.customer_service_email %></li>
          </ul>
        <td class="text-right">
          <h2>Bill of Lading</h2>
          <ul class="list-unstyled">
            <li><b>Load:</b> <%= shipment.load_id %></li>
            <% unless shipment.shipper_reference.blank? %>
              <li><b>Shipper Ref:</b> <%= shipment.shipper_reference %></li>
            <% end %>
            <% unless shipment.customer_reference.blank? %>
              <li><b>PO Ref:</b> <%= shipment.customer_reference %></li>
            <% end %>
          </ul>
        </td>
      </tr>
    </thead>
  </table>

  <div class="text-center bordered">
    <h2>
      <strong>Contact <%= shipment.broker.name %> for questions, issues, or tracking</strong>
      <br>
      <ul class="list-unstyled list-inline">
        <li><%= domain %></li>
        <li><%= shipment.broker.phone.phony_formatted %></li>
        <li><%= shipment.broker.customer_service_email %></li>
      </ul>
    </h2>
  </div>

  <table>
    <tr>
      <% has_pro? = (!shipment.broker_carrier.blank? && !shipment.broker_carrier.carrier.acts_as_broker?) && !shipment.pro.blank? %>
      <% cols = has_pro? ? 2 : 1 %>
      <td <% if cols == 1 %>colspan="2"<% end %>>
        <h2><%= !shipment.carrier.blank? ? shipment.carrier.name : '&nbsp;'.html_safe %></h2>
      </td>
      <% if has_pro? %>
        <td class="text-right">
          <h2>Pro <%= shipment.pro %></h2>
        </td>
      <% end %>
    </tr>
    <tr>
      <td>
        <h3>Shipper</h3>
        <address>
          <%= shipment.shipper_name %>
          <br>
          <%= shipment.shipper_address.pretty('<br>').html_safe %>
        </address>
        <ul class="list-unstyled list-inline margin-top">
          <% unless shipment.shipper_contact_name.blank? %>
            <li><%= shipment.shipper_contact_name %></li>
          <% end %>
          <% unless shipment.shipper_contact_phone.blank? %>
            <li><%= shipment.shipper_contact_phone.phony_formatted %></li>
          <% end %>
          <% unless shipment.shipper_contact_email.blank? %>
            <li><%= shipment.shipper_contact_email %></li>
          <% end %>
        </ul>
        <p>
          <% unless shipment.pickup_on.blank? %>
            <strong>Pickup Appointment:</strong>
            <br>
            <%= pretty_date shipment.pickup_on, shipment.shipper_address.time_zone %>
            <% if not shipment.pickup_hours_start_at.blank? and not shipment.pickup_hours_end_at.blank? %>
              <%= shipment.pickup_hours_start_at %> - <%= shipment.pickup_hours_end_at %>
            <% end %>
          <% end %>
        </p>
      </td>
      <td>
        <h3>Consignee</h3>
        <address>
          <%= shipment.receiver_name %>
          <br>
          <%= shipment.receiver_address.pretty('<br>').html_safe %>
        </address>
        <ul class="list-unstyled list-inline margin-top">
          <% unless shipment.receiver_contact_name.blank? %>
            <li><%= shipment.receiver_contact_name %></li>
          <% end %>
          <% unless shipment.receiver_contact_phone.blank? %>
            <li><%= shipment.receiver_contact_phone.phony_formatted %></li>
          <% end %>
          <% unless shipment.receiver_contact_email.blank? %>
            <li><%= shipment.receiver_contact_email %></li>
          <% end %>
        </ul>
        <p>
          <% if not shipment.delivery_appointment_at.blank? %>
            <strong>Delivery Appointment:</strong>
            <br>
            <%= pretty_date shipment.delivery_appointment_at, shipment.shipper_address.time_zone %>
          <% else %>
            <% unless shipment.delivery_hours_start_at.blank? or shipment.delivery_hours_end_at.blank? %>
              <strong>Delivery Hours:</strong>
              <br>
              <%= shipment.delivery_hours_start_at %> - <%= shipment.delivery_hours_end_at %></strong>
            <% end %>
          <% end %>
        </p>
      </td>
      <td>
        <h3>Terms</h3>
        <p>Third Party Freight Charges Billed To:</p>
        <address>
          <% if !shipment.broker_carrier.blank? && shipment.broker_carrier.carrier.acts_as_broker? && !shipment.broker_carrier.carrier.broker_billing_address.blank? %>
            <%= shipment.broker_carrier.carrier.name %>
            <br>
            <%= shipment.broker_carrier.carrier.broker_billing_address.pretty('<br>').gsub('Apt', 'Ste').html_safe %>
          <% else %>
            <%= shipment.broker.name %>
            <br>
            <%= shipment.broker.address.pretty('<br>').gsub('Apt', 'Ste').html_safe %>
          <% end %>
        </address>
        <p>
          <% unless shipment.broker_carrier.blank? %>
            <% if !shipment.broker_carrier.account.blank? && !shipment.broker_carrier.carrier.acts_as_broker? %>
              Account #: <%= shipment.broker_carrier.account %><br>
            <% end %>
          <% end %>
          <% if !shipment.broker_carrier.blank? && !shipment.broker_carrier.carrier.acts_as_broker? %>
            <% if !shipment.quote_id.blank? || ! %>
              Quote #: <%= shipment.quote_id %><br>
            <% end %>
          <% end %>
          Terms: Third Party Prepaid
        </p>
      </td>
    </tr>
  </table>

  <h3>Instructions</h3>
  <ul class="list-unstyled">
    <% shipment.broker_accessorials.each do |broker_accessorial| %>
      <% unless broker_accessorial.broker_only? %>
        <li><%= broker_accessorial.name %></li>
      <% end %>
    <% end %>
  </ul>
  <%= simple_format shipment.broker.default_bol_notes %>
  <%= simple_format shipment.broker_carrier.default_bol_notes unless shipment.broker_carrier.blank? %>
  <%= simple_format shipment.broker_customer.default_bol_notes %>
  <%= simple_format shipment.bol_notes %>

  <table>
    <thead>
      <tr>
        <th>Units</th>
        <th>Description</th>
        <th>Dimensions (L x W x H)</th>
        <th>HZ<tiny>*</tiny></th>
        <th>Class</th>
        <th>NMFC</th>
        <th>Weight</th>
      </tr>
    </thead>
    <tbody>
      <% shipment.items.each do |item| %>
        <tr>
          <td><%= pluralize item.quantity, item.packaging.name %></td>
          <td><%= item.desc %></td>
          <td>
            <% if item.l and item.w and item.h %>
              <%= item.l %>x<%= item.w %>x<%= item.h %>
            <% end %>
          </td>
          <td><% if item.hazmat %>✓<% end %></td>
          <td><%= item.forced_freight_class ? item.forced_freight_class : item.calculated_freight_class %></td>
          </td>
          <td><%= item.nmfc %></td>
          <td>
            <%= number_with_delimiter item.weight %> lbs
          </td>
        </tr>
      <% end %>
      <tr class="total">
        <td><%= pluralize shipment.total_pieces, 'piece' %></td>
        <td class="empty">&nbsp;</td>
        <td class="empty">&nbsp;</td>
        <td class="empty">&nbsp;</td>
        <td><%= number_with_delimiter shipment.total_weight %> lbs</td>
      </tr>
    </tbody>
  </table>

  <table class="align-bottom">
    <tbody>
      <tr>
        <td>
          <p><tiny>This is to certify that the above-named materials are properly classified, described, packaged, marked and labeled, and are in proper condition for transportation according to the applicable regulations of the Department of Transportation.</tiny></p>
          <p>________________________________<br><tiny>Shipper</tiny></p>
        </td>
        <td>
          <% if shipment.value > 0 %>
            <p>The agreed or declared value of the property is hereby specifically stated by the shipper to be not exceeding
      <%= humanized_money_with_symbol shipment.value, no_cents_if_whole: false %> per shipment or <%= humanized_money_with_symbol (shipment.value / shipment.total_weight), no_cents_if_whole: false %> per pound by:</p>
          <% else %>
            <p>Shipment value not specified.</p>
          <% end %>
          <p>________________________________<br><tiny>Shipper</tiny></p>
          <p><tiny>Note: Where the rate is dependent on value, shippers are required to state in writing the agreed or declared value of the property.</tiny></p>
        </td>
        <td>
          <p><tiny>Subject to the conditions of section 7, if this shipment is to be delivered to the consignee without recourse on the consignor, the consignor shall sign the following statement: The carrier shall not make delivery of this shipment without payment of freight and all other lawful charges.</tiny></p>
          <p>________________________________<br><tiny>Consignor</tiny></p>
        </td>
      </tr>
    </tbody>
  </table>

  <p><tiny>RECEIVED, the property described above in apparent good order, except as noted (contents and condition of contents of packages unknown), marked, consigned and destined as indicated above which said carrier (the word carrier being understood throughout the contract as meaning any person or corporation in possession of the property under the contract) agrees to carry to its usual place of delivery at said destination, if on its route, otherwise to deliver to another carrier on the route to said destination. It is mutually agreed as to each carrier of all or any of said property over all or any portion of said route to destination and as to each party at any time interested in all or any said property, that every service to be performed hereunder shall be subject to all the bill of lading terms and conditions in the governing classification NMFC 100 on the date of the shipment. Shipper hereby certifies that he is familiar with all the bill of lading terms and conditions in the governing classification NMFC 100 and the said terms and conditions are hereby agreed to by the shipper and accepted for himself and his assigns.</tiny></p>

  <table>
    <tbody>
      <tr>
        <td><%= shipment.shipper_name %><br><tiny>Shipper</tiny></td>
        <td>per _____________________________</td>
        <td>Date _____________</td>
      </tr>
      <tr>
        <td><%= shipment.carrier.blank? ? '' : shipment.carrier.name %><br><tiny>Carrier</tiny></td>
        <td>per _____________________________</td>
        <td>Date _____________</td>
      </tr>
      <tr>
        <td><%= shipment.receiver_name %><br><tiny>Consignee</tiny></td>
        <td>per _____________________________</td>
        <td>Date _____________</td>
      </tr>
    </tbody>
  </table>

  <table>
    <tbody>
      <tr>
        <td>
          <p><tiny>* HZ indicates hazardous material</tiny></p>
        </td>
        <td class="text-right">
          <p><tiny>STRAIGHT BILL OF LADING (ORIGINAL NON-NEGOTIABLE)</tiny></p>
        </div>
      </tr>
    </tbody>
  </table>
<% end %>
