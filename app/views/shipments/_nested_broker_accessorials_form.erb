<%= f.hidden_field :accessorials_has_been_suggested, value: accessorials_has_been_suggested %>

<div data-controller="nested-form" data-nested-form-wrapper-selector-value=".shipment-broker-accessorial-form-wrapper">
  <template data-nested-form-target="template">
    <%= f.fields_for :shipment_broker_accessorials, ShipmentBrokerAccessorial.new, child_index: 'NEW_RECORD' do |shipment_broker_accessorial_form| %>
      <%= render 'shipments/broker_accessorial_form', f: shipment_broker_accessorial_form %>
    <% end %>
  </template>

  <%= f.fields_for :shipment_broker_accessorials do |shipment_broker_accessorial_form| %>
    <%= render 'shipments/broker_accessorial_form', f: shipment_broker_accessorial_form %>
  <% end %>

  <div data-nested-form-target="target"></div>

  <%= link_to icon('solid', 'plus', 'Add'), '#', data: { action: 'nested-form#add' }, class: 'btn btn-light' %>
</div>

<% if accessorials_has_been_suggested %>
  <div class="alert alert-info mt-4" role="alert">
    Some Services has been added. Kindly check before proceeding to create the shipment
  </div>
<% end %>