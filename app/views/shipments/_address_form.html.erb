<%= form.fields_for address_object do |address_form| %>
  <%= address_form.text_field :ref %>
  <%= address_form.text_field :street, data: { address_target: 'field' } %>
  <%= address_form.text_field :street2, label: '&nbsp;'.html_safe %>
  <%= address_form.text_field :city, data: { address_target: 'field' } %>
  <%= address_form.select :region_iso31662,
                          (address_form.object.region_iso31662.blank? ? [[fallback_address.region.name, fallback_address.region.id]] : [[address_form.object.region.name, address_form.object.region_iso31662]]),
                          { label: 'State' },
                          data: { 'address-target': 'regions' },
                          class: 'form-select' %>

  <%= address_form.text_field :zip_code,
                              label: 'ZIP',
                              data: { action: "keyup->address#fillCityAndStateByZipCode", address_target: 'field' },
                              help: "City and State will be filled based from ZIP" %>

  <%= address_form.select :country_alpha2,
                          country_options(Transponder::ORM::Country.order(:name), address_form.object.country_alpha2),
                          { selected: (address_form.object.country_alpha2.blank? ? fallback_address.country_alpha2 : address_form.object.country_alpha2) },
                          data: { action: 'address#handle', 'address-target': 'country' },
                          class: 'form-select' %>

  <%= address_form.hidden_field :standardized_address_id, data: { address_target: 'standardizedAddressId'} %>

  <div class="text-warning my-4 d-none" data-address-target="validateAddressLoading"> 
    <div class="spinner-border spinner-border-sm text-warning" role="status">
      <span class="visually-hidden">Loading...</span>
    </div>
    Validating Address ...
  </div>

  <div class="text-danger my-4 d-none" data-address-target="validateAddressFailed"> 
    <%= icon('solid', 'exclamation', 'Address not found with SmartyStreets Address Verification. Ensure address is correct.')%>
  </div>

  <div class="text-success my-4 d-none" data-address-target="validateAddressSuccess"> 
    <%= icon('solid', 'check', 'Address Verified via SmartyStreets Verification')%>
  </div>
<% end %>