<div class="row">
  <div class="col col-md-4">
    <%= bootstrap_form_with(url: tracking_path, method: :get, layout: :inline, class: 'form-inline') do |f| %>
      <%= f.text_field :load_id, hide_label: true, placeholder: 'Load', autofocus: !defined?(@shipment), value: (load_id ? load_id : '') %>
      <%= f.submit class: 'btn btn-primary ms-2', value: (defined?(@shipment) ? 'Track Another' : 'Track') %>
    <% end %>
  </div>
</div>
