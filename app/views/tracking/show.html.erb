<% unless @shipment.blank? %>
  <% provide :title, "Track Shipment - Load #{@shipment.load_id}" %>
<% else %>
  <% provide :title, "Track Shipment" %>
<% end %>

<% unless @shipment.blank? %>
  <%= render 'results', load_id: @load_id, shipment: @shipment %>
  <%= render 'form', load_id: @load_id %>
<% else %>
  <div class="page-header mb-4">
    <h1><%= yield :title %></h1>
  </div>

  <%= render 'form', load_id: @load_id %>

  <% unless @load_id.blank? %>
    <div class="row">
      <div class="col col-md-6">
        <%= render 'layouts/no_content' %>
      </div>
    </div>
  <% end %>
<% end %>
