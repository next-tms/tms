<h1>Notifications </h1>
<p>
  Total: <b> <%= @notifications.count %> </b> |
  Unread: <b> <%= @notifications.unread.count %> </b>
</p>

<% unless @q.blank? %>
  <div class="row">
    <div class="col">
      <%= render 'layouts/pagy', pagy: @pagy %>
    </div>
    <div class="col-auto float-right">
      <%= search_form_for(@q, url: request.path, class: 'form-inline mb-3') do |f| %>
        <%= f.text_field :params_cont, value: params.dig(:q, :params_cont), placeholder: 'Filter', class: 'form-control mr-2' %>
        <%= f.submit 'Filter', class: 'btn btn-primary' %>
      <% end %>
    </div>
  </div>
<% end %>

<% @notifications.each do |notification| %>
  <%= link_to notification_path(notification.id) do %>
    <div class="card">
      <div class="card-body d-flex flex-direction-row justify-content-between <%= notification.read? ? 'fw-normal text-dark' : 'fw-bold' %>">
        <div> <%= notification.to_notification.message %> </div>
        <div class="fw-normal text-dark"> <%= pretty_date notification.created_at, current_user.time_zone %></div>
      </div>
    </div>
  <% end %>
<% end %>
