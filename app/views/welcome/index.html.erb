<% if @website %>
  <% provide :title, 'The best rates. Everyday.' %>
<% else %>
  <% provide :title, 'Full-featured TMS solution for 3PL LTL shipments' %>
<% end %>
<% provide :no_container, 'yes' %>

<div class="jumbotron rounded-0 bg-primary text-white">
  <div class="container-fluid">
    <h1 class="display-4"><%= @website ? @website.broker.name : t(:app_name) %></h1>
    <p class="bd-lead"><%= yield :title %></p>
  </div>
</div>

<section>
  <div class="container-fluid">
    <div class="row">
      <div class="col-xs-6 col-sm-6 col-md-4 col-lg-4">
        <p class="h6"><%= icon 'fas', 'map-marker', 'Validation' %></p>
        <p>Avoid surprises with automatic address validation</p>
      </div>
      <div class="col-xs-6 col-sm-6 col-md-4 col-lg-4">
        <p class="h6"><%= icon 'fas', 'handshake', 'Instant Quote' %></p>
        <p>Instantly provide quotes to your customers with their budget in mind — and yours</p>
      </div>
      <div class="col-xs-6 col-sm-6 col-md-4 col-lg-4">
        <p class="h6"><%= icon 'fas', 'truck', 'In-Transit Fees' %></p>
        <p>Request approval of additional in-transit fees easily and quickly when they occur</p>
      </div>
      <div class="col-xs-6 col-sm-6 col-md-4 col-lg-4">
        <p class="h6"><%= icon 'fas', 'clipboard-list', 'Preempt' %></p>
        <p>Automatically reminds you and your carriers when shipments are running late</p>
      </div>
      <div class="col-xs-6 col-sm-6 col-md-4 col-lg-4">
        <p class="h6"><%= icon 'fas', 'calendar-check', 'Quick Resolve' %></p>
        <p>Detect shipping delays <em>before</em> they happen and impress your customers</p>
      </div>
    </div>
  </div>
</section>