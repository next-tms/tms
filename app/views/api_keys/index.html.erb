<% provide :title, t(".titles.#{action_name}") %>

<%= render 'header' %>
<h2><%= yield :title %></h2>

<p><%= t('.intro_html', max_ttl: t('datetime.distance_in_words.x_days', count: APIKey::MAX_TTL.in_days.to_i), model_name_plural: APIKey.model_name.human(count: 2)) %></p>

<ul>
  <li><%= t('.broker_ware_html', path: tag.code('/api/v1'), token_path: tag.code(broker_ware_connect_token_path)) %></li>
  <li><%= t('.dsdc_html', path: tag.code('/api/dsdc')) %></li>
  <li><%= t('.freightview_html', path: tag.code('/api/v2.0')) %></li>
  <li><%= t('.graphql_html', graphiql: link_to('GraphiQL', graphiql_path, data: { turbo: false }), path: tag.code(graphql_path)) %></li>
</ul>

<% if @api_keys.any? %>
  <%= render 'layouts/pagy', pagy: @pagy %>

  <div class="table-responsive">
    <table class="table table-condensed table-borderless table-striped table-hover h-100">
      <thead>
        <tr>
          <% %i[name token_suffix expires_at last_used_at].each do |attribute| %>
            <th><%= sort_link @q, attribute, APIKey.human_attribute_name(attribute) %></th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% @api_keys.each do |api_key| %>
          <tr>
            <td><%= link_to api_key.name, api_key %></td>
            <td><code><%= APIKey::TOKEN_PREFIX %>…<%= api_key.token_suffix %></code></td>
            <td><%= time(api_key.expires_at) %></td>
            <td><%= time(api_key.last_used_at) || t('.never') %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%= render 'layouts/pagy', pagy: @pagy %>
<% else %>
  <%= render 'layouts/no_content' %>
<% end %>
