<% unless q.blank? %>
  <div class="row">
    <div class="col">
      <%= render 'layouts/pagy', pagy: @pagy %>
    </div>
    <div class="col-auto float-right">
      <div class="btn-toolbar mb-3">
        <div class="btn-group">
          <%= search_form_for(q, url: request.path, method: :get, local: true, class: 'form-inline') do |f| %>
            <%= f.hidden_field :sorts, value: q.sorts %>
            <%= f.text_field :address_region_abbreviation_or_address_region_name_or_address_city_or_address_street_or_address_zip_code_cont, placeholder: 'Filter', class: 'form-control mr-2' %>
            <%= f.submit 'Filter', class: 'btn btn-primary' %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>
