<% provide :signature, @pickup.shipment.broker.name %>

<p><%= @pickup.shipment.broker_customer&.customer.blank? ? 'Load' : "#{@pickup.shipment.broker_customer.customer.name} load" %> <%= @pickup.shipment.load_id %> has been received <% unless @pickup.shipment.broker_carrier.blank? %> by <%= @pickup.shipment.broker_carrier.carrier.name %><% end %> via API.</p>

<p>From:</p>
<address>
  <%= @pickup.shipment.shipper_name %>
  <br>
  <%= @pickup.shipment.shipper_address.pretty('<br>').html_safe %>
</address>

<p>To:</p>
<address>
  <%= @pickup.shipment.receiver_name %>
  <br>
  <%= @pickup.shipment.receiver_address.pretty('<br>').html_safe %>
</address>

<p>
  <% @pickup.shipment.items.each do |item| %>
    <%= pluralize(item.quantity, item.packaging.name) %> <%= item.desc %> <% if item.l and item.w and item.h %><%= item.l %>x<%= item.w %>x<%= item.h %> in<% end %> <%= number_with_delimiter item.weight %> lbs
    <% unless @pickup.shipment.items.last == item %><br><% end %>
  <% end %>
</p>

<%= link_to "View shipment here", broker_shipment_url(@pickup.shipment, host: ENV.fetch('DOMAIN')) %>
