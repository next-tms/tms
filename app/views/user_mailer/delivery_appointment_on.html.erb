<% provide :signature, @shipment.broker.name %>

<p><%= @shipment.broker_customer.customer.name %> load <%= @shipment.load_id %> has been scheduled for delivery<% unless @shipment.broker_carrier.blank? %> with <%= @shipment.broker_carrier.carrier.name %><% end %>.</p>

<p><strong>Appointment:</strong> <%= @shipment.delivery_appointment_on %></p>

<p>From:</p>
<address>
  <%= @shipment.shipper_name %>
  <br>
  <%= @shipment.shipper_address.pretty('<br>').html_safe %>
</address>

<p>To:</p>
<address>
  <%= @shipment.receiver_name %>
  <br>
  <%= @shipment.receiver_address.pretty('<br>').html_safe %>
</address>

<p>
  <% @shipment.items.each do |item| %>
    <%= pluralize(item.quantity, item.packaging.name) %> <%= item.desc %> <% if item.l and item.w and item.h %><%= item.l %>x<%= item.w %>x<%= item.h %> in<% end %> <%= number_with_delimiter item.weight %> lbs
    <% unless @shipment.items.last == item %><br><% end %>
  <% end %>
</p>

<%= link_to "View on our website", broker_shipment_url(@shipment, host: @shipment.broker_customer.broker.websites.first.domain) %>