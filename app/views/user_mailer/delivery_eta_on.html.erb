<% provide :signature, Setting.value!(:name) %>

<p><%= @shipment.broker_customer&.customer.blank? ? 'Load' : "#{@shipment.broker_customer.customer.name} load" %> <%= @shipment.load_id %> has an updated ETA <% unless @shipment.broker_carrier.blank? %> from <%= @shipment.broker_carrier.carrier.name %><% end %>.</p>

<p><strong>Delivery ETA:</strong> <%= @shipment.delivery_eta_on %></p>

<p>From:</p>
<address>
  <%= @shipment.shipper_address.name %>
  <br>
  <%= @shipment.shipper_address.pretty('<br>').html_safe %>
</address>

<p>To:</p>
<address>
  <%= @shipment.receiver_address.name %>
  <br>
  <%= @shipment.receiver_address.pretty('<br>').html_safe %>
</address>

<p>
  <% @shipment.items.each do |item| %>
    <%= pluralize(item.quantity, item.packaging.name) %> <%= item.desc %> <% if item.l and item.w and item.h %><%= item.l %>x<%= item.w %>x<%= item.h %> in<% end %> <%= number_with_delimiter item.weight %> lbs
    <% unless @shipment.items.last == item %><br><% end %>
  <% end %>
</p>

<%= link_to "View shipment here", broker_shipment_url(@shipment, host: ENV.fetch('DOMAIN', 'localhost')) %>
