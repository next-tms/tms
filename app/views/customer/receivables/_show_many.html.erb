<%= turbo_frame_tag :receivables do %>
  <% unless receivables.blank? %>
    <%= render 'broker/receivables/search_form', q: q %>

    <div class="table-responsive">
      <table class="table table-condensed table-borderless table-striped table-hover h-100">
        <thead>
          <tr>
            <th><%= sort_link q, :shipment_load_id, '#' %></th>
            <th><%= sort_link q, :due_by, 'Due' %></th>
            <th class="text-nowrap"><%= sort_link q, :paid_at, 'Paid On' %></th>
            <th><%= sort_link q, :total_cents, 'Total' %></th>
          </tr>
        </thead>
        <tbody>
          <% receivables.each do |receivable| %>
            <tr>
              <td><%= link_to receivable.shipment.load_id, customer_receivable_path(receivable), target: '_top' %></td>
              <td><%= short_date receivable.due_by, current_user.time_zone %></td>
              <td><%= short_date receivable.paid_at, current_user.time_zone %></td>
              <td><%= humanized_money_with_symbol receivable.total, no_cents_if_whole: false %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%= render 'layouts/pagy', pagy: @pagy %>
  <% else %>
    <%= render 'layouts/no_content' %>
  <% end %>
<% end %>
