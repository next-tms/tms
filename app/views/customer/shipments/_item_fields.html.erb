<div class="nested-fields form-inline form-row mb-2">
  <%= f.hidden_field :_destroy %>
  <%= f.number_field :quantity, hide_label: true, placeholder: 'Quantity', class: 'mr-1 col-1', wrapper: false, min: 1 %>
  <%= f.select :packaging_id, Packaging.order(:name).all.collect {|c| [ c.name, c.id ] }, { label: 'Packaging', hide_label: true }, class: 'mr-2 col', wrapper: false %>
  <%= f.text_field :desc, hide_label: 'true', placeholder: 'Description', class: 'mr-2 col', wrapper: false %>
  <%= f.text_field :l, hide_label: true, placeholder: 'L', class: 'mr-1 col-1', wrapper: false %>
  <%= f.text_field :w, hide_label: true, placeholder: 'W', class: 'mr-1 col-1', wrapper: false %>
  <%= f.text_field :h, hide_label: true, placeholder: 'H', class: 'mr-1 col-1', wrapper: false %>
  <%= f.text_field :weight, hide_label: true, placeholder: 'lbs', class: 'mr-2 col-1', wrapper: false %>
  <%= f.text_field :nmfc, hide_label: true, placeholder: 'NMFC', class: 'mr-1 col-2', wrapper: false %>
  <% unless current_user.broker_customer.valid_freight_classes.blank? %>
    <% if current_user.broker_customer.enable_auto_freight_class %>
      <%= f.select :forced_class, [['Auto', nil]] + current_user.broker_customer.valid_freight_classes.collect { |c| [c, c] }, { label: 'Class', hide_label: true, selected: f.object.forced_class }, class: 'mr-2 col', wrapper: false %>
    <% else %>
      <%= f.select :forced_class, current_user.broker_customer.valid_freight_classes.collect { |c| [c, c] }, { label: 'Class', hide_label: true, selected: f.object.forced_class }, class: 'mr-2 col', wrapper: false %>
    <% end %>
  <% else %>
    <% if current_user.broker_customer.enable_auto_freight_class %>
      <%= f.select :forced_class, [['Auto', nil]] + valid_classes.collect { |c| [c, c] }, { label: 'Class', hide_label: true, selected: f.object.forced_class }, class: 'mr-2 col', wrapper: false %>
    <% else %>
      <%= f.select :forced_class, valid_classes.collect { |c| [c, c] }, { label: 'Class', hide_label: true, selected: f.object.forced_class }, class: 'mr-2 col', wrapper: false %>
    <% end %>
  <% end %>
  <div class="col">
    <%= link_to icon('fas', 'trash'), '#', class: 'remove-fields btn btn-light' %>
  </div>
</div>