<%= bootstrap_form_with(model: [:customer, @shipment], data: { turbo: false }, layout: :horizontal) do |f| %>
  <%= f.alert_message "Unable to create quote:" %>
  <%= f.hidden_field :quote_only, value: true %>

  <div class="row">
    <div class="col-sm-6 col-md-3">
      <p class="col-title"><%= icon 'solid', 'industry', 'Shipper' %></p>

      <div data-controller="address">
        <%= f.fields_for :shipper_address do |shipper_address_form| %>
          <%= shipper_address_form.select :country_alpha2, country_options(BrokerCountry.countries.order(:name), shipper_address_form.object.country_alpha2), { selected: (shipper_address_form.object.country_alpha2.blank? ? current_user.companyable.primary_pickup_address.country_alpha2 : shipper_address_form.object.country_alpha2) }, data: { action: 'address#handle', 'address-target': 'country' }, class: 'form-select' %>
          <%= shipper_address_form.text_field :zip_code, data: { address_target: 'postalCode' } %>
          <%= shipper_address_form.text_field :city, data: { address_target: 'city' } %>
          <%= shipper_address_form.select :region_iso31662, (shipper_address_form.object.region_iso31662.blank? ? [[current_user.companyable.primary_pickup_address.region.name, current_user.companyable.primary_pickup_address.region.id]] : [[shipper_address_form.object.region.name, shipper_address_form.object.region_iso31662]]), {}, data: { 'address-target': 'regions' }, class: 'form-select' %>
        <% end %>
      </div>
    </div>

    <div class="col-sm-6 col-md-3">
      <p class="col-title"><%= icon 'solid', 'cart-arrow-down', 'Receiver' %></p>

      <div data-controller="address">
        <%= f.fields_for :receiver_address do |receiver_address_form| %>
          <%= receiver_address_form.select :country_alpha2, country_options(BrokerCountry.countries.order(:name), receiver_address_form.object.country_alpha2), { selected: (receiver_address_form.object.country_alpha2.blank? ? current_user.companyable.primary_pickup_address.country_alpha2 : receiver_address_form.object.country_alpha2) }, data: { action: 'address#handle', 'address-target': 'country' }, class: 'form-select' %>
          <%= receiver_address_form.text_field :zip_code, data: { address_target: 'postalCode' } %>
          <%= receiver_address_form.text_field :city, data: { address_target: 'city' } %>
          <%= receiver_address_form.select :region_iso31662, (receiver_address_form.object.region_iso31662.blank? ? [[current_user.companyable.primary_pickup_address.region.name, current_user.companyable.primary_pickup_address.region.id]] : [[receiver_address_form.object.region.name, receiver_address_form.object.region_iso31662]]), {}, data: { 'address-target': 'regions' }, class: 'form-select' %>
        <% end %>
      </div>
    </div>

    <div class="col-sm-6 col-md-3">
      <p class="col-title"><%= icon 'solid', 'barcode', 'References' %></p>
      <%= f.text_field :shipper_reference, autocomplete: 'off' %>
      <%= f.text_field :customer_reference, autocomplete: 'off' %>
      <%= f.text_field :bol, autocomplete: 'off' %>
    </div>

    <div class="col-sm-6 col-md-3">
      <p class="col-title"><%= icon 'solid', 'dollar-sign', 'Value' %></p>
      <%= f.text_field :value, prepend: '$', data: money_controller_data, autocomplete: 'off' %>
    </div>
  </div>

  <p class="col-title mt-4">Services</p>
  <%= render 'shipments/nested_accessorials_form',
             f: f,
             accessorials_has_been_suggested: @accessorials_has_been_suggested %>

  <p class="col-title mt-4">Freight</p>
  <%= f.check_box :truckload, class: 'mb-4' %>
  <div data-controller="nested-form" data-nested-form-wrapper-selector-value=".item-form-wrapper">
    <template data-nested-form-target="template">
      <%= f.fields_for :items, Item.new, child_index: 'NEW_RECORD' do |item_form| %>
        <%= render 'shipments/item_form', f: item_form %>
      <% end %>
    </template>

    <%= f.fields_for :items do |item_form| %>
      <%= render 'shipments/item_form', f: item_form %>
    <% end %>

    <div data-nested-form-target="target"></div>

    <%= link_to icon('solid', 'plus', 'Add'), '#', data: { action: 'nested-form#add' }, class: 'btn btn-light' %>
  </div>

  <div class="form-group">
    <%= f.submit class: 'btn btn-primary mt-4', value: 'Quote' %>
  </div>

<% end %>
