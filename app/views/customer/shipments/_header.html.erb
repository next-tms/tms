<div class="page-header p-4 mb-4">
  <h1 class="mb-6">Shipments</h1>

  <table class="table table-borderless">
    <thead>
      <tr>
        <th>Entered</th>
        <th>Quoted</th>
        <th>Pickups</th>
        <th>In Transit</th>
        <th>Delivered</th>
        <th></th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td class="display-6">
          <%= link_to current_user.shipments.pending_quotation.size, customer_shipments_pending_quotation_path, class: 'shipments-pending-quotation' %>
        </td>
        <td class="display-6">
          <%= link_to current_user.shipments.pending_dispatch.size, customer_shipments_pending_dispatch_path, class: 'shipments-pending-dispatch' %>
        </td>
        <td class="display-6">
          <%= link_to current_user.shipments.pending_pickup.size, customer_shipments_pending_pickup_path, class: 'shipments-pending-pickup' %>
        </td>
        <td class="display-6">
          <%= link_to current_user.shipments.pending_delivery.size, customer_shipments_pending_delivery_path, class: 'shipments-pending-delivery' %>
        </td>
        <td class="display-6">
          <%= link_to current_user.shipments.delivered.size, customer_shipments_delivered_path, class: 'shipments-delivered' %>
        </td>
        <td class="display-6">
          <%= link_to icon('solid', 'plus', 'Add'), new_customer_shipment_path, class: 'btn' %>
          <%= link_to icon('solid', 'plus', 'Fast Quote'), customer_quote_only_path, class: 'btn' %>
        </td>
      </tr>
    </tbody>
  </table>
</div>
