<nav class="nav border-top pt-4 mb-0">
  <% unless @shipment.quote_only? %>
    <%= link_to 'Overview', customer_shipment_path(@shipment), class: 'nav-link shipments-show' %>
  <% end %>

  <% if @shipment.picked_up_at.blank? %>
    <%= link_to 'Edit', edit_customer_shipment_path(@shipment), class: 'nav-link shipments-edit' %>
  <% end %>

  <% unless @shipment.picked_up? %>
    <a class="nav-link dropdown-toggle" href="#" id="shipment-mark-dropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
      Update
    </a>
    <ul class="dropdown-menu" aria-labelledby="shipment-mark-dropdown">
      <% if @shipment.booked_at.blank? %>
        <%= link_to 'Request Pickup',
                    customer_shipment_path(@shipment, shipment: { booked_at: 'now', canceled_at: nil }),
                    data: { turbo_method: :patch },
                    class: 'dropdown-item'
        %>
      <% else %>
        <%= link_to 'Pickup Requested', '#', class: 'dropdown-item disabled' %>
      <% end %>

      <% if @shipment.canceled_at.present? %>
        <%= link_to 'Reinstate',
                    customer_shipment_path(@shipment, shipment: { booked_at: nil, canceled_at: nil }),
                    data: { turbo_method: :patch },
                    class: 'dropdown-item'
        %>
      <% elsif @shipment.picked_up_at.blank? %>
        <%= link_to 'Cancel',
                    customer_shipment_path(@shipment, shipment: { booked_at: nil, canceled_at: 'now' }),
                    data: { turbo_confirm: 'Are you sure you want to cancel this shipment?', turbo_method: :patch },
                    class: 'dropdown-item'
        %>
      <% end %>
    </ul>
  <% end %>

  <% unless @shipment.booked_at.present? || @shipment.picked_up? %>
    <%= link_to 'Rates', quote_customer_shipment_path(@shipment), class: 'nav-link shipments-quote' %>
  <% end %>

  <% unless @shipment.booked_at.blank? %>
    <%= link_to 'Documents', documents_customer_shipment_path(@shipment), class: 'nav-link shipments-documents' %>

    <% unless @shipment.picked_up_at.blank? %>
      <li class="navbar-item"><%= link_to 'Tracking', tracking_path(load_id: @shipment.load_id), class: 'nav-link' %></li>
    <% end %>
  <% end %>

  <% unless @shipment.quote_only? %>
    <a class="nav-link dropdown-toggle" href="#" id="shipment-download-dropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
      Download
    </a>
    <ul class="dropdown-menu" aria-labelledby="shipment-download-dropdown">
      <%= link_to 'eBOL', [ :customer, @shipment, { format: :ebol } ], data: { turbo: false }, class: 'dropdown-item' %>
    </ul>
  <% end %>
</nav>
