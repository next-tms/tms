<div class="navbar navbar-menu navbar-expand">
  <div class="container-fluid">
    <ul class="navbar-nav">
      <% if not action_name == 'index' %>
        <li class="navbar-item"><%= link_to icon('fas', 'level-up-alt', 'Shipments'), customer_shipments_path, class: 'nav-link' %></li>
      <% end %>
      <% if @shipment and @shipment.id %>
        <li class="navbar-item"><%= link_to icon('fas', 'asterisk', 'Overview'), customer_shipment_path(@shipment), class: 'nav-link' %></li>
        <% if @shipment.booked_at.blank? && !@shipment.total_charges.blank? %>
          <li class="navbar-item"><%= link_to icon('fas', 'truck-loading', 'Request Pickup'), book_customer_shipment_path(@shipment), class: 'nav-link' %></li>
        <% elsif !@shipment.booked_at.blank? %>
          <li class="navbar-item"><%= link_to icon('fas', 'truck-loading', 'Pickup Requested'), '#', class: 'nav-link disabled' %></li>
        <% end %>
        <li class="navbar-item"><%= link_to icon('fas', 'pencil-alt', 'Edit'), edit_customer_shipment_path(@shipment), class: 'nav-link' %></li>
        <% if current_user.broker_customer.can_quote? %>
          <li class="navbar-item"><%= link_to icon('fas', 'project-diagram', 'Rates'), quote_customer_shipment_path(@shipment), class: 'nav-link' %></li>
        <% end %>
        <li class="navbar-item"><%= link_to icon('fas', 'file-invoice', 'Documents'), documents_customer_shipment_path(@shipment), class: 'nav-link' %></li>
        <% unless @shipment.picked_up_at.blank? %>
          <li class="navbar-item"><%= link_to icon('fas', 'truck-moving', 'Tracking'), tracking_path(load_id: @shipment.load_id), class: 'nav-link' %></li>
        <% end %>
      <% else %>
        <% if not current_page? action: 'new' and not current_page? action: 'new_quote_only' %>
          <li class="navbar-item"><%= link_to icon('fas', 'plus', 'Shipment'), new_customer_shipment_path, class: 'nav-link' %></li>
          <% if current_user.broker_customer.can_quote? %>
            <li class="navbar-item"><%= link_to icon('fas', 'plus', 'Quote'), customer_quote_only_path, class: 'nav-link' %></li>
          <% end %>
          <%= link_to customer_shipments_pending_quotation_path, class: 'nav-link' do %>
            <%= icon 'far', 'keyboard', 'Entered' %>
            <%= maybe_badge Shipment.where(broker_customer: [ current_user.broker_customers ]).active.pending_quotation.or(Shipment.where(broker_customer: [ current_user.broker_customers ]).canceled_recently).distinct.size, type: 'bg-dark' %>
          <% end %>
        </li>
        <li class="navbar-item">
          <%= link_to customer_shipments_pending_dispatch_path, class: 'nav-link' do %>
            <%= icon 'fas', 'file-invoice-dollar', 'Quotes' %>
            <%= maybe_badge Shipment.where(broker_customer: [ current_user.broker_customers ]).active.pending_dispatch.size, type: 'bg-dark' %>
          <% end %>
        </li>
          <li class="navbar-item">
            <%= link_to customer_shipments_booked_path, class: 'nav-link' do %>
              <%= icon 'fas', 'bell', 'Booked' %>
              <%= maybe_badge Shipment.where(broker_customer: current_user.broker_customer).active.booked.size, type: 'bg-dark' %>
            <% end %>
          </li>
        <li class="navbar-item">
          <%= link_to customer_shipments_pending_pickup_path, class: 'nav-link' do %>
            <%= icon 'fas', 'truck-loading', 'Pickups' %>
            <%= maybe_badge Shipment.where(broker_customer: current_user.broker_customer).active.pending_pickup.size, type: 'bg-dark' %>
          <% end %>
        </li>
          <li class="navbar-item">
            <%= link_to customer_shipments_pending_delivery_path, class: 'nav-link' do %>
              <%= icon 'fas', 'arrow-circle-right', 'In Transit' %>
              <%= maybe_badge Shipment.where(broker_customer: current_user.broker_customer).active.pending_delivery.size, type: 'bg-dark' %>
            <% end %>
          </li>
          <li class="navbar-item">
            <%= link_to icon('fas', 'check-square', 'Delivered'), customer_shipments_delivered_path, class: 'nav-link' %>
          </li>
        <% else %>
          <li class="navbar-item"><%= link_to icon('fas', 'bomb', 'Reset'), new_customer_shipment_path, data: { confirm: 'Reset the form? Unsaved changes will be lost.' }, class: 'nav-link' %></li>
        <% end %>
      <% end %>
    </ul>
  </div>
</div>