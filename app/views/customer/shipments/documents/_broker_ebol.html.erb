<tr id="<%= this_dom_id %>_broker_ebol">
  <% if shipment.broker_ebol.attached? %>
    <td><%= Setting.value!(:name) %></td>
    <td>eBOL</td>
    <td>
      <%= link_to icon('solid', 'eye', 'View'), rails_blob_path(shipment.broker_ebol, disposition: 'preview'), target: '_blank' %>
    </td>
    <td>
      <%= link_to icon('solid', 'file-download', 'Download'),
                  rails_blob_path(shipment.broker_ebol, disposition: 'attachment'),
                  data: { turbo: false }
      %>
    </td>
  <% end %>
</tr>
