<tr id="<%= this_dom_id %>_carrier_label">
  <% if shipment.broker_carrier.present? && shipment.carrier_label.attached? %>
    <td><%= shipment.broker_carrier.carrier.name %></td>
    <td>Bill of Lading</td>
    <td>
      <%= link_to icon('solid', 'eye', 'View'), rails_blob_path(shipment.carrier_label, disposition: 'preview'), target: '_blank' %>
    </td>
    <td>
      <%= link_to icon('solid', 'file-download', 'Download'),
                  rails_blob_path(shipment.carrier_label, disposition: 'attachment'),
                  data: { turbo: false }
      %>
    </td>
  <% end %>
</tr>
