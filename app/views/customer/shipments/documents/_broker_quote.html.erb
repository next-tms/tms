<tr id="<%= this_dom_id %>_broker_quote">
  <% if shipment.broker_quote_valid? && shipment.broker_quote.attached? %>
    <td><%= shipment.broker.name %></td>
    <td>Quote</td>
    <td>
      <%= link_to icon('solid', 'eye', 'View'), rails_blob_path(shipment.broker_quote, disposition: 'preview'), target: '_blank' %>
    </td>
    <td>
      <%= link_to icon('solid', 'file-download', 'Download'),
                  rails_blob_path(shipment.broker_quote, disposition: 'attachment'),
                  data: { turbo: false }
      %>
    </td>
  <% end %>
</tr>
