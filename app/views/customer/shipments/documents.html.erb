<% provide :title, 'Documents' %>

<%= render 'member_header' %>

<h2><%= yield :title %></h2>

<div class="row">
  <div class="col col-md-8">
    <div class="table-responsive">
      <table class="table table-borderless table-striped">
        <thead>
          <tr>
            <th>Author</th>
            <th>Kind</th>
            <th></th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% if @shipment.broker_quote_valid? %>
            <tr>
              <td><%= @shipment.broker.name %></td>
              <td>Quote</td>
              <td><%= link_to icon('fas', 'eye', 'View'), rails_blob_path(@shipment.broker_quote, disposition: 'preview'), 'data-turquoteinks': 'false', target: '_blank' %></td>
              <td><%= link_to icon('fas', 'file-download', 'Download'), rails_blob_path(@shipment.broker_quote, disposition: 'attachment'), 'data-turquoteinks': 'false', download: "#{@shipment.load_id} Quote.pdf" %></td>
            </tr>
          <% end %>

          <% if @shipment.broker_bol_valid? %>
            <tr>
              <td><%= @shipment.broker.name %></td>
              <td>Bill of Lading</td>
              <td><%= link_to icon('fas', 'eye', 'View'), rails_blob_path(@shipment.broker_bol, disposition: 'preview'), 'data-turbo': 'false', target: '_blank' %></td>
              <td><%= link_to icon('fas', 'file-download', 'Download'), rails_blob_path(@shipment.broker_bol, disposition: 'attachment'), 'data-turbo': 'false', download: "#{@shipment.load_id} BOL.pdf" %></td>
            </tr>
          <% end %>

          <% unless @shipment.carrier_bol.blank? %>
            <tr>
              <td><%= @shipment.broker_carrier.carrier.name %></td>
              <td>Bill of Lading</td>
              <td><%= link_to icon('fas', 'eye', 'View'), rails_blob_path(@shipment.carrier_bol, disposition: 'preview'), 'data-turbo': 'false', target: '_blank' %></td>
              <td><%= link_to icon('fas', 'file-download', 'Download'), rails_blob_path(@shipment.carrier_bol, disposition: 'attachment'), 'data-turbo': 'false', download: "#{@shipment.load_id} BOL - #{@shipment.broker_carrier.carrier.name}.pdf" %></td>
            </tr>
          <% end %>

          <!--
          <% unless @shipment.carrier_pod.blank? %>
            <tr>
              <td><%= @shipment.broker_carrier.carrier.name %></td>
              <td>Proof of Delivery</td>
              <td><%= link_to icon('fas', 'eye', 'View'), rails_blob_path(@shipment.carrier_pod, disposition: 'preview'), target: '_blank' %></td>
              <td><%= link_to icon('fas', 'file-download', 'Download'), rails_blob_path(@shipment.carrier_pod, disposition: 'attachment'), download: "#{@shipment.load_id} POD.pdf" %></td>
            </tr>
          <% end %>
          -->
        <tbody>
      </table>
    </div>
  </div>
</div>
