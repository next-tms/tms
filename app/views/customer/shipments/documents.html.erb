<% provide :title, 'Documents' %>

<%= turbo_stream_from @shipment, :documents %>

<%= render 'member_header' %>

<h2><%= yield :title %></h2>

<div class="row">
  <div class="col col-md-8">

    <div id="<%="#{dom_id(@shipment)}_document_notification"%>"></div>

    <div class="table-responsive">
      <table class="table table-borderless table-striped">
        <thead>
          <tr>
            <th>Author</th>
            <th>Kind</th>
            <th></th>
            <th></th>
          </tr>
        </thead>
        <tbody id="<%="#{dom_id(@shipment)}_documents_table_body"%>">
          <% if @shipment.broker_quote_valid? %>
            <tr>
              <td><%= @shipment.broker.name %></td>
              <td>Quote</td>
            </tr>
          <% end %>

          <% if @shipment.carrier_label.attached? %>
            <tr>
              <td><%= @shipment.broker_carrier.carrier.name %></td>
              <td>Bill of Lading</td>
              <td><%= link_to icon('solid', 'eye', 'View'), rails_blob_path(@shipment.carrier_label, disposition: 'preview'), 'data-turbo': 'false', target: '_blank' %></td>
              <td><%= link_to icon('solid', 'file-download', 'Download'), rails_blob_path(@shipment.carrier_label, disposition: 'attachment'), 'data-turbo': 'false', download: "#{@shipment.load_id} BOL.pdf" %></td>
            </tr>
          <% end %>

          <% if @shipment.broker_bol_valid? %>
            <tr>
              <td><%= @shipment.broker.name %></td>
              <td>Scanned Bill of Lading</td>
            </tr>

            <% if @shipment.broker_label.attached? %>
              <tr>
                <td><%= @shipment.broker.name %></td>
                <td>Labels</td>
                <td><%= link_to icon('solid', 'eye', 'View'), rails_blob_path(@shipment.broker_label, disposition: 'preview'), 'data-turbo': 'false', target: '_blank' %></td>
                <td><%= link_to icon('solid', 'file-download', 'Download'), rails_blob_path(@shipment.broker_label, disposition: 'attachment'), 'data-turbo': 'false', download: "#{@shipment.load_id} BOL.pdf" %></td>
                <td><%= link_to icon('solid', 'paper-plane', 'Send'), send_document_broker_shipment_path(@shipment, shipment_method: 'broker_label'), data: { 'turbo-frame': 'modal' } %></td>
                <td></td>
              </tr>
            <% end %>
          <% end %>

          <% if @shipment.carrier_pod.attached? %>
            <tr>
              <td><%= @shipment.broker_carrier.carrier.name %></td>
              <td>Proof of Delivery</td>
              <td><%= link_to icon('solid', 'eye', 'View'), rails_blob_path(@shipment.carrier_pod, disposition: 'preview'), target: '_blank' %></td>
              <td><%= link_to icon('solid', 'file-download', 'Download'), rails_blob_path(@shipment.carrier_pod, disposition: 'attachment'), download: "#{@shipment.load_id} POD.pdf" %></td>
            </tr>
          <% end %>
        <tbody>
      </table>
    </div>
  </div>
</div>
