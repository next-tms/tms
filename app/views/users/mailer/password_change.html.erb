<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <style>
body {
  font-smoothing: antialiased;
  font-family: -apple-system, BlinkMacSystemFont, "segoe ui", Roboto, "helvetica neue", Arial, sans-serif, "apple color emoji", "segoe ui emoji", "segoe ui symbol", "noto color emoji";
  font-size: 16px;
}

.brand {
  font-size: 24px;
  line-height: 30px;
  font-weight: 300;
  height: 100%;
}

.title {
  font-size: 16px;
  font-weight: 500;
}

.signature {
  margin-top: 15px;
}

.img-logo { height: 30px; width: auto; }
.float-start { float: left; }
.clear { clear: both; }
.display-inline { display: inline; }
    </style>
  </head>

  <body>
    <p class="title">Password Changed</p>
    <p>Hello <%= @resource.first_name %>,</p>
    <p>We are contacting you to let you know your password has been changed.</p>
    <div class="signature">
      <p><em>All the best,</em></p>
      <p class="title"><%= Setting.value!(:name) %></p>
    </div>
  </body>
</html>