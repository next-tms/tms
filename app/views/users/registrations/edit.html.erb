<% provide :title, 'Account' %>

<div class="page-header mb-4">
  <h1><%= yield :title %></h1>
</div>

<%= bootstrap_form_for(resource, as: resource_name, url: user_registration_path, data: { turbo: false }, method: :put, layout: :horizontal, label_col: 'col-sm-4', control_col: 'col-sm-8') do |f| %>

  <%= devise_error_messages! %>

  <div class="row">
    <div class="col col-md-8">
      <p class="col-title">Profile</p>
      <%= f.email_field :email, placeholder: 'Your email address', autocomplete: 'email', autofocus: true %>
      <%= f.phone_field :phone,
                        placeholder: 'Your phone',
                        value: f.object.phone.phony_formatted(format: :international),
                        help: 'International (with leading +) or US format',
                        autocomplete: 'tel'
      %>

      <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
        <p>Currently awaiting confirmation for: <%= resource.unconfirmed_email %></p>
      <% end %>
      
      <%= f.check_box :receive_notifications_from_self, label: 'Receive notifications triggered by you?' %>
      <%= f.check_box :receive_email_notifications, label: 'Receive notifications by email?' %>
      <%= f.check_box :receive_read_notifications_by_email, label: 'Receive notifications that you’ve already seen by email?' %>

      <p class="col-title mt-4">Password</p>
      <p>Only complete this section to change your password:</p>
      <%= f.password_field :password, placeholder: 'New password', autocomplete: 'new-password' %>
      <%= f.password_field :password_confirmation, placeholder: 'New password confirmation', autocomplete: 'new-password' %>

      <p class="col-title">Save</p>
      <%= f.password_field :current_password, help: 'Required to save', placeholder: 'Password', autocomplete: 'current-password' %>
      <%= f.submit 'Save', class: 'btn btn-primary' %>
    </div>
  </div>
<% end %>