<% companyable_type = resource.companyable_type.to_s %>
<% provide :title, "Invite #{{ 'BrokerCustomer' => 'Customer', 'Carrier' => 'Carrier' }.fetch(companyable_type, 'Staff')}" %>
<% @contact = resource.contact if resource.contact&.persisted? %>

<%= render 'broker/users/member_header' %>

<% case companyable_type %>
<% when '' %>
  <div class="alert alert-warning">
    <p class="lead">Inviting staff</p>
    <p>You’re inviting staff to participate in the internal operations of <%= Setting.value!(:name) %>.</p>
  </div>
<% when 'BrokerCustomer' %>
  <div class="alert alert-info">
    <p class="lead">Inviting customer</p>
    <p>You’re inviting a customer to log in.</p>
  </div>
<% when 'Carrier' %>
  <div class="alert alert-info">
    <p class="lead">Inviting carrier</p>
    <p>You’re inviting a carrier to log in and manage their API keys.</p>
  </div>
<% end %>

<% if allowed_to?(:create?, resource, with: InvitationPolicy) %>
  <div class="row">
    <div class="col col-md-8">
      <%= bootstrap_form_for(
            resource,
            as: resource_name,
            url: invitation_path(resource_name),
            layout: :horizontal
          ) do |f| %>
        <%= f.hidden_field :companyable_id %>
        <%= f.hidden_field :companyable_type %>
        <%= f.hidden_field :contact_id, value: @contact&.id %>

        <% if @contact.present? %>
          <%= f.hidden_field :first_name, value: @contact.first_name %>
          <%= f.hidden_field :last_name, value: @contact.last_name %>
          <%= f.hidden_field :email, value: @contact.email %>
          <%= f.hidden_field :phone, value: (@contact.mobile_phone.presence || @contact.work_phone) %>
        <% else %>
          <div class="form-group row">
            <%= f.text_field :first_name, autocomplete: 'off', value: @contact&.first_name, autofocus: true %>
          </div>

          <div class="form-group row">
            <%= f.text_field :last_name, value: @contact&.last_name, autocomplete: 'off' %>
          </div>

          <div class="form-group row">
            <%= f.email_field :email, value: @contact&.email, autocomplete: 'off' %>
          </div>

          <div class="form-group row">
            <%= f.phone_field :phone, value: (@contact&.mobile_phone.blank? ? @contact&.work_phone : @contact&.mobile_phone), autocomplete: 'off' %>
          </div>
        <% end %>

        <% if companyable_type.blank? %>
          <div class="form-group row">
            <label class="col-form-label col-sm-2">Permissions</label>
            <div class="col-sm-10">
              <% f.object.build_contact if f.object.contact.blank? %>
              <%= f.fields_for :contact do |contact_form| %>
                <div data-controller="nested-form" data-nested-form-wrapper-selector-value=".user-role-form-wrapper">
                  <template data-nested-form-target="template">
                    <%= contact_form.fields_for :contact_roles, ContactRole.new, child_index: "NEW_RECORD" do |role_form| %>
                      <%= render 'user_role_form', f: role_form %>
                    <% end %>
                  </template>

                  <%= contact_form.fields_for :contact_roles do |role_form| %>
                    <%= render 'user_role_form', f: role_form %>
                  <% end %>

                  <div data-nested-form-target="target"></div>

                  <%= link_to icon('solid', 'plus', 'Add'), '#', data: { action: 'nested-form#add' }, class: 'btn btn-light' %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>

        <%= f.submit 'Invite', class: 'btn btn-primary ms-2' %>
      <% end %>
    </div>
  </div>
<% else %>
  <div class="alert alert-danger">
    <p class="lead">Access denied</p>
    <p>You don’t have permission to invite staff.</p>
  </div>
<% end %>