<% provide :title, 'Log in' %>

<div class="page-header mb-4">
  <h1><%= yield :title %></h1>
</div>

<div class="row">
  <div class="col col-md-6">
    <%= bootstrap_form_for(resource, as: resource_name, url: session_path(resource_name), data: { turbo: false }, layout: :horizontal) do |f| %>
    
      <%= f.email_field :email, placeholder: 'Your email address', class: 'form-control', autofocus: true %>
      <%= f.password_field :password, placeholder: 'Password', class: 'form-control' %>
    
      <%= f.submit 'Log in', class: 'btn btn-primary' %>
      <%- if devise_mapping.recoverable? %>
        <%= link_to 'Forgot password?', new_password_path(resource_name), class: 'mr-2' %>
      <% end %>
      <% # link_to 'No account?', '#', class: 'btn btn-link' %>
    
    <% end %>
  </div>
</div>
