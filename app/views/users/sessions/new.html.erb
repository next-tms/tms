<% provide :title, 'Welcome' %>

<div class="page-header mb-4">
  <h1>Account</h1>
  <p class="lead"><%= yield :title %></p>
</div>

<%= bootstrap_form_for(resource, as: resource_name, url: session_path(resource_name), data: { turbo: false }, layout: :horizontal, label_col: 'col-sm-4', control_col: 'col-sm-4') do |f| %>

  <%= f.email_field :email, placeholder: 'Your email address', class: 'form-control', hide_label: true, autofocus: true %>
  <%= f.password_field :password, placeholder: 'Password', class: 'form-control', hide_label: true %>

  <%= f.submit 'Log in', class: 'btn btn-primary' %>
  <%- if devise_mapping.recoverable? %>
    <%= link_to 'Forgot password?', new_password_path(resource_name), class: 'ml-2' %>
  <% end %>
  <% # link_to 'No account?', '#', class: 'btn btn-link' %>

<% end %>