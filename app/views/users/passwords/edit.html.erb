<% provide :title, 'Reset Password' %>

<div class="page-header mb-4">
  <h1>Account</h1>
  <p class="lead"><%= yield :title %></p>
</div>

<%= bootstrap_form_for(
      resource,
      as: resource_name,
      url: password_path(resource_name),
      method: :put,
      layout: :horizontal,
      label_col: 'col-sm-1',
      control_col: 'col-sm-4'
    ) do |f| %>
  <%= f.alert_message 'Unable to update password:' %>

  <% reset_password_token = params[:reset_password_token].presence || params.dig(:user, :reset_password_token) %>
  <%= f.hidden_field :reset_password_token, value: reset_password_token %>

  <%= f.password_field :password, placeholder: true, hide_label: true, class: 'form-control', required: true, autofocus: true %>
  <%= f.password_field :password_confirmation, placeholder: true, hide_label: true, class: 'form-control', required: true %>
  <%= f.submit 'Update password', class: 'btn btn-primary' %>
<% end %>
