<% provide :title, 'Forgot Password' %>

<div class="page-header mb-4">
  <h1>Account</h1>
  <p class="lead"><%= yield :title %></p>
</div>

<%= bootstrap_form_for(resource, as: resource_name, url: password_path(resource_name), layout: :horizontal, label_col: 'col-sm-1', control_col: 'col-sm-4') do |f| %>
  <%= f.email_field :email, placeholder: 'Your email address', hide_label: true, class: 'form-control', required: true, autofocus: true %>
  <%= f.submit 'Send email', class: 'btn btn-primary' %>
  <%= link_to 'Remembered password?', new_session_path(resource_name), class: 'ml-2' %>
<% end %>