<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>GraphiQL</title>
    <%= csrf_meta_tags %>
    <link href="https://cdn.jsdelivr.net/npm/graphiql@3.8.3/graphiql.min.css" rel="stylesheet" />
    <style>body { height: 100vh; margin: 0; overflow: hidden; } #graphiql { height: 100vh; }</style>
    <script crossorigin src="https://cdn.jsdelivr.net/npm/react@18.3.1/umd/react.production.min.js"></script>
    <script crossorigin src="https://cdn.jsdelivr.net/npm/react-dom@18.3.1/umd/react-dom.production.min.js"></script>
    <script crossorigin src="https://cdn.jsdelivr.net/npm/graphiql@3.8.3/graphiql.min.js"></script>
  </head>
  <body>
    <div id="graphiql">Loading...</div>
    <script>
      const headers = { 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content }
      const fetcher = GraphiQL.createFetcher({ headers, url: '<%= graphql_path %>' })

      ReactDOM.createRoot(document.getElementById('graphiql')).render(React.createElement(GraphiQL, { fetcher }))
    </script>
  </body>
</html>
